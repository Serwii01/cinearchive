{
  "id": "/",
  "name": "Cine Archive — Archivo editorial de cine",
  "short_name": "Cine Archive",
  "description": "Archivo de cine abierto y multilingüe: hemeroteca de revistas en dominio público, fichas de películas y cine libre. Sin muros ni publicidad.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#FAFAFA",
  "theme_color": "#FAFAFA",
  "categories": [
    "education",
    "entertainment",
    "books"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Descubrir",
      "url": "/discover"
    },
    {
      "name": "Filmoteca",
      "url": "/films"
    },
    {
      "name": "Hemeroteca",
      "url": "/archive"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "prefer_related_applications": false,
  "screenshots": [
    {
      "src": "/screenshots/movil.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Portada de Cine Archive en el móvil"
    },
    {
      "src": "/screenshots/escritorio.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Portada de Cine Archive en el escritorio"
    }
  ]
}
