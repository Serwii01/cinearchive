# TLS automático (Let's Encrypt) para el dominio. {$DOMAIN} y {$EMAIL} llegan por
# variables de entorno desde docker-compose.
{
	email {$EMAIL}
	# Habilita el módulo de rate limiting (imagen construida con Dockerfile.caddy).
	order rate_limit before basic_auth
}

# Redirige www al dominio sin www (requiere que www apunte por A al VPS).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Analítica propia (Umami). Va en un subdominio y no en una ruta del sitio porque
# Next.js fija su prefijo al compilar: servirla bajo /analitica obligaría a
# construir la imagen en el VPS, y aquí no hay memoria para eso.
# Requiere un registro A de analitica.{$DOMAIN} apuntando a esta máquina; sin él
# Caddy no consigue certificado y el resto del sitio sigue igual.
analitica.{$DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Que no acabe indexado: es un panel, no contenido.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Las cabeceras de CORS para /script.js y /api/send las pone Umami, que para
	# eso está pensado para medir sitios de otro dominio. Si las repitiéramos
	# aquí, el navegador vería dos y descartaría la petición.
	reverse_proxy umami:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}

{$DOMAIN} {
	encode gzip zstd

	# --- Protección frente a inundación de peticiones (DoS) ---
	# Límite por IP en el borde, antes de llegar a la app. Dos zonas: una general
	# para toda la web y otra más estricta para la API y el login.
	rate_limit {
		zone general {
			key {remote_host}
			events 240
			window 1m
		}
		zone api {
			match {
				path /api/*
			}
			key {remote_host}
			events 90
			window 1m
		}
	}

	# Rechaza cuerpos de petición desproporcionados (otro vector de abuso).
	request_body {
		max_size 1MB
	}

	# Cabeceras de seguridad (sustituyen a public/_headers de Cloudflare).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# geolocation=(self): lo necesita "Encuentra tu cine". Con la lista vacía
		# el navegador bloquea la API sin preguntar y el botón siempre fallaba.
		# (self) la limita a nuestro origen; el usuario sigue decidiendo en el
		# diálogo del navegador.
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		# CSP estricta: scripts y estilos propios; imágenes desde TMDB e Internet
		# Archive; el visor de la hemeroteca se incrusta desde archive.org (frame-src).
		# (No se necesita 'unsafe-inline' en scripts: no hay scripts inline.)
		# analitica.{$DOMAIN} es la analítica propia: de ahí sale el guion de
		# medición (script-src) y ahí manda los eventos (connect-src). Es el único
		# tercero con permiso para ejecutar código, y es nuestro.
		Content-Security-Policy "default-src 'self'; img-src 'self' https://image.tmdb.org https://archive.org https://*.archive.org https://*.tile.openstreetmap.org data:; script-src 'self' https://analitica.{$DOMAIN}; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://analitica.{$DOMAIN}; frame-src https://archive.org https://*.archive.org https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# El ">" aplica la cabecera DESPUÉS de recibir la respuesta de la app y
	# sustituye la suya. Sin él, Caddy la añadía antes y Node ponía además su
	# "public, max-age=0": salían dos Cache-Control contradictorios.

	# Cache larga para los assets con hash de Astro.
	@assets path /_astro/*
	header @assets >Cache-Control "public, max-age=31536000, immutable"

	# Imágenes de public/ (portadas de revistas, carteles, libros, retratos):
	# no llevan hash en el nombre, pero no cambian nunca. Con max-age=0 cada
	# visita las volvía a pedir a Node solo para recibir un 304. Un mes basta;
	# si alguna se sustituye, conviene ponerle otro nombre.
	@images path /covers/* /cinema/* /library/* /faces/* /articles/* /screenshots/* /icons/* /og.png /favicon.svg
	header @images >Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"

	# El service worker, al contrario: nunca cacheado. Si un navegador se queda
	# con una versión vieja, se queda con ella (y con su caché) indefinidamente.
	@sw path /sw.js
	header @sw >Cache-Control "no-cache"

	reverse_proxy app:4321 {
		# Mientras se recrea el contenedor en un despliegue (migraciones + arranque),
		# Caddy retiene las peticiones y reintenta en vez de devolver un 502.
		lb_try_duration 30s
		lb_try_interval 500ms
		# Sobrescribe (no anexa) las cabeceras de IP: si el cliente envía un
		# X-Forwarded-For falso, aquí se descarta. Así el rate limiting de la app
		# y el anti fuerza-bruta del login cuentan siempre por la IP real.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}
