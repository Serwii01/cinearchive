---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, localizePath, langStaticPaths, normalizeLang, type Lang } from '../../i18n/ui';

export const getStaticPaths = langStaticPaths;

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);

const palette: [string, string, string, string][] = [
  ['Ink', '#000000', '--c-ink', '#fff'],
  ['Charcoal', '#1a1a1a', '--c-charcoal', '#fff'],
  ['Ochre', '#eab308', '--c-ochre', '#1a1a1a'],
  ['Ochre dim', '#6b4e07', '--c-ochre-dim', '#fff'],
  ['Background', '#fafafa', '--c-background', '#1a1a1a'],
  ['Surface', '#f9f9f9', '--c-surface', '#1a1a1a'],
  ['Film white', '#f4f4f4', '--c-film-white', '#1a1a1a'],
  ['Surface dim', '#dadada', '--c-surface-dim', '#1a1a1a'],
  ['Outline', '#817660', '--c-outline', '#fff'],
  ['Outline variant', '#d3c5ac', '--c-outline-variant', '#1a1a1a'],
  ['Muted', '#4f4633', '--c-muted', '#fff'],
  ['Error', '#ba1a1a', '--c-error', '#fff'],
  ['Dark bg', '#0d0d0d', '--c-background (dark)', '#fff'],
  ['Dark ochre', '#f2be1d', '--c-ochre (dark)', '#1a1a1a'],
];

const voiceByLang: Record<Lang, [string, string][]> = {
  es: [
    ['Esquinas rectas.', 'Sin redondeos en ningún elemento de la interfaz.'],
    ['Alto contraste y retícula.', 'Líneas de 1–2 px que conectan de borde a borde.'],
    ['El ocre es el único acento.', 'Con moderación y siempre con texto oscuro encima.'],
    ['La tipografía es la estructura.', 'Serif para titulares, sans para leer, mono para datos.'],
    ['Sombras duras.', 'Desplazadas y sin difuminado, en tinta; en ocre cuando algo está activo.'],
    ['Movimiento con intención.', 'Corto y solo como respuesta a lo que hace quien mira. Nunca anima el texto que se lee.'],
    ['Lo redondo, solo en dibujos.', 'Un disco o un punto se recortan con clip-path; la interfaz nunca se redondea.'],
    ['Tono.', 'Sobrio, editorial, al servicio de lo público y de dominio público.'],
  ],
  en: [
    ['Straight corners.', 'No rounding on any interface element.'],
    ['High contrast and grid.', '1–2 px lines that connect edge to edge.'],
    ['Ochre is the only accent.', 'Used sparingly, always with dark text on top.'],
    ['Type is the structure.', 'Serif for headlines, sans to read, mono for data.'],
    ['Hard shadows.', 'Offset and never blurred, in ink; in ochre when something is active.'],
    ['Motion with intent.', 'Short and only in response to what the viewer does. Text being read is never animated.'],
    ['Round only in drawings.', 'A disc or a dot is cut out with clip-path; the interface is never rounded.'],
    ['Tone.', 'Sober, editorial, in service of the public and the public domain.'],
  ],
  gl: [
    ['Esquinas rectas.', 'Sen redondeos en ningún elemento da interface.'],
    ['Alto contraste e retícula.', 'Liñas de 1–2 px que conectan de bordo a bordo.'],
    ['O ocre é o único acento.', 'Con moderación e sempre con texto escuro enriba.'],
    ['A tipografía é a estrutura.', 'Serif para titulares, sans para ler, mono para datos.'],
    ['Sombras duras.', 'Desprazadas e sen difuminado, en tinta; en ocre cando algo está activo.'],
    ['Movemento con intención.', 'Curto e só como resposta ao que fai quen mira. Nunca anima o texto que se le.'],
    ['O redondo, só en debuxos.', 'Un disco ou un punto recórtanse con clip-path; a interface nunca se arredonda.'],
    ['Ton.', 'Sobrio, editorial, ao servizo do público e de dominio público.'],
  ],
  eu: [
    ['Izkina zuzenak.', 'Biribiltzerik gabe interfazeko elementu bakar batean ere.'],
    ['Kontraste handia eta sareta.', '1–2 px-ko lerroak, ertzetik ertzera lotzen dutenak.'],
    ['Okrea da azentu bakarra.', 'Neurriz eta beti testu ilunarekin gainean.'],
    ['Tipografia da egitura.', 'Serif izenburuetarako, sans irakurtzeko, mono datuetarako.'],
    ['Itzal gogorrak.', 'Desplazatuak eta lausotu gabe, tintaz; okrez zerbait aktibo dagoenean.'],
    ['Asmo garbiko mugimendua.', 'Laburra, eta begiratzen duenak egiten duenari erantzuteko bakarrik. Irakurtzen den testua ez da inoiz animatzen.'],
    ['Biribila, marrazkietan bakarrik.', 'Disko bat edo puntu bat clip-path-ekin mozten dira; interfazea ez da inoiz biribiltzen.'],
    ['Tonua.', 'Soila, editoriala, publikoaren eta domeinu publikoaren zerbitzura.'],
  ],
  ca: [
    ['Cantonades rectes.', 'Sense arrodoniments en cap element de la interfície.'],
    ['Alt contrast i retícula.', 'Línies d’1–2 px que connecten de vora a vora.'],
    ["L'ocre és l'únic accent.", 'Amb moderació i sempre amb text fosc a sobre.'],
    ['La tipografia és l’estructura.', 'Serif per a titulars, sans per llegir, mono per a dades.'],
    ['Ombres dures.', 'Desplaçades i sense difuminar, en tinta; en ocre quan alguna cosa està activa.'],
    ['Moviment amb intenció.', 'Curt i només com a resposta al que fa qui mira. Mai no s’anima el text que es llegeix.'],
    ['El rodó, només en dibuixos.', 'Un disc o un punt es retallen amb clip-path; la interfície mai no s’arrodoneix.'],
    ['To.', 'Sobri, editorial, al servei d’allò públic i de domini públic.'],
  ],
};
const voice = voiceByLang[lang];

/*
 * Movimiento: cada pieza con su demostración, dónde se usa y los valores. Son
 * los de las páginas reales (atlas.astro, global.css): si se
 * cambian allí, hay que cambiarlos aquí.
 */
type MotionId = 'lift' | 'fan' | 'light' | 'reveal' | 'underline' | 'cascade';
const MOTION_SPEC: Record<MotionId, string> = {
  lift: 'translate(-4px, -4px) · box-shadow 6px 6px 0 ink · 0.22s',
  fan: 'rotate ±4–12° · translateY −30px · +0.04s / cartel · 0.5s',
  light: 'fill → ochre · scale(1.08) · drop-shadow(2px 3px 0 ink) · 0.28s',
  reveal: 'opacity 0→1 · translateY 8px→0 · cubic-bezier(0.2, 0.9, 0.3, 1.2)',
  underline: '::after · scaleX(0→1) · 0.25s',
  cascade: 'animation-delay: i × 35ms + 150ms · 1.1s',
};
const motionByLang: Record<Lang, Record<MotionId, [string, string]>> = {
  es: {
    lift: ['Elevación', 'La ficha se levanta y deja una sombra dura de tinta. Fichas del atlas.'],
    fan: ['Abanico', 'Los carteles apilados se abren y suben, cada uno un poco después. Fichas del atlas, tarjeta del mapa.'],
    light: ['Iluminar', 'El país bajo el cursor se copia encima de los demás, crece y se tiñe de ocre; el resto baja de tono.'],
    reveal: ['Aparecer', 'Las tarjetas flotantes entran subiendo con un rebote corto. Tarjeta del mapa del atlas.'],
    underline: ['Subrayado', 'Una línea ocre crece desde el centro en las pestañas. Épocas del atlas.'],
    cascade: ['Cascada', 'Al cargar, los elementos se encienden uno tras otro. Países del atlas.'],
  },
  en: {
    lift: ['Lift', 'The card rises and leaves a hard ink shadow. Atlas cards.'],
    fan: ['Fan', 'Stacked posters spread out and rise, each a little later. Atlas cards, map card.'],
    light: ['Highlight', 'The country under the cursor is copied above the others, grows and turns ochre; the rest dim.'],
    reveal: ['Appear', 'Floating cards come in rising with a short bounce. Atlas map card.'],
    underline: ['Underline', 'An ochre line grows from the centre on tabs. Atlas eras.'],
    cascade: ['Cascade', 'On load, items light up one after another. Atlas countries.'],
  },
  gl: {
    lift: ['Elevación', 'A ficha levántase e deixa unha sombra dura de tinta. Fichas do atlas.'],
    fan: ['Abano', 'Os carteis amoreados ábrense e soben, cada un un pouco despois. Fichas do atlas, tarxeta do mapa.'],
    light: ['Iluminar', 'O país baixo o cursor cópiase por riba dos demais, medra e tínguese de ocre; o resto baixa de ton.'],
    reveal: ['Aparecer', 'As tarxetas flotantes entran subindo cun rebote curto. Tarxeta do mapa do atlas.'],
    underline: ['Subliñado', 'Unha liña ocre medra desde o centro nas lapelas. Épocas do atlas.'],
    cascade: ['Fervenza', 'Ao cargar, os elementos acéndense un tras outro. Países do atlas.'],
  },
  eu: {
    lift: ['Altxatzea', 'Fitxa altxatu egiten da eta tintazko itzal gogorra uzten du. Atlaseko fitxak.'],
    fan: ['Haizemailea', 'Pilatutako kartelak zabaldu eta igo egiten dira, bakoitza pixka bat beranduago. Atlaseko fitxak, maparen txartela.'],
    light: ['Argiztatu', 'Kurtsorearen azpiko herrialdea besteen gainean kopiatzen da, hazi eta okre bihurtzen da; gainerakoak itzaltzen dira.'],
    reveal: ['Agertu', 'Txartel mugikorrak igoz sartzen dira, errebote labur batekin. Atlaseko maparen txartela.'],
    underline: ['Azpimarra', 'Okre-lerro bat erditik hazten da fitxetan. Atlaseko garaiak.'],
    cascade: ['Ur-jauzia', 'Kargatzean, elementuak bata bestearen atzetik pizten dira. Atlaseko herrialdeak.'],
  },
  ca: {
    lift: ['Elevació', 'La fitxa s’aixeca i deixa una ombra dura de tinta. Fitxes de l’atles.'],
    fan: ['Ventall', 'Els cartells apilats s’obren i pugen, cadascun una mica després. Fitxes de l’atles, targeta del mapa.'],
    light: ['Il·luminar', 'El país sota el cursor es copia per sobre dels altres, creix i es tenyeix d’ocre; la resta baixa de to.'],
    reveal: ['Aparèixer', 'Les targetes flotants entren pujant amb un rebot curt. Targeta del mapa de l’atles.'],
    underline: ['Subratllat', 'Una línia ocre creix des del centre a les pestanyes. Èpoques de l’atles.'],
    cascade: ['Cascada', 'En carregar, els elements s’encenen l’un darrere l’altre. Països de l’atles.'],
  },
};
const motion = (Object.keys(MOTION_SPEC) as MotionId[]).map((id) => ({ id, name: motionByLang[lang][id][0], desc: motionByLang[lang][id][1], spec: MOTION_SPEC[id] }));
// Imágenes locales para las demostraciones (no tocan TMDB ni Internet Archive).
const demoPosters = ['/cinema/1926-faust.jpg', '/cinema/the-passion-of-joan-of-arc.jpg', '/cinema/pandoras-box-1929-by-georg-wilhelm-pabst.jpg', '/cinema/BattleshipPotemkin.jpg'];
---

<BaseLayout title={t('style.title')} description={t('style.intro')} noindex>
  <section class="frame py-12">
    <header class="border-b border-ink pb-6">
      <span class="label">{t('style.title')}</span>
      <h1 class="mt-3 text-display-mobile md:text-display-lg">{t('style.title')}</h1>
      <p class="mt-4 max-w-2xl text-body-lg text-charcoal">{t('style.intro')}</p>
    </header>

    {/* LOGOTIPO */}
    <h2 class="mt-12 border-b border-ink pb-2 text-headline-lg text-ink">{t('style.logo')}</h2>
    <div class="mt-6 grid ruled grid-cols-1 border border-ink sm:grid-cols-2">
      <div class="flex items-center gap-5 bg-background p-8">
        <svg viewBox="0 0 32 32" class="h-20 w-20 shrink-0" shape-rendering="crispEdges" role="img" aria-label="Cine Archive">
          <rect width="32" height="32" fill="var(--c-background)"></rect>
          <rect x="1" y="1" width="30" height="30" fill="none" stroke="var(--c-ink)" stroke-width="2"></rect>
          <rect x="6" y="6" width="20" height="9" fill="var(--c-ochre)" stroke="var(--c-ink)" stroke-width="2"></rect>
          <line x1="6" y1="20" x2="26" y2="20" stroke="var(--c-ink)" stroke-width="2"></line>
          <line x1="6" y1="25" x2="20" y2="25" stroke="var(--c-ink)" stroke-width="2"></line>
        </svg>
        <div>
          <p class="font-display text-display-mobile leading-none text-ink">Cine Archive</p>
          <p class="label mt-2">{t('site.tagline')}</p>
        </div>
      </div>
      <div class="flex items-center gap-5 bg-charcoal p-8" style="background:#0d0d0d">
        <svg viewBox="0 0 32 32" class="h-20 w-20 shrink-0" shape-rendering="crispEdges" aria-hidden="true">
          <rect width="32" height="32" fill="#0d0d0d"></rect>
          <rect x="1" y="1" width="30" height="30" fill="none" stroke="#fafafa" stroke-width="2"></rect>
          <rect x="6" y="6" width="20" height="9" fill="#eab308" stroke="#fafafa" stroke-width="2"></rect>
          <line x1="6" y1="20" x2="26" y2="20" stroke="#fafafa" stroke-width="2"></line>
          <line x1="6" y1="25" x2="20" y2="25" stroke="#fafafa" stroke-width="2"></line>
        </svg>
        <p class="font-display text-display-mobile leading-none" style="color:#fafafa">Cine Archive</p>
      </div>
    </div>

    {/* PALETA */}
    <h2 class="mt-12 border-b border-ink pb-2 text-headline-lg text-ink">{t('style.palette')}</h2>
    <div class="mt-6 grid ruled grid-cols-2 border border-ink sm:grid-cols-3 lg:grid-cols-4">
      {palette.map(([name, hex, varn, on]) => (
        <div class="bg-surface">
          <div class="flex h-20 items-end p-2 font-mono text-meta-data" style={`background:${hex};color:${on}`}>{hex}</div>
          <div class="border-t border-ink p-3">
            <p class="font-display text-body-lg leading-none text-ink">{name}</p>
            <p class="font-mono text-meta-data text-muted">{varn}</p>
          </div>
        </div>
      ))}
    </div>

    {/* TIPOGRAFÍA */}
    <h2 class="mt-12 border-b border-ink pb-2 text-headline-lg text-ink">{t('style.typography')}</h2>
    <div class="mt-6 grid ruled grid-cols-1 border border-ink md:grid-cols-3">
      <div class="bg-surface p-5">
        <span class="label">Display · EB Garamond</span>
        <p class="mt-2 font-display text-display-lg leading-none text-ink">Aa</p>
        <p class="mt-3 font-display text-headline-md text-ink">El cine es memoria</p>
      </div>
      <div class="bg-surface p-5">
        <span class="label">Texto · Geist Sans</span>
        <p class="mt-2 font-body text-display-lg font-semibold leading-none text-ink">Aa</p>
        <p class="mt-3 font-body text-body-md text-charcoal">Texto de interfaz y cuerpo, claro y neutro a cualquier tamaño.</p>
      </div>
      <div class="bg-surface p-5">
        <span class="label">Mono · Space Mono</span>
        <p class="mt-2 font-mono text-headline-lg leading-none text-ink">Aa</p>
        <p class="label mt-4">Etiquetas · Metadatos · 2026</p>
      </div>
    </div>

    {/* COMPONENTES */}
    <h2 class="mt-12 border-b border-ink pb-2 text-headline-lg text-ink">{t('style.components')}</h2>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <span class="btn btn-primary">{t('style.components')}</span>
      <span class="btn btn-secondary">{t('style.components')}</span>
      <span class="label border border-ink px-3 py-2">Etiqueta</span>
      <span class="label border border-ink bg-ink px-3 py-2 text-background">Etiqueta inversa</span>
    </div>
    <div class="mt-6 max-w-xs border border-ink">
      <div class="label border-b border-ink bg-ink px-3 py-2 text-background">Ficha</div>
      <div class="p-4">
        <p class="font-display text-headline-md text-ink">Título de la obra</p>
        <p class="mt-1 font-mono text-meta-data uppercase tracking-[0.08em] text-muted">Dirección · 1962 · 90′</p>
      </div>
    </div>

    {/* RETÍCULA */}
    <h2 class="mt-12 border-b border-ink pb-2 text-headline-lg text-ink">{t('style.grids')}</h2>
    <p class="mt-3 max-w-2xl text-body-md text-charcoal">{t('style.gridsIntro')}</p>
    <div class="mt-6 grid ruled grid-cols-2 border border-ink sm:grid-cols-3">
      {['1', '2', '3', '4', '5'].map((n) => (
        <div class="flex h-20 items-end bg-surface p-3 font-mono text-meta-data text-muted">.ruled › {n}</div>
      ))}
    </div>
    <p class="mt-2 font-mono text-meta-data text-muted">.ruled · .ruled-inner (dentro de una caja con borde)</p>

    {/* FORMULARIOS Y AVISOS */}
    <h2 class="mt-12 border-b border-ink pb-2 text-headline-lg text-ink">{t('style.forms')}</h2>
    <p class="mt-3 max-w-2xl text-body-md text-charcoal">{t('style.formsIntro')}</p>
    <div class="mt-6 grid ruled grid-cols-1 border border-ink md:grid-cols-2">
      <div class="flex flex-col gap-5 bg-surface p-5">
        <label class="block">
          <span class="label mb-2 flex flex-wrap items-center gap-x-1">{t('profile.username')} <span class="bg-ochre px-1 text-on-accent">{t('profile.required')}</span></span>
          <div class="flex items-center border border-ink bg-white outline outline-2 outline-ochre">
            <span class="px-3 font-mono text-body-md text-muted">@</span>
            <input type="text" value="cinefila" class="w-full bg-transparent py-2 pr-3 font-mono text-body-md text-ink focus:outline-none" />
          </div>
          <span class="mt-1 block font-mono text-meta-data text-muted">{t('profile.usernameHint')}</span>
        </label>
        <label class="block">
          <span class="label mb-2 block">{t('profile.bio')} <span class="text-muted normal-case">({t('profile.optional')})</span></span>
          <textarea rows="2" class="w-full border border-ink bg-white px-3 py-2 font-body text-body-md text-ink focus:bg-film-white focus:outline-none"></textarea>
        </label>
        <label class="block">
          <span class="label mb-2 block">{t('profile.username')}</span>
          <div class="flex items-center border border-error bg-white">
            <span class="px-3 font-mono text-body-md text-muted">@</span>
            <input type="text" value="ab" aria-invalid="true" class="w-full bg-transparent py-2 pr-3 font-mono text-body-md text-ink focus:outline-none" />
          </div>
          <span class="mt-1 block font-mono text-meta-data text-error">{t('profile.errFormat')}</span>
        </label>
      </div>
      <div class="flex flex-col gap-5 bg-surface p-5">
        <div class="border-l-4 border-ochre bg-film-white px-4 py-3">
          <p class="text-body-md text-ink">{t('profile.createIntro')}</p>
          <p class="mt-2 font-mono text-meta-data text-charcoal">{t('profile.createHow')}</p>
        </div>
        <div role="note" class="border-2 border-error bg-surface p-3">
          <p class="label flex items-center gap-2 text-error"><span aria-hidden="true">▲</span> {t('profile.saveErrorTitle')}</p>
          <p class="mt-1 font-mono text-meta-data text-charcoal">{t('profile.errGeneric')}</p>
        </div>
        <p class="font-mono text-meta-data text-muted">border-l-4 ochre · border-2 error + ▲ · campo: border error + aria-invalid</p>
      </div>
    </div>

    {/* MOVIMIENTO */}
    <h2 class="mt-12 border-b border-ink pb-2 text-headline-lg text-ink">{t('style.motion')}</h2>
    <p class="mt-3 max-w-2xl text-body-md text-charcoal">{t('style.motionIntro')}</p>
    <div class="mt-6 grid ruled grid-cols-1 border border-ink sm:grid-cols-2 lg:grid-cols-3">
      {motion.map((m) => (
        <div class="demo flex flex-col bg-surface" data-demo={m.id}>
          <div class="stage relative flex h-44 items-center justify-center overflow-hidden border-b border-ink bg-film-white">
            {m.id === 'lift' && (
              <div class="d-lift border border-ink bg-surface px-5 py-4">
                <p class="font-display text-headline-md text-ink">Metropolis</p>
                <p class="font-mono text-meta-data text-muted">1927</p>
              </div>
            )}
            {m.id === 'fan' && (
              <div class="d-fan">
                {demoPosters.map((src, i) => <img src={src} alt="" class={`p${i}`} loading="lazy" decoding="async" />)}
              </div>
            )}
            {m.id === 'light' && (
              <svg viewBox="0 0 120 70" class="h-28 w-auto" aria-hidden="true">
                <rect class="d-cell" x="6" y="8" width="34" height="24" />
                <rect class="d-cell on" x="44" y="8" width="34" height="24" />
                <rect class="d-cell" x="82" y="8" width="34" height="24" />
                <rect class="d-cell on" x="25" y="38" width="34" height="24" />
                <rect class="d-cell" x="63" y="38" width="34" height="24" />
              </svg>
            )}
            {m.id === 'reveal' && (
              <div class="d-reveal border border-ink bg-surface px-4 py-3 shadow-[5px_5px_0_var(--c-ink)]">
                <p class="label">Francia</p>
                <p class="font-display text-[1.2rem] text-ink">Nouvelle Vague</p>
              </div>
            )}
            {m.id === 'underline' && (
              <div class="flex gap-1">
                {['1950', '1960', '1970'].map((d) => <span class="d-tab font-mono text-[0.75rem] uppercase tracking-[0.06em]">{d}</span>)}
              </div>
            )}
            {m.id === 'cascade' && (
              <div class="flex gap-2">
                {[0, 1, 2, 3, 4, 5].map((i) => <span class="d-dot" style={`--i:${i}`}></span>)}
              </div>
            )}
            <span class="label absolute bottom-2 right-3">{t('style.hover')}</span>
          </div>
          <div class="flex-1 p-4">
            <p class="font-display text-headline-md leading-tight text-ink">{m.name}</p>
            <p class="mt-1 text-body-md text-charcoal">{m.desc}</p>
            <p class="mt-3 font-mono text-meta-data text-muted">{m.spec}</p>
          </div>
        </div>
      ))}
    </div>

    {/* LENGUAJE VISUAL */}
    <h2 class="mt-12 border-b border-ink pb-2 text-headline-lg text-ink">{t('style.voice')}</h2>
    <dl class="mt-4 max-w-3xl">
      {voice.map(([term, desc], i) => (
        <div class:list={['py-3', i < voice.length - 1 && 'border-b border-outline-variant']}>
          <dt class="font-display text-headline-md text-ink">{term}</dt>
          <dd class="mt-1 text-body-md text-charcoal">{desc}</dd>
        </div>
      ))}
    </dl>
  </section>
</BaseLayout>

<style>
  /*
   * Demostraciones de «Movimiento». Mismos valores que en las páginas reales
   * (atlas.astro): si cambian allí, se cambian aquí.
   */

  /* Elevación */
  .d-lift {
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .demo:hover .d-lift {
