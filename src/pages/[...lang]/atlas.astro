---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getMovements, decadesOf, movementsByCountry } from '../../lib/movements';
import { posterUrl } from '../../lib/tmdb';
import { posterSet } from '../../lib/posters';
import world from '../../data/worldcountries.json';
import { useTranslations, localizePath, langStaticPaths, normalizeLang } from '../../i18n/ui';

export const getStaticPaths = langStaticPaths;

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);

const movements = getMovements(lang);
const decades = decadesOf(movements);
const firstYear = Math.min(...movements.map((m) => m.from));
const byCountry = movementsByCountry(movements);

// Nombres de país del propio Node (ICU), en los cinco idiomas. El de Hong Kong
// llega como «RAE de Hong Kong (China)»: demasiado largo para una tarjeta.
const regionNames = new Intl.DisplayNames([lang], { type: 'region' });
const countryName = (iso: string) => (iso === 'HK' ? 'Hong Kong' : regionNames.of(iso) ?? iso);
const years = (m: { from: number; to: number | null }) => `${m.from}–${m.to ?? t('atlas.now')}`;
const poster = (path: string | null) => posterUrl(path, 'w342');

// Orden de aparición de los países con movimiento, para la cascada de entrada.
const glowOrder = new Map([...byCountry.keys()].map((iso, i) => [iso, i]));
const loginHref = `${localizePath(lang, 'login')}?next=${encodeURIComponent(localizePath(lang, 'atlas'))}`;
---

<BaseLayout title={t('atlas.title')} description={t('atlas.intro')}>
  <section class="frame py-12">
    <a href={localizePath(lang, 'films')} class="label no-underline hover:text-ink">← {t('nav.films')}</a>
    <header class="mt-6 border-b border-ink pb-6">
      <span class="label">{t('nav.atlas')} · {movements.length} {t('atlas.movements')} · {firstYear}–{t('atlas.now')}</span>
      <h1 class="mt-3 text-display-mobile md:text-display-lg">{t('atlas.title')}</h1>
      <p class="mt-4 max-w-2xl text-body-lg text-charcoal">{t('atlas.intro')}</p>
    </header>

    <div
      id="atlas"
      class="mt-8"
      data-lang={lang}
      data-first={firstYear}
      data-t-count-all={t('atlas.countAll')}
      data-t-count-decade={t('atlas.countDecade')}
      data-t-here0={t('atlas.mineHere0')}
      data-t-here1={t('atlas.mineHere1')}
      data-t-here-n={t('atlas.mineHereN')}
      data-t-summary={t('atlas.mineSummary')}
      data-t-summary-one={t('atlas.mineSummaryOne')}
    >
      {/* Barra: vista (movimientos / tu mapa) y épocas */}
      <div class="flex flex-col gap-4 border-b border-ink pb-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="atlas-views inline-flex self-start border border-ink" role="group" aria-label={t('nav.atlas')}>
          <button type="button" class="atlas-view font-mono text-[0.75rem] uppercase tracking-[0.06em]" data-view="movements" aria-pressed="true">{t('atlas.viewMovements')}</button>
          <button type="button" class="atlas-view font-mono text-[0.75rem] uppercase tracking-[0.06em]" data-view="mine" aria-pressed="false">{t('atlas.viewMine')}</button>
        </div>
        <div class="atlas-eras -mx-1 flex gap-1 overflow-x-auto px-1 pb-1" role="group" aria-label={t('atlas.eras')}>
          <button type="button" class="atlas-era font-mono text-[0.75rem] uppercase tracking-[0.06em]" data-decade="" aria-pressed="true">{t('atlas.allEras')}</button>
          {decades.map((d) => <button type="button" class="atlas-era font-mono text-[0.75rem] uppercase tracking-[0.06em]" data-decade={d} aria-pressed="false">{d}</button>)}
        </div>
      </div>

      <p id="atlas-status" class="mt-4 font-mono text-meta-data text-muted" aria-live="polite">
        {t('atlas.countAll').replace('{n}', String(movements.length)).replace('{from}', String(firstYear))}
      </p>

      {/* Mapa */}
      <div id="atlas-map" class="atlas-map relative mt-3 border border-ink bg-surface">
        <div class="atlas-scroll">
        <svg viewBox={`0 0 ${world.w} ${world.h}`} class="block h-auto w-full" role="group" aria-label={t('atlas.title')}>
          <g>
            {world.countries.map((c) => {
              const mvs = c.iso ? byCountry.get(c.iso) : undefined;
              const name = c.iso ? countryName(c.iso) : '';
              const attrs = {
                class: `atlas-c${mvs ? ' is-mv is-on' : ''}`,
                'data-iso': c.iso || undefined,
                'data-name': name || undefined,
                'data-mv': mvs?.map((m) => m.id).join(' '),
                style: mvs ? `--i:${glowOrder.get(c.iso)}` : undefined,
                tabindex: mvs ? 0 : undefined,
                role: mvs ? 'button' : undefined,
                'aria-label': mvs ? `${name}: ${mvs.map((m) => m.name).join(', ')}` : undefined,
              };
              return c.d ? <path d={c.d} {...attrs} /> : <circle cx={c.c[0]} cy={c.c[1]} r="4" {...attrs} />;
            })}
          </g>
          {/* El país bajo el cursor se copia aquí para pintarlo por encima de sus vecinos. */}
          <g id="atlas-hl" class="atlas-hl" aria-hidden="true"></g>
        </svg>
        </div>

        <div id="atlas-card" class="atlas-card" hidden></div>

        <div class="atlas-legend pointer-events-none absolute bottom-2 left-2 hidden flex-col gap-1 border border-ink bg-surface px-2 py-1.5 font-mono text-[0.68rem] leading-tight text-charcoal sm:flex">
          <span class="legend-mv flex items-center gap-1.5"><i class="sw sw-mv"></i>{t('atlas.legendMovement')}</span>
          <span class="legend-mine flex items-center gap-1.5"><i class="sw sw-m1"></i><i class="sw sw-m2"></i><i class="sw sw-m3"></i><i class="sw sw-m4"></i>{t('atlas.legendFew')} → {t('atlas.legendMany')}</span>
          <span class="legend-mine flex items-center gap-1.5"><i class="sw sw-miss"></i>{t('atlas.legendMissing')}</span>
        </div>
      </div>
      <p class="mt-2 font-mono text-meta-data text-muted">{t('atlas.hint')}</p>

      {/* «Tu mapa»: resumen, o la invitación a iniciar sesión */}
      <div id="atlas-mine" class="atlas-mine mt-6 border border-ink bg-film-white p-4" hidden>
        <p data-mine="loading" class="font-mono text-meta-data text-muted" hidden>{t('atlas.mineLoading')}</p>
        <p data-mine="error" class="text-body-md text-error" hidden>{t('atlas.mineError')}</p>
        <p data-mine="empty" class="text-body-md text-charcoal" hidden>{t('atlas.mineEmpty')}</p>
        <div data-mine="login" class="flex flex-wrap items-center gap-3" hidden>
          <p class="text-body-md text-charcoal">{t('atlas.mineLogin')}</p>
          <a href={loginHref} class="label border border-ink bg-ochre px-3 py-1.5 text-on-accent no-underline">{t('atlas.mineLoginCta')}</a>
        </div>
        <div data-mine="ok" hidden>
          <p id="atlas-mine-summary" class="font-display text-headline-md"></p>
          <p id="atlas-mine-complete" class="mt-2 text-body-md text-charcoal" hidden>{t('atlas.mineComplete')}</p>
          <div id="atlas-mine-missing" hidden>
            <p class="label mt-3">{t('atlas.mineMissing')}</p>
            <ul id="atlas-mine-chips" class="mt-2 flex flex-wrap gap-2"></ul>
          </div>
        </div>
      </div>

      {/* Tarjeta de cada país, que el script copia en la flotante del mapa */}
      {[...byCountry.entries()].map(([iso, mvs]) => (
        <template id={`atlas-tpl-${iso}`}>
          <p class="label">{countryName(iso)}</p>
          <p class="atlas-card-mine mt-1 font-mono text-meta-data text-charcoal" hidden></p>
          <div class="atlas-card-posters" aria-hidden="true">
            {mvs[0].films.slice(0, 3).map((f, i) => {
              const src = poster(f.poster);
              return src ? <img src={src} srcset={posterSet(src)} sizes="96px" alt="" class={`p${i}`} loading="lazy" decoding="async" /> : null;
            })}
          </div>
          <ul class="mt-3 flex flex-col gap-2">
            {mvs.map((m) => (
              <li>
                <a href={`#mv-${m.id}`} class="atlas-card-mv group block no-underline">
                  <span class="block font-display text-[1.2rem] leading-tight text-ink group-hover:underline">{m.name}</span>
                  <span class="font-mono text-meta-data text-muted">{years(m)} · {t('atlas.seeMovement')} ↓</span>
                </a>
              </li>
            ))}
          </ul>
        </template>
      ))}

      {/* Los movimientos, en orden cronológico */}
      <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {movements.map((m) => (
          <li
            id={`mv-${m.id}`}
            class="mv-card flex flex-col border border-ink bg-surface"
            data-mv-card
            data-from={m.from}
            data-to={m.to ?? undefined}
            data-countries={m.countries.join(' ')}
            data-name={m.name}
          >
            <div class="mv-posters" aria-hidden="true">
              {m.films.slice(0, 4).map((f, i) => {
                const src = poster(f.poster);
                return src ? <img src={src} srcset={posterSet(src)} sizes="(min-width: 1024px) 120px, (min-width: 640px) 18vw, 34vw" alt="" class={`p${i}`} loading="lazy" decoding="async" /> : null;
              })}
            </div>
            <div class="flex flex-1 flex-col border-t border-ink p-5">
              <p class="label">{years(m)} · {m.countries.map(countryName).join(' · ')}</p>
              <h2 class="mt-2 font-display text-headline-md leading-tight">{m.name}</h2>
              <p class="mt-3 text-body-md text-charcoal">{m.blurb}</p>
              <p class="mt-4 font-mono text-meta-data text-muted"><span class="text-ink">{t('atlas.directors')}:</span> {m.directors.join(' · ')}</p>
              <ul class="mt-4 flex flex-wrap gap-1.5 pt-1" aria-label={t('atlas.films')}>
                {m.films.map((f) => (
                  <li>
                    <a href={localizePath(lang, f.path)} class="mv-film label inline-block border border-ink px-2 py-1 no-underline">{f.title} <span class="text-muted">{f.year}</span></a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Barra ---------- */
  .atlas-view,
  .atlas-era {
    padding: 0.45rem 0.8rem;
    transition: background-color 0.2s, color 0.2s;
    white-space: nowrap;
  }
  .atlas-view + .atlas-view {
    border-left: 1px solid var(--c-ink);
  }
  .atlas-era {
    border: 1px solid transparent;
    position: relative;
  }
  .atlas-era::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.2rem;
    height: 2px;
    background: var(--c-ochre);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }
  .atlas-era:hover::after {
    transform: scaleX(1);
  }
  .atlas-view[aria-pressed='true'],
  .atlas-era[aria-pressed='true'] {
    background: var(--c-ink);
    color: var(--c-white);
  }
  .atlas-era[aria-pressed='true']::after {
    transform: scaleX(0);
  }

  .atlas-eras {
    scrollbar-width: none;
  }
  .atlas-eras::-webkit-scrollbar {
    display: none;
  }
  /* «Tu mapa» no va por épocas: la barra se queda, apagada, para que no salte. */
  #atlas.is-mine .atlas-eras,
  #atlas.is-mine #atlas-status {
    opacity: 0.3;
    pointer-events: none;
  }
  @media (max-width: 1023px) {
    /* Las décadas no caben: se desliza, y el borde difuminado avisa de que hay más. */
    .atlas-eras {
      mask-image: linear-gradient(to right, #000 85%, transparent);
    }
  }

  /* ---------- Mapa ---------- */
  /* En el móvil, a ancho de pantalla Europa no se puede tocar: el mapa se
     dibuja más grande y se desliza de lado. */
  @media (max-width: 639px) {
    .atlas-scroll {
      overflow-x: auto;
    }
    .atlas-scroll svg {
      min-width: 46rem;
    }
  }
  .atlas-c {
    fill: var(--c-ink);
    fill-opacity: 0.08;
    stroke: var(--c-surface);
    stroke-width: 0.6;
    stroke-linejoin: round;
    transition: fill 0.35s ease, fill-opacity 0.35s ease, stroke 0.35s ease;
  }
  .atlas-c.is-mv {
    cursor: pointer;
    fill-opacity: 0.16;
    outline: none;
  }
  .atlas-c.is-mv.is-on {
    fill: var(--c-ochre);
    fill-opacity: 0.85;
    animation: atlas-glow 1.1s ease-out both;
    animation-delay: calc(var(--i, 0) * 35ms + 150ms);
  }
  /* Al pasar por un país, los demás bajan un punto para que destaque. */
  .atlas-map:has(.atlas-c.is-mv:hover) .atlas-c.is-mv.is-on:not(:hover) {
    fill-opacity: 0.45;
  }
  .atlas-c.is-linked,
  .atlas-c.is-mv:focus-visible {
    fill: var(--c-ochre) !important;
    fill-opacity: 1 !important;
    stroke: var(--c-ink);
    stroke-width: 1;
  }
  @keyframes atlas-glow {
    0% {
      fill: var(--c-ink);
      fill-opacity: 0.08;
    }
    55% {
      fill: var(--c-ochre);
      fill-opacity: 1;
    }
  }
  circle.atlas-c.is-mv {
    stroke: var(--c-ink);
    stroke-width: 0.8;
  }

  /* El país copiado encima: crece un poco y proyecta sombra dura. */
  .atlas-hl :global(.atlas-c) {
    pointer-events: none;
    fill: var(--c-ochre);
    fill-opacity: 1;
    stroke: var(--c-ink);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: atlas-lift 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.3) forwards;
  }
  @keyframes atlas-lift {
    from {
      transform: scale(1);
      filter: drop-shadow(0 0 0 var(--c-ink));
    }
    to {
      transform: scale(1.08) translate(-1%, -2%);
      filter: drop-shadow(2px 3px 0 var(--c-ink));
    }
  }

  /* ---------- Tarjeta flotante ---------- */
  .atlas-card {
    position: absolute;
    z-index: 10;
    width: min(18rem, 80%);
    padding: 0.9rem 1rem 1rem;
    border: 1px solid var(--c-ink);
    background: var(--c-surface);
    box-shadow: 5px 5px 0 var(--c-ink);
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    transition: opacity 0.18s ease, transform 0.22s cubic-bezier(0.2, 0.9, 0.3, 1.2);
    pointer-events: none;
  }
  .atlas-card.is-open {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .atlas-card :global(.atlas-card-posters) {
    position: relative;
    height: 7.5rem;
    margin-top: 0.75rem;
  }
  .atlas-card :global(.atlas-card-posters img) {
    position: absolute;
    top: 0;
    left: 50%;
    width: 4.6rem;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border: 1px solid var(--c-ink);
    background: var(--c-charcoal);
    transform: translateX(-50%);
    transition: transform 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }
  /* Los carteles salen apilados y se abren en abanico al aparecer la tarjeta. */
  .atlas-card.is-open :global(.atlas-card-posters .p0) {
    transform: translateX(-125%) rotate(-9deg);
    transition-delay: 0.05s;
  }
  .atlas-card.is-open :global(.atlas-card-posters .p1) {
    transform: translateX(-50%) translateY(-4px);
    z-index: 1;
    transition-delay: 0.1s;
  }
  .atlas-card.is-open :global(.atlas-card-posters .p2) {
    transform: translateX(25%) rotate(9deg);
    transition-delay: 0.15s;
  }

  /* ---------- Leyenda ---------- */
  .sw {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid var(--c-ink);
  }
  .sw-mv {
    background: var(--c-ochre);
  }
  .legend-mine {
    display: none !important;
  }
  #atlas.is-mine .legend-mine {
    display: flex !important;
  }
  #atlas.is-mine .legend-mv {
    display: none !important;
  }

  /* ---------- Tu mapa ---------- */
  /* Un solo selector de base: con uno más específico, los tonos de abajo no
     llegarían a los países con movimiento. */
  #atlas.is-mine .atlas-c {
    fill: var(--c-ink);
    fill-opacity: 0.08;
    animation: none;
    cursor: default;
  }
  #atlas.is-mine .atlas-c[data-iso] {
    cursor: pointer;
  }
  #atlas.is-mine .atlas-c.is-mv.m0 {
    stroke: var(--c-ochre-dim);
    stroke-width: 1.1;
    stroke-dasharray: 3 2;
  }
  #atlas.is-mine .atlas-c.m1,
  .sw-m1 {
    fill: var(--c-ochre);
    background: color-mix(in srgb, var(--c-ochre) 30%, transparent);
    fill-opacity: 0.3;
  }
  #atlas.is-mine .atlas-c.m2,
  .sw-m2 {
    fill: var(--c-ochre);
    background: color-mix(in srgb, var(--c-ochre) 55%, transparent);
    fill-opacity: 0.55;
  }
  #atlas.is-mine .atlas-c.m3,
  .sw-m3 {
    fill: var(--c-ochre);
    background: color-mix(in srgb, var(--c-ochre) 80%, transparent);
    fill-opacity: 0.8;
  }
  #atlas.is-mine .atlas-c.m4,
  .sw-m4 {
    fill: var(--c-ochre);
    background: var(--c-ochre);
    fill-opacity: 1;
  }
  .sw-miss {
    border: 1.5px dashed var(--c-ochre-dim);
  }
  #atlas.is-mine .atlas-c[data-iso]:hover {
    stroke: var(--c-ink);
    stroke-width: 1;
  }

  /* ---------- Fichas de movimiento ---------- */
  .mv-card {
    transition: transform 0.22s ease, box-shadow 0.22s ease, opacity 0.35s ease, filter 0.35s ease;
  }
  .mv-card:hover,
  .mv-card:focus-within {
    transform: translate(-4px, -4px);
    box-shadow: 6px 6px 0 var(--c-ink);
  }
  .mv-card.is-off {
    opacity: 0.32;
    filter: grayscale(1);
  }
  .mv-card.is-off:hover,
  .mv-card.is-off:focus-within {
    opacity: 1;
    filter: none;
  }
  .mv-card:target {
    animation: mv-flash 1.4s ease-out;
  }
  @keyframes mv-flash {
    0%,
    35% {
      box-shadow: 0 0 0 4px var(--c-ochre);
    }
  }
  .mv-posters {
    position: relative;
    height: 13rem;
    overflow: hidden;
    background: var(--c-film-white);
  }
  .mv-posters img {
    position: absolute;
    bottom: -1.2rem;
    width: 34%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border: 1px solid var(--c-ink);
    background: var(--c-charcoal);
    transform-origin: 50% 100%;
    transition: transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.15);
  }
  .mv-posters .p0 {
    left: 6%;
    transform: rotate(-7deg);
  }
  .mv-posters .p1 {
    left: 24%;
    transform: rotate(-2deg) translateY(-6px);
  }
  .mv-posters .p2 {
    left: 42%;
    transform: rotate(3deg) translateY(-3px);
  }
  .mv-posters .p3 {
    left: 60%;
    transform: rotate(8deg);
  }
  /* Al pasar por la ficha, los carteles se abren y suben, cada uno a su ritmo. */
  .mv-card:hover .mv-posters .p0,
  .mv-card:focus-within .mv-posters .p0 {
    transform: translate(-14%, -16px) rotate(-12deg);
  }
  .mv-card:hover .mv-posters .p1,
  .mv-card:focus-within .mv-posters .p1 {
    transform: translate(-6%, -30px) rotate(-4deg);
    transition-delay: 0.04s;
  }
  .mv-card:hover .mv-posters .p2,
  .mv-card:focus-within .mv-posters .p2 {
    transform: translate(6%, -30px) rotate(4deg);
    transition-delay: 0.08s;
  }
  .mv-card:hover .mv-posters .p3,
  .mv-card:focus-within .mv-posters .p3 {
    transform: translate(14%, -16px) rotate(12deg);
    transition-delay: 0.12s;
  }
  /* Global: el script crea también estas etiquetas («te faltan»), y lo creado
     en el navegador no lleva el atributo de los estilos con ámbito. */
  :global(.mv-film) {
    transition: background-color 0.15s, color 0.15s;
  }
  :global(.mv-film:hover) {
    background: var(--c-ink);
    color: var(--c-white);
  }
  :global(.mv-film:hover span) {
    color: inherit;
  }

  /* En pantallas táctiles la tarjeta va debajo del mapa, no flotando. */
  @media (hover: none) {
    .atlas-card {
      position: static;
      width: auto;
      margin: 0 0.5rem 0.5rem;
      box-shadow: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .atlas-c,
    .atlas-hl :global(.atlas-c),
    .atlas-card,
    .atlas-card :global(img),
    .mv-card,
    .mv-posters img {
      animation: none !important;
      transition: none !important;
    }
    .mv-card:hover,
    .mv-card:focus-within {
      transform: none;
    }
  }
</style>

<script>
  import { activeIn, missingMovements, mineLevel } from '../../lib/atlasmath';

  const root = document.getElementById('atlas');
  if (root) {
    const map = document.getElementById('atlas-map')!;
    const card = document.getElementById('atlas-card')!;
    const hl = document.getElementById('atlas-hl')!;
    const status = document.getElementById('atlas-status')!;
    const minePanel = document.getElementById('atlas-mine')!;
    const countries = [...map.querySelectorAll<SVGElement>('.atlas-c[data-iso]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-mv-card]')];
    const movements = cards.map((el) => ({
      el,
      id: el.id.slice(3),
      name: el.dataset.name ?? '',
      from: Number(el.dataset.from),
      to: el.dataset.to ? Number(el.dataset.to) : null,
      countries: (el.dataset.countries ?? '').split(' '),
    }));
    const fill = (tpl: string, vars: Record<string, string | number>) =>
      Object.entries(vars).reduce((s, [k, v]) => s.replace(`{${k}}`, String(v)), tpl);
    const canHover = matchMedia('(hover: hover)').matches;

    let mode: 'movements' | 'mine' = 'movements';
    let mine: Record<string, number> | null = null;

    /* ---------- Épocas ---------- */
    const eraButtons = [...root.querySelectorAll<HTMLButtonElement>('.atlas-era')];
    function setDecade(decade: number | null) {
      const on = movements.filter((m) => decade === null || activeIn(m, decade));
      const onIsos = new Set(on.flatMap((m) => m.countries));
      for (const c of countries) {
        if (!c.classList.contains('is-mv')) continue;
        const was = c.classList.contains('is-on');
        const now = onIsos.has(c.dataset.iso!);
        c.classList.toggle('is-on', now);
        // Repite el destello solo en los países que se encienden ahora.
        if (now && !was) c.style.setProperty('--i', '0');
      }
      for (const m of movements) m.el.classList.toggle('is-off', !on.includes(m));
      for (const b of eraButtons) b.setAttribute('aria-pressed', String(b.dataset.decade === (decade === null ? '' : String(decade))));
      status.textContent =
        decade === null
          ? fill(root!.dataset.tCountAll!, { n: on.length, from: root!.dataset.first! })
          : fill(root!.dataset.tCountDecade!, { n: on.length, d: decade });
    }
    for (const b of eraButtons)
      b.addEventListener('click', () => {
        close();
        setDecade(b.dataset.decade ? Number(b.dataset.decade) : null);
      });

    /* ---------- Tarjeta flotante ---------- */
    let current: SVGElement | null = null;
    function mineLine(iso: string): string {
      const n = mine?.[iso] ?? 0;
      const d = root!.dataset;
      return n === 0 ? d.tHere0! : n === 1 ? d.tHere1! : fill(d.tHereN!, { n });
    }
    function open(el: SVGElement) {
      const iso = el.dataset.iso!;
      const isMv = el.classList.contains('is-mv');
      if (mode === 'movements' && !isMv) return;
      current = el;
      const tpl = document.getElementById(`atlas-tpl-${iso}`) as HTMLTemplateElement | null;
      if (tpl) card.replaceChildren(tpl.content.cloneNode(true));
      else {
        const p = document.createElement('p');
        p.className = 'label';
        p.textContent = el.dataset.name ?? iso;
        const m = document.createElement('p');
        m.className = 'atlas-card-mine mt-1 font-mono text-meta-data text-charcoal';
        card.replaceChildren(p, m);
      }
      const line = card.querySelector<HTMLElement>('.atlas-card-mine');
      if (line) {
        line.hidden = mode !== 'mine';
        line.textContent = mode === 'mine' ? mineLine(iso) : '';
      }
      // Copia del país encima de los demás, con la animación de «levantarse».
      const copy = el.cloneNode() as SVGElement;
      for (const a of ['tabindex', 'role', 'aria-label', 'style']) copy.removeAttribute(a);
      hl.replaceChildren(copy);
      card.hidden = false;
      requestAnimationFrame(() => card.classList.add('is-open'));
    }
    function close() {
      current = null;
      card.classList.remove('is-open');
      hl.replaceChildren();
    }
    // Cerrada del todo cuando acaba de desvanecerse: fuera del árbol de
    // accesibilidad y sin ocupar sitio bajo el mapa en el móvil.
    card.addEventListener('transitionend', (e) => {
      if (e.target === card && !card.classList.contains('is-open')) card.hidden = true;
    });
    function place(x: number, y: number) {
      if (!canHover) return;
      const box = map.getBoundingClientRect();
      const cw = card.offsetWidth;
      const ch = card.offsetHeight;
      let left = x - box.left + 18;
      let top = y - box.top + 18;
      if (left + cw > box.width) left = x - box.left - cw - 18;
      if (top + ch > box.height) top = Math.max(0, y - box.top - ch - 18);
      card.style.left = `${Math.max(0, left)}px`;
      card.style.top = `${top}px`;
    }
    function placeAt(el: SVGElement) {
      const r = el.getBoundingClientRect();
      place(r.left + r.width / 2, r.top + r.height / 2);
    }

    for (const el of countries) {
      el.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        open(el);
        place(e.clientX, e.clientY);
      });
      el.addEventListener('pointermove', (e) => {
        if (e.pointerType === 'mouse' && current === el) place(e.clientX, e.clientY);
      });
      el.addEventListener('pointerleave', (e) => {
        // Si el cursor se va a la tarjeta (para pulsar un enlace), no se cierra.
        if (e.pointerType === 'mouse' && !card.contains(e.relatedTarget as Node)) close();
      });
      el.addEventListener('focus', () => {
        open(el);
        placeAt(el);
      });
      el.addEventListener('click', (e) => {
        if ((e as PointerEvent).pointerType === 'mouse') return;
        if (current === el) close();
        else {
          open(el);
          placeAt(el);
        }
      });
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          card.querySelector<HTMLAnchorElement>('a')?.focus();
        }
      });
    }
    card.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse' && !(e.relatedTarget as Element | null)?.closest?.('.atlas-c')) close();
    });
    map.addEventListener('focusout', (e) => {
      if (!map.contains(e.relatedTarget as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && current) {
        const el = current;
        close();
        el.focus();
      }
    });
    card.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) close();
    });

    /* ---------- Ficha ↔ mapa ---------- */
    for (const m of movements) {
      const isos = new Set(m.countries);
      const link = (on: boolean) => {
        if (mode !== 'movements') return;
        for (const c of countries) if (isos.has(c.dataset.iso!)) c.classList.toggle('is-linked', on);
      };
      m.el.addEventListener('pointerenter', () => link(true));
      m.el.addEventListener('pointerleave', () => link(false));
      m.el.addEventListener('focusin', () => link(true));
      m.el.addEventListener('focusout', (e) => {
        if (!m.el.contains(e.relatedTarget as Node)) link(false);
      });
    }

    /* ---------- Tu mapa ---------- */
    const viewButtons = [...root.querySelectorAll<HTMLButtonElement>('.atlas-view')];
    const showState = (state: string) => {
      for (const p of minePanel.querySelectorAll<HTMLElement>('[data-mine]')) p.hidden = p.dataset.mine !== state;
    };
    function paintMine(counts: Record<string, number>) {
      for (const c of countries) {
        c.classList.remove('m0', 'm1', 'm2', 'm3', 'm4');
        c.classList.add(`m${mineLevel(counts[c.dataset.iso!] ?? 0)}`);
      }
      const n = Object.keys(counts).length;
      const d = root!.dataset;
      document.getElementById('atlas-mine-summary')!.textContent = n === 1 ? d.tSummaryOne! : fill(d.tSummary!, { n });
      const missing = missingMovements(movements, counts);
      document.getElementById('atlas-mine-complete')!.hidden = missing.length > 0;
      document.getElementById('atlas-mine-missing')!.hidden = missing.length === 0;
      document.getElementById('atlas-mine-chips')!.replaceChildren(
        ...missing.map((m) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#mv-${m.id}`;
          a.className = 'mv-film label inline-block border border-ink bg-surface px-2 py-1 no-underline';
          a.textContent = m.name;
          li.append(a);
          return li;
        }),
      );
      showState(n ? 'ok' : 'empty');
    }
    async function loadMine() {
      showState('loading');
      try {
        const res = await fetch('/api/me/atlas', { credentials: 'same-origin', headers: { accept: 'application/json' } });
        if (res.status === 401) return showState('login');
        if (!res.ok) throw new Error(String(res.status));
        mine = (await res.json()).countries as Record<string, number>;
        if (mode === 'mine') paintMine(mine);
      } catch {
        showState('error');
      }
    }
    function setMode(next: 'movements' | 'mine') {
      mode = next;
      close();
      root!.classList.toggle('is-mine', mode === 'mine');
      minePanel.hidden = mode !== 'mine';
      for (const b of viewButtons) b.setAttribute('aria-pressed', String(b.dataset.view === mode));
      for (const c of countries) c.classList.remove('is-linked');
      if (mode === 'mine') {
        if (mine) paintMine(mine);
        else loadMine();
      }
    }
    for (const b of viewButtons) b.addEventListener('click', () => setMode(b.dataset.view as 'movements' | 'mine'));
  }
</script>
