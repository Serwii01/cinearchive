---
export const prerender = true;
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Reparto from '../../../../components/games/Reparto.astro';
import { useTranslations, langStaticPaths, normalizeLang } from '../../../../i18n/ui';

export const getStaticPaths = langStaticPaths;

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);
---

<BaseLayout title={`${t('games.reparto')} · ${t('games.title')}`} description={t('games.repartoDesc')}>
  <Reparto lang={lang} />
</BaseLayout>
