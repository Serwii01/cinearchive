---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, localizePath, langStaticPaths, normalizeLang } from '../../../i18n/ui';

export const getStaticPaths = langStaticPaths;

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);

// Cada juego, con su reto del día arriba y sus otros modos debajo. ¿Cuál tiene
// mejor nota? no tiene diario: ya es ilimitado de por sí.
const juegos = [
  {
    kicker: t('games.daily'),
    title: t('games.fotograma'),
    desc: t('games.fotogramaDesc'),
    href: localizePath(lang, 'games/fotograma'),
    modos: [
      { label: `${t('games.modeActual')} · ${t('games.endlessTab')}`, href: localizePath(lang, 'games/fotograma/ilimitado') },
      { label: `${t('games.modeClasicos')} · ${t('games.dailyTab')}`, href: localizePath(lang, 'games/fotograma/clasicos') },
      { label: `${t('games.modeClasicos')} · ${t('games.endlessTab')}`, href: localizePath(lang, 'games/fotograma/clasicos/ilimitado') },
    ],
  },
  {
    kicker: t('games.daily'),
    title: t('games.cronologia'),
    desc: t('games.cronologiaDesc'),
    href: localizePath(lang, 'games/cronologia'),
    modos: [{ label: t('games.endlessTab'), href: localizePath(lang, 'games/cronologia/ilimitado') }],
  },
  { kicker: t('games.endlessTab'), title: t('games.nota'), desc: t('games.notaDesc'), href: localizePath(lang, 'games/nota'), modos: [] },
];
---

<BaseLayout title={t('games.title')} description={t('games.intro')}>
  <section class="frame py-12">
    <header class="border-b border-ink pb-6">
      <span class="label">{t('site.title')}</span>
      <h1 class="mt-3 text-display-mobile md:text-display-lg">{t('games.title')}</h1>
      <p class="mt-5 max-w-2xl text-body-lg text-charcoal">{t('games.intro')} {t('games.endlessDesc')}</p>
    </header>

    <ul class="mt-10 grid ruled grid-cols-1 border border-ink md:grid-cols-3">
      {juegos.map((j) => (
        <li class="flex flex-col bg-surface">
          <a href={j.href} class="group flex flex-1 flex-col gap-3 p-6 no-underline transition-colors hover:bg-ink hover:text-white">
            <span class="label group-hover:text-white">{j.kicker}</span>
            <span class="font-display text-headline-lg leading-tight">{j.title}</span>
            <span class="text-body-md text-charcoal group-hover:text-white">{j.desc}</span>
            <span class="label mt-auto pt-4 group-hover:text-white">{t('games.play')} →</span>
          </a>
          {j.modos.length > 0 && (
            <ul class="border-t border-ink">
              {j.modos.map((m, i) => (
                <li class:list={[i > 0 && 'border-t border-ink/30']}>
                  <a href={m.href} class="label flex items-center justify-between gap-3 px-6 py-3 no-underline transition-colors hover:bg-ink hover:text-white">
                    {m.label} <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <p class="mt-6 max-w-3xl font-mono text-meta-data text-muted">{t('games.credit')}</p>
  </section>
</BaseLayout>
