---
export const prerender = true;
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Cronologia from '../../../../components/games/Cronologia.astro';
import { useTranslations, langStaticPaths, normalizeLang } from '../../../../i18n/ui';

export const getStaticPaths = langStaticPaths;

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);
---

<BaseLayout title={[t('games.cronologia'), t('games.endlessTab'), t('games.title')].join(' · ')} description={t('games.cronologiaDesc')}>
  <Cronologia lang={lang} endless />
</BaseLayout>
