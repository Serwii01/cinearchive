---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { normalizeLang, useTranslations, localizePath, type Lang } from '../../i18n/ui';
import SocialButtons from '../../components/SocialButtons.astro';

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);

// Si ya hay sesión, fuera de aquí.
if (Astro.locals.user) return Astro.redirect(localizePath(lang, 'account'));

const next = Astro.url.searchParams.get('next') || localizePath(lang);
---

<BaseLayout title={t('auth.loginTitle')} noindex>
  <section class="frame py-12">
    <div class="mx-auto max-w-md border border-ink bg-surface">
      <h1 class="border-b border-ink px-6 py-4 font-display text-headline-lg text-ink">{t('auth.loginTitle')}</h1>

      <form
        id="login-form"
        class="flex flex-col gap-4 p-6"
        novalidate
        data-errmsg={t('auth.error')}
        data-home={localizePath(lang)}
        data-unverified={t('auth.verifyNeeded')}
        data-verifyurl={localizePath(lang, 'verify') + '?resend=1'}
      >
        <label class="block">
          <span class="label mb-1 block">{t('auth.email')}</span>
          <input name="email" type="email" required autocomplete="email" class="w-full border border-ink bg-white px-3 py-2 font-body text-body-md focus:bg-film-white focus:outline-none" />
        </label>
        <label class="block">
          <span class="label mb-1 block">{t('auth.password')}</span>
          <input name="password" type="password" required autocomplete="current-password" minlength="8" class="w-full border border-ink bg-white px-3 py-2 font-body text-body-md focus:bg-film-white focus:outline-none" />
        </label>
        <p data-error class="hidden font-mono text-meta-data text-error"></p>
        <button type="submit" class="btn btn-primary justify-center">{t('auth.signIn')}</button>
        <a href={localizePath(lang, 'forgot')} class="text-center font-mono text-meta-data text-muted no-underline hover:text-ink">{t('auth.forgot')}</a>
      </form>

      <SocialButtons lang={lang} />

      <a href={localizePath(lang, 'register')} class="block border-t border-ink px-6 py-4 text-center font-mono text-meta-data text-muted no-underline hover:text-ink">
        {t('auth.noAccount')}
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import { signIn } from '../../lib/auth-client';

  const form = document.getElementById('login-form') as HTMLFormElement;
  const errEl = form.querySelector('[data-error]') as HTMLElement;
  const params = new URLSearchParams(window.location.search);
  // Sin ?next=, se vuelve a la portada del idioma. Antes se recortaba '/login'
  // del pathname, que en castellano (/login) daba la cadena vacía y dejaba al
  // recién identificado plantado en la propia página de acceso.
  const next = params.get('next') || form.dataset.home || '/';
  const errMsg = form.dataset.errmsg || 'Error';

  const showError = (msg: string) => {
    errEl.textContent = msg;
    errEl.classList.remove('hidden');
  };

  /**
   * Correo sin confirmar: no es un fallo de credenciales, así que se explica y
   * se enlaza a la página de confirmación. El servidor acaba de enviar un enlace
   * nuevo al intentar entrar, así que normalmente basta con mirar el correo.
   */
  const showUnverified = () => {
    errEl.textContent = '';
    errEl.classList.remove('hidden');
    errEl.append(form.dataset.unverified || 'Confirm your email.', ' ');
    const a = document.createElement('a');
    a.href = form.dataset.verifyurl || '/verify?resend=1';
    a.className = 'text-ink underline decoration-ochre';
    a.textContent = '→';
    errEl.append(a);
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errEl.classList.add('hidden');
    const fd = new FormData(form);
    const { error } = await signIn.email({
      email: String(fd.get('email')),
      password: String(fd.get('password')),
    });
    if (error?.code === 'EMAIL_NOT_VERIFIED' || error?.status === 403) showUnverified();
    else if (error) showError(error.message || errMsg);
    else window.location.href = next;
  });

  document.querySelectorAll<HTMLButtonElement>('[data-social]').forEach((b) =>
    b.addEventListener('click', () =>
      signIn.social({ provider: b.dataset.social as 'google' | 'github', callbackURL: next }),
    ),
  );
</script>
