---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, localizePath, langStaticPaths, normalizeLang } from '../../i18n/ui';

export const getStaticPaths = langStaticPaths;

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);

// Quien tiene ficha propia enlaza a ella; el resto se queda en su tarjeta.
const members: { name: string; role: string; bio?: string; href?: string }[] = [
  { name: 'Sergio Fernández Morales', role: t('sergio.role'), href: localizePath(lang, 'sergio') },
  { name: 'Jaime Rafael Aljama Lora', role: t('team.jaimeRole'), bio: t('team.jaimeBio') },
];
---

<BaseLayout title={t('team.title')} description={t('team.intro')}>
  <section class="frame py-12">
    <header class="border-b border-ink pb-6">
      <span class="label">{t('site.title')}</span>
      <h1 class="mt-3 text-display-mobile md:text-display-lg">{t('team.title')}</h1>
      <p class="mt-5 max-w-2xl text-body-lg text-charcoal">{t('team.intro')}</p>
    </header>

    <ul class="mt-10 grid ruled grid-cols-1 border border-ink md:grid-cols-2">
      {members.map((m) => (
        <li class="bg-surface">
          {m.href ? (
            <a href={m.href} class="group flex h-full flex-col gap-3 p-6 no-underline transition-colors hover:bg-ink hover:text-white">
              <span class="label">{m.role}</span>
              <span class="font-display text-headline-lg leading-tight">{m.name}</span>
              <span class="label mt-auto pt-4">{t('team.profile')} →</span>
            </a>
          ) : (
            <div class="flex h-full flex-col gap-3 p-6">
              <span class="label">{m.role}</span>
              <span class="font-display text-headline-lg leading-tight text-ink">{m.name}</span>
              {m.bio && <p class="mt-auto pt-4 text-body-lg text-charcoal">{m.bio}</p>}
            </div>
          )}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
