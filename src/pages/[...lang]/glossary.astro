---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortedGlossary, glossaryTerm, glossaryDef } from '../../lib/reference';
import { useTranslations, localizePath, langStaticPaths, normalizeLang, type Lang } from '../../i18n/ui';

export const getStaticPaths = langStaticPaths;

// El glosario volvió a tener página propia (antes era una sección plegada
// dentro de /archive). Son 66 términos: el tercer conjunto más grande del
// sitio, el tipo de contenido que se enlaza entrada por entrada y que Google
// indexa bien solo si tiene su sitio. Dentro de Archivo queda el enlace.
const lang: Lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);

const terms = sortedGlossary(lang);

// Índice alfabético: en una lista de 66 términos, saltar a la letra es la
// diferencia entre consultar y rebuscar.
const letra = (s: string) =>
  (s.trim()[0] ?? '#')
    .toLocaleUpperCase(lang)
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '');

const grupos = new Map<string, typeof terms>();
for (const g of terms) {
  const k = letra(glossaryTerm(g, lang));
  if (!grupos.has(k)) grupos.set(k, []);
  grupos.get(k)!.push(g);
}
const letras = [...grupos.keys()];
---

<BaseLayout title={t('glossary.title')} description={t('glossary.intro')}>
  <section class="frame py-12">
    <header class="border-b border-ink pb-6">
      <a href={localizePath(lang, 'archive')} class="label no-underline hover:text-ink">← {t('nav.archive')}</a>
      <span class="label mt-6 block">{t('nav.glossary')} · {terms.length} {t('glossary.count')}</span>
      <h1 class="mt-3 text-display-mobile md:text-display-lg">{t('glossary.title')}</h1>
      <p class="mt-4 max-w-2xl text-body-lg text-charcoal">{t('glossary.intro')}</p>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <input
          id="gloss-filter"
          type="search"
          autocomplete="off"
          placeholder={t('archive.searchGloss')}
          class="w-full max-w-xs border border-ink bg-white px-3 py-2 font-mono text-meta-data text-ink placeholder:text-muted focus:bg-film-white focus:outline-none"
        />
        <nav class="flex flex-wrap gap-1" aria-label={t('glossary.title')}>
          {letras.map((l) => (
            <a href={`#l-${l}`} class="label border border-outline-variant px-2 py-1 no-underline transition-colors hover:bg-ink hover:text-white">{l}</a>
          ))}
        </nav>
      </div>
    </header>

    <div id="gloss-list">
      {
        letras.map((l) => (
          <section data-letra={l} class="mt-10">
            <h2 id={`l-${l}`} class="border-b border-ink pb-2 font-display text-headline-lg text-ink">{l}</h2>
            <dl class="mt-4 grid grid-cols-1 gap-px border border-ink bg-ink md:grid-cols-2">
              {grupos.get(l)!.map((g) => (
                <div class="bg-surface p-4" data-term={`${glossaryTerm(g, lang)} ${g.term_es} ${g.term_en}`.toLowerCase()}>
                  <dt class="font-display text-headline-md text-ink">{glossaryTerm(g, lang)}</dt>
                  <dd class="mt-1 text-body-md text-charcoal">{glossaryDef(g, lang)}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>

    <p id="gloss-empty" class="mt-8 hidden font-mono text-body-md text-muted">{t('films.noResults')}</p>
  </section>
</BaseLayout>

<script>
  // Filtro de texto. Al esconder términos hay que esconder también la letra que
  // se queda sin ninguno, o quedan cabeceras huérfanas colgando.
  const input = document.getElementById('gloss-filter') as HTMLInputElement | null;
  const vacio = document.getElementById('gloss-empty');
  const bloques = Array.from(document.querySelectorAll<HTMLElement>('[data-letra]'));

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let total = 0;
    for (const bloque of bloques) {
      let n = 0;
      for (const celda of Array.from(bloque.querySelectorAll<HTMLElement>('[data-term]'))) {
        const ok = !q || (celda.dataset.term ?? '').includes(q);
        celda.hidden = !ok;
        if (ok) n++;
      }
      bloque.hidden = n === 0;
      total += n;
    }
    vacio?.classList.toggle('hidden', total !== 0);
  });
</script>
