---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCatalog, localTitle } from '../../lib/catalog';
import { normalizeLang, useTranslations, localizePath, type Lang } from '../../i18n/ui';
import { filmSlug } from '../../lib/slug';
import { pdFilms } from '../../lib/pdfilms';
import { collections } from '../../lib/collections';
import { figures } from '../../lib/figures';
import { getAtlas, countryLabel } from '../../lib/atlas';

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);

// Título y país en el idioma de la página. El filtro busca también por el
// título de referencia y el original: «Tokyo Story», «Cuentos de Tokio» y
// «東京物語» llevan a la misma fila.
const films = (await getCatalog())
  .map((f) => ({ ...f, shown: localTitle(f, lang), countryShown: countryLabel(f.country, lang) }))
  .sort((a, b) => a.year - b.year || a.shown.localeCompare(b.shown, lang));
const intro = t('films.intro').replace('{count}', String(films.length));

// Filmoteca hace de portadilla: desde aquí se entra a las cuatro secciones que
// no caben en el menú. Antes eran cuatro pastillas sueltas que no decían qué
// había detrás; ahora cada una enseña su tamaño y para qué sirve, que es lo que
// hace que alguien entre.
const atlasPaises = (await getAtlas()).length;
const secciones = [
  { path: 'cinema', label: t('nav.cinema'), desc: t('cinema.intro'), n: pdFilms.length },
  { path: 'collections', label: t('nav.collections'), desc: t('collections.intro'), n: collections.length },
  { path: 'figures', label: t('nav.figures'), desc: t('figures.intro'), n: figures.length },
  { path: 'atlas', label: t('nav.atlas'), desc: t('atlas.intro'), n: atlasPaises },
];
---

<BaseLayout
  title={t('films.title')}
  description={intro}
>
  <section class="frame py-12">
    <header class="border-b border-ink pb-6">
      <span class="label">{t('nav.films')} · {films.length}</span>
      <h1 class="mt-3 text-display-mobile md:text-display-lg">{t('films.title')}</h1>
      <p class="mt-4 max-w-2xl text-body-lg text-charcoal">{intro}</p>

    </header>

    {/* Las cuatro secciones que cuelgan de la Filmoteca. Van arriba, antes del
        catálogo: quien llega aquí buscando «qué hay» tiene que verlas sin
        bajar, y quien viene a por una ficha concreta usa el filtro de abajo. */}
    <nav class="mt-8 grid ruled grid-cols-1 border border-ink sm:grid-cols-2 lg:grid-cols-4" aria-label={t('films.sections')}>
      {
        secciones.map((s) => (
          <a href={localizePath(lang, s.path)} class="group flex flex-col bg-surface p-5 no-underline transition-colors hover:bg-film-white">
            <span class="flex items-baseline justify-between gap-2">
              <span class="font-display text-headline-lg leading-tight text-ink transition-colors group-hover:text-muted">{s.label}</span>
              <span class="font-mono text-meta-data text-ochre-dim">{s.n}</span>
            </span>
            <span class="mt-2 line-clamp-3 text-body-md text-charcoal">{s.desc}</span>
            <span class="label mt-auto pt-4 text-ink">{t('home.seeAll')} →</span>
          </a>
        ))
      }
    </nav>

    <!-- Catálogo curado (filtro local sobre las 122 fichas del archivo) -->
    <div class="mt-12 flex flex-col gap-3 border-b border-ink pb-3 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="text-headline-lg text-ink">{t('films.catalog')}</h2>
      <input
        id="film-filter"
        type="search"
        placeholder={t('films.search')}
        aria-label={t('films.search')}
        autocomplete="off"
        class="w-full max-w-xs border border-ink bg-white px-3 py-2 font-mono text-meta-data text-ink placeholder:text-muted focus:bg-film-white focus:outline-none"
      />
    </div>

    <!-- Tabla de catálogo -->
    <div class="mt-6 overflow-x-auto border border-ink">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="border-b border-ink bg-ink text-background">
            <th class="label px-3 py-2 font-medium text-background">{t('films.colTitle')}</th>
            <th class="label hidden px-3 py-2 font-medium text-background md:table-cell">{t('films.colDirector')}</th>
            <th class="label px-3 py-2 font-medium text-background">{t('films.colYear')}</th>
            <th class="label hidden px-3 py-2 font-medium text-background sm:table-cell">{t('films.colCountry')}</th>
            <th class="label hidden px-3 py-2 text-right font-medium text-background lg:table-cell">{t('films.colRuntime')}</th>
          </tr>
        </thead>
        <tbody id="film-rows">
          {
            films.map((f) => (
              <tr
                class="border-b border-outline-variant align-top transition-colors last:border-b-0 hover:bg-film-white"
                data-search={`${f.shown} ${f.title} ${f.original_title} ${f.director}`.toLowerCase()}
              >
                <td class="px-3 py-3">
                  {f.tmdbId ? (
                    <a href={localizePath(lang, `film/${filmSlug(f.tmdbId, f.shown)}`)} class="font-display text-headline-md leading-tight text-ink no-underline underline-offset-2 hover:underline">{f.shown}</a>
                  ) : (
                    <span class="font-display text-headline-md leading-tight text-ink">{f.shown}</span>
                  )}
                  {f.original_title !== f.shown && (
                    <span class="mt-0.5 block font-mono text-meta-data text-muted">{f.original_title}</span>
                  )}
                  <span class="mt-1 block font-mono text-meta-data text-muted md:hidden">{f.director}</span>
                </td>
                <td class="hidden px-3 py-3 font-mono text-meta-data text-charcoal md:table-cell">{f.director}</td>
                <td class="px-3 py-3 font-mono text-meta-data text-charcoal">{f.year}</td>
                <td class="hidden px-3 py-3 font-mono text-meta-data text-charcoal sm:table-cell">{f.countryShown}</td>
                <td class="hidden px-3 py-3 text-right font-mono text-meta-data text-charcoal lg:table-cell">{f.runtime_min}′</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p id="film-empty" class="hidden px-3 py-6 font-mono text-body-md text-muted">{t('films.noResults')}</p>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('film-filter') as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#film-rows tr'));
  const empty = document.getElementById('film-empty');

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      const match = !q || (row.dataset.search ?? '').includes(q);
      row.hidden = !match;
      if (match) visible++;
    }
    if (empty) empty.classList.toggle('hidden', visible !== 0);
  });
</script>
