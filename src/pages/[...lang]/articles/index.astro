---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getBlogPosts, blogUrl } from '../../../lib/blog';
import { useTranslations, localizePath, normalizeLang, formatDate } from '../../../i18n/ui';

// Los artículos viven en el blog (WordPress): aquí se listan y cada uno lleva
// allí. Se pinta en el servidor para que un artículo nuevo salga sin volver a
// desplegar la web; la lista se guarda unos minutos (ver lib/blog.ts).
export const prerender = false;

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);
const lista = await getBlogPosts(lang, 24);
const blog = lang === 'es' ? `${blogUrl()}/` : `${blogUrl()}/${lang}/`;
---

<BaseLayout title={t('articles.title')} description={t('articles.intro')}>
  <section class="frame py-12">
    <a href={localizePath(lang)} class="label no-underline hover:text-ink">← {t('nav.home')}</a>
    <header class="mt-6 border-b border-ink pb-6">
      <span class="label">{t('articles.title')}{lista.length > 0 && ` · ${lista.length}`}</span>
      <h1 class="mt-3 text-display-mobile md:text-display-lg">{t('articles.title')}</h1>
      <p class="mt-4 max-w-2xl text-body-lg text-charcoal">{t('articles.intro')}</p>
    </header>

    {
      lista.length > 0 ? (
        <div class="mt-10 grid grid-cols-1 gap-px border border-ink bg-ink md:grid-cols-2">
          {lista.map((a) => (
            <a href={a.url} class="group flex flex-col bg-surface no-underline transition-colors hover:bg-film-white">
              {a.image && (
                <span class="block aspect-video overflow-hidden border-b border-ink bg-charcoal">
                  <img src={a.image} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
                </span>
              )}
              <span class="flex flex-1 flex-col p-6">
                <span class="label">{[a.kicker, a.date && formatDate(new Date(a.date), lang)].filter(Boolean).join(' · ')}</span>
                <span class="mt-3 block font-display text-headline-lg leading-tight text-ink transition-colors group-hover:text-muted">{a.title}</span>
                <span class="mt-3 block text-body-md text-charcoal">{a.excerpt}</span>
                <span class="label mt-auto pt-6 text-ink">{t('articles.read')} →</span>
              </span>
            </a>
          ))}
          {lista.length % 2 === 1 && <div class="hidden bg-surface md:block" aria-hidden="true" />}
        </div>
      ) : (
        <p class="mt-10 border border-ink bg-surface p-6 text-body-lg">
          <a href={blog} class="text-ink">{t('articles.openBlog')} →</a>
        </p>
      )
    }
  </section>
</BaseLayout>
