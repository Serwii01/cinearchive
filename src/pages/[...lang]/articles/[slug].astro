---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { articles, articleBySlug, articleCopy, renderParagraph, heading } from '../../../lib/articles';
import { getFilmsBrief } from '../../../lib/films';
import { getMovie, backdropUrl } from '../../../lib/tmdb';
import { normalizeLang, useTranslations, localizePath, formatDate } from '../../../i18n/ui';
import { filmSlug } from '../../../lib/slug';
import { articleLd, breadcrumbLd } from '../../../lib/seo';

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);

const article = articleBySlug(Astro.params.slug ?? '');
if (!article) return Astro.redirect(localizePath(lang, 'articles'));
const c = articleCopy(article, lang);

// Imagen de cabecera: el fondo de una película de TMDB. Si TMDB no responde,
// la página sale sin imagen; un artículo no puede caerse por un fondo.
let cover: string | null = null;
if (article.cover) {
  try {
    cover = backdropUrl((await getMovie(article.cover.tmdbId, lang)).backdrop_path, 'w1280');
  } catch {
    cover = null;
  }
}

const briefs = article.related?.length ? await getFilmsBrief(article.related, lang) : new Map();
const relacionadas = (article.related ?? []).map((id) => briefs.get(id)).filter((f) => f != null);

const otros = articles.filter((a) => a.slug !== article.slug).map((a) => ({ slug: a.slug, c: articleCopy(a, lang) }));

const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = [
  articleLd({ url, headline: c.title, description: c.lead, image: cover ?? undefined, inLanguage: lang }),
  breadcrumbLd([
    { name: t('articles.title'), url: new URL(localizePath(lang, 'articles'), Astro.site).href },
    { name: c.title, url },
  ]),
];
---

<BaseLayout title={c.title} description={c.lead} jsonLd={jsonLd}>
  <article class="frame py-12">
    <a href={localizePath(lang, 'articles')} class="label no-underline hover:text-ink">← {t('articles.back')}</a>

    <header class="mt-6 border-b border-ink pb-6">
      <span class="label">{c.kicker} · {formatDate(new Date(article.date), lang)}</span>
      <h1 class="mt-3 max-w-4xl text-display-mobile md:text-display-lg">{c.title}</h1>
      <p class="mt-4 max-w-3xl text-body-lg text-charcoal">{c.lead}</p>
      <p class="mt-4 font-mono text-meta-data text-muted">{t('articles.by')}</p>
    </header>

    {cover && (
      <figure class="mt-8 border border-ink">
        <img src={cover} alt="" width="1280" height="720" decoding="async" class="h-64 w-full object-cover sm:h-80 md:h-[28rem]" />
      </figure>
    )}

    <div class="prose-archive mt-8 max-w-3xl">
      {
        c.body.map((p) => {
          const h = heading(p);
          return h ? <h2>{h}</h2> : <p set:html={renderParagraph(p)} />;
        })
      }
    </div>

    {relacionadas.length > 0 && (
      <section class="mt-12">
        <h2 class="border-b border-ink pb-3 text-headline-lg text-ink">{t('articles.related')}</h2>
        <div class="mt-6 grid grid-cols-2 gap-px border border-ink bg-ink sm:grid-cols-4">
          {relacionadas.map((f) => (
            <a href={localizePath(lang, `film/${filmSlug(f!.tmdbId, f!.title)}`)} class="group flex flex-col bg-surface no-underline hover:bg-film-white">
              <div class="aspect-[2/3] w-full border-b border-ink bg-charcoal">
                {f!.poster ? <img src={f!.poster} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" /> : <div class="film-grain h-full w-full" />}
              </div>
              <div class="p-2">
                <p class="font-display text-body-lg leading-tight text-ink">{f!.title}</p>
                <p class="font-mono text-meta-data text-muted">{[f!.director, f!.year].filter(Boolean).join(' · ')}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <h2 class="border-b border-ink pb-3 text-headline-lg text-ink">{t('dossiers.sources')}</h2>
        <ul class="mt-4 space-y-2">
          {article.sources.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-body-md text-charcoal hover:text-ink">{s.label} ↗</a>
            </li>
          ))}
        </ul>
      </div>
      {otros.length > 0 && (
        <div class="md:col-span-5">
          <h2 class="border-b border-ink pb-3 text-headline-lg text-ink">{t('articles.more')}</h2>
          <ul class="mt-4 flex flex-col gap-px border border-ink bg-ink">
            {otros.map((o) => (
              <li>
                <a href={localizePath(lang, `articles/${o.slug}`)} class="group block bg-surface p-4 no-underline transition-colors hover:bg-film-white">
                  <span class="label">{o.c.kicker}</span>
                  <span class="mt-1 block font-display text-headline-md leading-tight text-ink group-hover:text-muted">{o.c.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </article>
</BaseLayout>
