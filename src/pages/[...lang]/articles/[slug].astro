---
import { oldArticleUrl } from '../../../lib/blog';
import { normalizeLang } from '../../../i18n/ui';

// Los artículos se mudaron al blog. Sus direcciones antiguas redirigen allí
// para siempre (301), con el idioma, para no perder enlaces ni posicionamiento.
export const prerender = false;

const lang = normalizeLang(Astro.params.lang);
return Astro.redirect(oldArticleUrl(Astro.params.slug ?? '', lang), 301);
---
