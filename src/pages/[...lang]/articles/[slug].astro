---
import { posterSet } from '../../../lib/posters';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { articles, articleBySlug, articleCopy, renderParagraph, heading } from '../../../lib/articles';
import { getFilmsBrief } from '../../../lib/films';
import { getMovie, getTv, backdropUrl, posterUrl, posterSrcset } from '../../../lib/tmdb';
import { normalizeLang, useTranslations, localizePath, formatDate } from '../../../i18n/ui';
import { filmSlug } from '../../../lib/slug';
import { articleLd, breadcrumbLd } from '../../../lib/seo';

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);

const article = articleBySlug(Astro.params.slug ?? '');
if (!article) {
  // No existe: la página 404 de verdad, con su estado (lo pone el middleware).
  // Antes se redirigía al listado, y Google lo contaba como un 404 disfrazado.
  Astro.locals.notFound = true;
  return Astro.rewrite('/404');
}
const c = articleCopy(article, lang);

// Imagen de cabecera: el fondo de una película de TMDB. Si TMDB no responde,
// la página sale sin imagen; un artículo no puede caerse por un fondo.
let cover: string | null = article.image?.src ?? null;
if (!cover && article.cover) {
  try {
    const { tmdbId, kind = 'movie' } = article.cover;
    const path = kind === 'tv' ? (await getTv(tmdbId, lang)).backdrop_path : (await getMovie(tmdbId, lang)).backdrop_path;
    cover = backdropUrl(path, 'w1280');
  } catch {
    cover = null;
  }
}

// Galería (series o películas fuera del catálogo): cartel + pie. Una ficha que
// falle se omite; el muro sigue con las demás.
const galeria: { name: string; poster: string | null; srcset: string | null; caption: string }[] = [];
if (article.gallery) {
  for (const item of article.gallery.items) {
    try {
      const b = article.gallery.kind === 'tv'
        ? await getTv(item.tmdbId, lang).then((t) => ({ name: t.name, poster_path: t.poster_path }))
        : await getMovie(item.tmdbId, lang).then((m) => ({ name: m.title, poster_path: m.poster_path }));
      galeria.push({ name: b.name, poster: posterUrl(b.poster_path, 'w342'), srcset: posterSrcset(b.poster_path), caption: item.caption[lang] ?? item.caption.es });
    } catch {
      /* sin ficha, sin cartel */
    }
  }
}

const briefs = article.related?.length ? await getFilmsBrief(article.related, lang) : new Map();
const relacionadas = (article.related ?? []).map((id) => briefs.get(id)).filter((f) => f != null);
// El resumen trae el cartel a w185, pensado para tarjetas pequeñas; aquí las
// tarjetas son grandes y a ese tamaño el cartel sale borroso. Se pide el
// mismo cartel a w500 (y w342 para pantallas normales) cambiando el tamaño en
// la URL, que es como TMDB los sirve.
const nitido = (poster: string | null) => (poster ? poster.replace('/w185/', '/w500/') : null);
const nitidoSrcset = (poster: string | null) => posterSet(poster);

// Ancho real en pantalla de las fotos propias, para que el navegador elija bien
// en srcset: el marco mide 1440 px con 48 px de margen a cada lado (16 en
// móvil) y la rejilla separa las fotos 16 px. Si se queda corto, en pantallas
// de alta densidad baja una versión pequeña y la foto sale blanda.
const ANCHO_COMPLETO = '(min-width: 1440px) 1344px, (min-width: 768px) calc(100vw - 96px), calc(100vw - 32px)';
const ANCHO_TERCIO =
  '(min-width: 1440px) 438px, (min-width: 1024px) calc((100vw - 128px) / 3), (min-width: 768px) calc((100vw - 112px) / 2), (min-width: 640px) calc((100vw - 48px) / 2), calc(100vw - 32px)';

const otros = articles.filter((a) => a.slug !== article.slug).map((a) => ({ slug: a.slug, c: articleCopy(a, lang) }));

const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = [
  articleLd({ url, headline: c.title, description: c.lead, image: cover ? new URL(cover, Astro.site).href : undefined, inLanguage: lang }),
  breadcrumbLd([
    { name: t('articles.title'), url: new URL(localizePath(lang, 'articles'), Astro.site).href },
    { name: c.title, url },
  ]),
];
---

<BaseLayout title={c.title} description={c.lead} image={cover ?? undefined} ogType="article" jsonLd={jsonLd}>
  <article class="frame py-12">
    <a href={localizePath(lang, 'articles')} class="label no-underline hover:text-ink">← {t('articles.back')}</a>

    <header class="mt-6 border-b border-ink pb-6">
      <span class="label">{c.kicker} · {formatDate(new Date(article.date), lang)}</span>
      <h1 class="mt-3 max-w-4xl text-display-mobile md:text-display-lg">{c.title}</h1>
      <p class="mt-4 max-w-3xl text-body-lg text-charcoal">{c.lead}</p>
      <p class="mt-4 font-mono text-meta-data text-muted">{article.author ? t('articles.byAuthor').replace('{name}', article.author) : t('articles.by')}</p>
    </header>

    {c.stats && c.stats.length > 0 && (
      <div class="mt-8 grid ruled grid-cols-2 border border-ink sm:grid-cols-3 lg:grid-cols-5">
        {c.stats.map((st) => (
          <div class="bg-surface p-4">
            <p class="font-display text-display-mobile leading-none text-ink">{st.value}</p>
            <p class="mt-2 font-mono text-meta-data text-muted">{st.label}</p>
          </div>
        ))}
      </div>
    )}

    {/* Con vídeo, la portada pasa a ser su póster: pintarla además arriba la repetiría. */}
    {cover && !article.video && (
      <figure class="mt-8 border border-ink">
        {article.image?.full ? (
          // Foto propia: entera y a su proporción (recortada a franja, en el móvil
          // se perdía media foto), y en alta resolución para pantallas densas.
          <img
            src={cover}
            srcset={article.image.srcset}
            sizes={ANCHO_COMPLETO}
            alt=""
            width={article.image.width}
            height={article.image.height}
            decoding="async"
            fetchpriority="high"
            class="block h-auto w-full"
          />
        ) : (
          <img src={cover} alt="" width={article.image?.width ?? 1280} height={article.image?.height ?? 720} decoding="async" class="h-64 w-full object-cover sm:h-80 md:h-[28rem]" />
        )}
        {article.image && <figcaption class="border-t border-ink px-3 py-2 font-mono text-meta-data text-muted">{article.image.credit}</figcaption>}
      </figure>
    )}

    {/* El vídeo no se carga hasta que se pulsa: ni YouTube ni sus cookies
        entran en la página por leer el artículo. */}
    {article.video && (
      <figure class="mt-8 border border-ink">
        <div id="article-video" data-key={article.video.youtubeId}>
          <button type="button" id="article-video-btn" class="group relative block w-full" aria-label={t('articles.playVideo')}>
            {cover ? (
              <img src={cover} alt="" width="1280" height="720" loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
            ) : (
              <div class="film-grain aspect-video w-full"></div>
            )}
            <span class="absolute inset-0 flex items-center justify-center bg-ink/40 transition-colors group-hover:bg-ink/60">
              <span class="btn btn-primary pointer-events-none">▶︎ {t('articles.playVideo')}</span>
            </span>
          </button>
        </div>
        <figcaption class="border-t border-ink px-3 py-2 font-mono text-meta-data text-muted">{article.video.credit} · {t('articles.videoNote')}</figcaption>
      </figure>
    )}

    <div class="prose-archive mt-8 max-w-3xl">
      {
        c.body.map((p) => {
          const h = heading(p);
          return h ? <h2>{h}</h2> : <p set:html={renderParagraph(p)} />;
        })
      }
    </div>

    {/* Fotos propias: en columnas, cada una entera (horizontales y verticales
        mezcladas, sin recortar). Sin JavaScript, el enlace abre la foto grande;
        con él, se ve en un visor dentro de la página. */}
    {article.photos && (
      <section class="mt-12" aria-labelledby="article-photos">
        <h2 id="article-photos" class="border-b border-ink pb-3 text-headline-lg text-ink">{t('articles.photos')}</h2>
        <p class="mt-3 font-mono text-meta-data text-muted">
          {t('articles.photosBy').split('{name}')[0]}
          {article.photos.authorUrl ? (
            <a href={article.photos.authorUrl} target="_blank" rel="noopener noreferrer" class="text-charcoal hover:text-ink">{article.photos.author} ↗︎</a>
          ) : (
            article.photos.author
          )}
        </p>
        {/* Rejilla en el orden del texto: las horizontales (fotos de grupo) a todo
            lo ancho y las verticales en filas. Con columnas CSS el orden se leía
            de arriba abajo y la crónica quedaba desordenada. */}
        <div class="mt-6 grid grid-cols-1 items-start gap-4 sm:grid-cols-2 lg:grid-cols-3" data-photos>
          {article.photos.items.map((p, i) => (
            <figure class:list={['flex flex-col border border-ink bg-surface', p.width > p.height && 'sm:col-span-full']}>
              {/* thumb y medium son la cuarta parte y la mitad de la grande
                  (así se generan las fotos de prensa: 3600, 1800 y 900 px). */}
              <a href={p.src} data-photo={i} data-caption={p.caption[lang] ?? p.caption.es} data-srcset={`${p.medium} ${p.width / 2}w, ${p.src} ${p.width}w`} class="block" aria-label={`${t('articles.photoOpen')}: ${p.caption[lang] ?? p.caption.es}`}>
                <img
                  src={p.medium}
                  srcset={`${p.thumb} ${p.width / 4}w, ${p.medium} ${p.width / 2}w, ${p.src} ${p.width}w`}
                  sizes={p.width > p.height ? ANCHO_COMPLETO : ANCHO_TERCIO}
                  alt={p.caption[lang] ?? p.caption.es}
                  width={p.width}
                  height={p.height}
                  loading="lazy"
                  decoding="async"
                  class="h-auto w-full bg-charcoal"
                />
              </a>
              <figcaption class="border-t border-ink px-3 py-2 text-body-md leading-snug text-charcoal">{p.caption[lang] ?? p.caption.es}</figcaption>
            </figure>
          ))}
        </div>
        <dialog id="photo-viewer" class="photo-viewer" aria-label={t('articles.photos')}>
          {/* La foto ocupa el hueco que sobra y el pie tiene alto fijo: así los
              botones no se mueven al pasar de una horizontal a una vertical. */}
          <div class="flex h-[100dvh] w-[100vw] flex-col p-3 sm:p-6" data-viewer-frame>
            <div class="flex min-h-0 flex-1 items-center justify-center" data-viewer-stage>
              <img alt="" class="max-h-full max-w-full object-contain" data-viewer-img />
            </div>
            <div class="mx-auto mt-3 flex w-full max-w-3xl shrink-0 flex-col items-center gap-2">
              <p class="h-[6.5rem] w-full overflow-y-auto text-center text-body-md sm:h-[3.25rem]" data-viewer-caption></p>
              <p class="photo-viewer-credit font-mono text-meta-data"><span data-viewer-count></span> · © {article.photos.author}</p>
              <div class="flex gap-2">
              <button type="button" class="photo-viewer-btn font-mono text-meta-data" data-viewer-prev aria-label={t('articles.photoPrev')}>←&#xFE0E;</button>
              <button type="button" class="photo-viewer-btn font-mono text-meta-data" data-viewer-close>{t('articles.photoClose')}</button>
              <button type="button" class="photo-viewer-btn font-mono text-meta-data" data-viewer-next aria-label={t('articles.photoNext')}>→&#xFE0E;</button>
              </div>
            </div>
          </div>
        </dialog>
      </section>
    )}

    {article.stills && (
      <section class="mt-12">
        <h2 class="border-b border-ink pb-3 text-headline-lg text-ink">{t('articles.stills')}</h2>
        <p class="mt-3 max-w-3xl font-mono text-meta-data text-muted">{article.stills.credit[lang] ?? article.stills.credit.es}</p>
        <ol class="mt-6 grid ruled grid-cols-2 border border-ink sm:grid-cols-3 lg:grid-cols-4">
          {article.stills.items.map((s) => (
            <li class="flex flex-col bg-surface">
              <img src={s.src} alt={s.caption[lang] ?? s.caption.es} width="320" height="180" loading="lazy" decoding="async" class="aspect-video w-full border-b border-ink bg-ink object-cover" />
              <p class="p-2 text-body-md leading-snug text-charcoal">
                <span class="mr-1 font-mono text-meta-data text-ochre-dim">{s.time}</span>
                {s.caption[lang] ?? s.caption.es}
              </p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {galeria.length > 0 && (
      <section class="mt-12">
        <h2 class="border-b border-ink pb-3 text-headline-lg text-ink">{t('articles.gallery')}</h2>
        <div class="mt-6 grid ruled grid-cols-2 border border-ink sm:grid-cols-4">
          {galeria.map((g) => (
            <figure class="flex flex-col bg-surface">
              <div class="aspect-[2/3] w-full border-b border-ink bg-charcoal">
                {g.poster ? (
                  <img src={g.poster} srcset={g.srcset ?? undefined} sizes="(min-width:640px) 25vw, 50vw" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
                ) : (
                  <div class="film-grain h-full w-full" />
                )}
              </div>
              <figcaption class="p-2">
                <p class="font-display text-body-lg leading-tight text-ink">{g.name}</p>
                <p class="mt-1 font-mono text-meta-data text-ochre-dim">{g.caption}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {relacionadas.length > 0 && (
      <section class="mt-12">
        <h2 class="border-b border-ink pb-3 text-headline-lg text-ink">{t('articles.related')}</h2>
        <div class="mt-6 grid ruled grid-cols-2 border border-ink sm:grid-cols-4">
          {relacionadas.map((f) => (
            <a href={localizePath(lang, `film/${filmSlug(f!.tmdbId, f!.title)}`)} class="group flex flex-col bg-surface no-underline hover:bg-film-white">
              <div class="aspect-[2/3] w-full border-b border-ink bg-charcoal">
                {f!.poster ? (
                  <img src={nitido(f!.poster)!} srcset={nitidoSrcset(f!.poster)} sizes="(min-width:640px) 25vw, 50vw" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
                ) : (
                  <div class="film-grain h-full w-full" />
                )}
              </div>
              <div class="p-2">
                <p class="font-display text-body-lg leading-tight text-ink">{f!.title}</p>
                <p class="font-mono text-meta-data text-muted">{[f!.director, f!.year].filter(Boolean).join(' · ')}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <h2 class="border-b border-ink pb-3 text-headline-lg text-ink">{t('dossiers.sources')}</h2>
        <ul class="mt-4 space-y-2">
          {article.sources.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-body-md text-charcoal hover:text-ink">{s.label} ↗︎</a>
            </li>
          ))}
        </ul>
      </div>
      {otros.length > 0 && (
        <div class="md:col-span-5">
          <h2 class="border-b border-ink pb-3 text-headline-lg text-ink">{t('articles.more')}</h2>
          <ul class="mt-4 flex ruled flex-col border border-ink">
            {otros.map((o) => (
              <li>
                <a href={localizePath(lang, `articles/${o.slug}`)} class="group block bg-surface p-4 no-underline transition-colors hover:bg-film-white">
                  <span class="label">{o.c.kicker}</span>
                  <span class="mt-1 block font-display text-headline-md leading-tight text-ink group-hover:text-muted">{o.c.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </article>

  <script>
    // Vídeo: el iframe de YouTube (sin cookies) se crea solo al pulsar.
    const vw = document.getElementById('article-video');
    document.getElementById('article-video-btn')?.addEventListener('click', () => {
      const key = vw?.dataset.key;
      if (!vw || !key) return;
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${key}?autoplay=1`;
      f.title = 'YouTube';
      f.allow = 'autoplay; encrypted-media; fullscreen';
      f.setAttribute('allowfullscreen', '');
      f.className = 'aspect-video w-full';
      f.style.border = '0';
      vw.replaceChildren(f);
    });

    // Visor de fotos: <dialog> nativo (Esc cierra, el foco queda dentro).
    // Flechas del teclado y botones para pasar; pulsar fuera de la foto cierra.
    const visor = document.getElementById('photo-viewer') as HTMLDialogElement | null;
    const fotos = [...document.querySelectorAll<HTMLAnchorElement>('[data-photo]')];
    if (visor && fotos.length) {
      const img = visor.querySelector<HTMLImageElement>('[data-viewer-img]')!;
      const pie = visor.querySelector<HTMLElement>('[data-viewer-caption]')!;
      const cuenta = visor.querySelector<HTMLElement>('[data-viewer-count]')!;
      let actual = 0;
      const ver = (i: number) => {
        actual = (i + fotos.length) % fotos.length;
        const a = fotos[actual];
        // El visor ocupa toda la pantalla: con srcset, el móvil baja la de 1800 px
        // y una pantalla grande o de alta densidad, la de máxima calidad.
        img.srcset = a.dataset.srcset ?? '';
        img.sizes = '100vw';
        img.src = a.href;
        img.alt = a.dataset.caption ?? '';
        pie.textContent = a.dataset.caption ?? '';
        cuenta.textContent = `${actual + 1} / ${fotos.length}`;
      };
      fotos.forEach((a, i) =>
        a.addEventListener('click', (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey) return; // abrir en pestaña nueva sigue funcionando
          e.preventDefault();
          ver(i);
          visor.showModal();
        }),
      );
      visor.querySelector('[data-viewer-prev]')?.addEventListener('click', () => ver(actual - 1));
      visor.querySelector('[data-viewer-next]')?.addEventListener('click', () => ver(actual + 1));
      visor.querySelector('[data-viewer-close]')?.addEventListener('click', () => visor.close());
      visor.addEventListener('click', (e) => {
        const el = e.target as HTMLElement;
        if (el === visor || el.matches('[data-viewer-frame], [data-viewer-stage]')) visor.close();
      });
      visor.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') ver(actual - 1);
        if (e.key === 'ArrowRight') ver(actual + 1);
      });
    }
  </script>
</BaseLayout>
