---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { normalizeLang, useTranslations, localizePath } from '../../i18n/ui';

export const prerender = false;

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);

// Buscar películas, personas y el archivo es público; buscar usuarios requiere
// sesión (sin directorio abierto a bots). La pestaña de usuarios se ve siempre
// y, sin sesión, invita a entrar.
const loggedIn = !!Astro.locals.user;
const q = (Astro.url.searchParams.get('q') ?? '').trim();

/*
 * Pestañas, una categoría cada vez. Antes salía todo seguido (el archivo, los
 * usuarios y las películas, una sección debajo de otra) y no se encontraba
 * nada. Cada pestaña dice cuántos resultados tiene, así se sabe dónde mirar.
 * El orden es el de lo que más se busca.
 */
const TABS = [
  { id: 'films', label: t('search.sectionFilms') },
  { id: 'people', label: t('search.sectionPeople') },
  { id: 'archive', label: t('search.sectionArchive') },
  { id: 'users', label: t('search.sectionUsers') },
] as const;

const tabClass =
  'label flex items-center justify-between gap-3 border-b border-r border-ink px-4 py-3 text-left transition-colors hover:bg-film-white aria-selected:bg-ink aria-selected:text-white sm:justify-start sm:border-b-0';
---

<BaseLayout title={t('search.title')}>
  <section
    class="frame py-12"
    data-user-base={localizePath(lang, 'u')}
    data-film-base={localizePath(lang, 'film')}
    data-person-base={localizePath(lang, 'person')}
    data-lang={lang}
    data-logged-in={loggedIn ? '1' : '0'}
    data-noresults={t('search.noResults')}
    data-login-users={t('search.loginForUsers')}
    data-login-url={localizePath(lang, 'login')}
    data-kinds={JSON.stringify({
      cinema: t('nav.cinema'),
      article: t('articles.short'),
      dossier: t('nav.dossiers'),
      collection: t('nav.collections'),
      figure: t('nav.figures'),
      periodical: t('archive.title'),
      book: t('nav.library'),
      glossary: t('nav.glossary'),
    })}
    data-depts={JSON.stringify({
      Acting: t('search.dept.acting'),
      Directing: t('search.dept.directing'),
      Writing: t('search.dept.writing'),
      Production: t('search.dept.production'),
      other: t('search.dept.other'),
    })}
  >
    <header class="border-b border-ink pb-6">
      <span class="label">{t('search.title')}</span>
      <h1 class="mt-3 text-display-mobile md:text-display-lg">{t('search.title')}</h1>
    </header>

    <form id="search-form" class="mt-8 flex flex-wrap items-center gap-2" role="search">
      <input
        id="q"
        name="q"
        type="search"
        value={q}
        autocomplete="off"
        autofocus
        placeholder={t('search.placeholder')}
        aria-label={t('search.placeholder')}
        class="w-full max-w-md border border-ink bg-white px-3 py-2 font-body text-body-md text-ink placeholder:text-muted focus:bg-film-white focus:outline-none"
      />
      <button type="submit" class="btn btn-primary">{t('search.title')}</button>
    </form>

    <p id="hint" class="mt-4 font-mono text-meta-data text-muted">{t('search.hint')}</p>

    <div id="results" class="mt-8 hidden">
      <div role="tablist" aria-label={t('search.tabs')} class="grid grid-cols-2 border-l border-t border-ink sm:flex sm:border-b sm:border-r">
        {
          TABS.map((tab) => (
            <button
              type="button"
              role="tab"
              id={`tab-${tab.id}`}
              data-tab={tab.id}
              aria-selected="false"
              aria-controls={`panel-${tab.id}`}
              tabindex="-1"
              class={tabClass}
            >
              <span>{tab.label}</span>
              <span data-count class="font-mono text-meta-data opacity-70" aria-live="polite">…</span>
            </button>
          ))
        }
      </div>

      {
        TABS.map((tab) => (
          <div role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} data-panel={tab.id} class="mt-6" hidden>
            <p data-loading class="font-mono text-meta-data text-muted">{t('search.loading')}</p>
            <div data-list />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { filmSlug } from '../../lib/slug';
  import { LOCK_SVG } from '../../lib/ui/icons';

  type Tab = 'films' | 'people' | 'archive' | 'users';
  const ORDEN: Tab[] = ['films', 'people', 'archive', 'users'];

  const root = document.querySelector('[data-user-base]') as HTMLElement;
  const d = root.dataset;
  const lang = d.lang!;
  const loggedIn = d.loggedIn === '1';
  const kinds = JSON.parse(d.kinds ?? '{}') as Record<string, string>;
  const depts = JSON.parse(d.depts ?? '{}') as Record<string, string>;

  const form = document.getElementById('search-form') as HTMLFormElement;
  const input = document.getElementById('q') as HTMLInputElement;
  const hint = document.getElementById('hint') as HTMLElement;
  const results = document.getElementById('results') as HTMLElement;
  const tabs = Object.fromEntries(ORDEN.map((id) => [id, document.getElementById(`tab-${id}`) as HTMLButtonElement])) as Record<Tab, HTMLButtonElement>;
  const panels = Object.fromEntries(ORDEN.map((id) => [id, document.getElementById(`panel-${id}`) as HTMLElement])) as Record<Tab, HTMLElement>;

  const esc = (s: unknown) =>
    String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const vacio = () => `<p class="font-mono text-meta-data text-muted">${esc(d.noresults)}</p>`;

  // La pestaña que eligió la persona (o la del enlace). Sin elección, se abre
  // la primera con resultados.
  const desdeUrl = new URLSearchParams(location.search).get('tipo') as Tab | null;
  let elegida: Tab | null = desdeUrl && ORDEN.includes(desdeUrl) ? desdeUrl : null;

  function mostrar(id: Tab, foco = false) {
    for (const t of ORDEN) {
      const on = t === id;
      tabs[t].setAttribute('aria-selected', String(on));
      tabs[t].tabIndex = on ? 0 : -1;
      panels[t].hidden = !on;
    }
    if (foco) tabs[id].focus();
  }

  function contar(id: Tab, n: number | null) {
    const el = tabs[id].querySelector('[data-count]')!;
    // Sin sesión, un candado dibujado (no emoji) en vez del número.
    if (n !== null && id === 'users' && !loggedIn) el.innerHTML = LOCK_SVG;
    else el.textContent = n === null ? '…' : String(n);
  }

  function pintar(id: Tab, html: string) {
    panels[id].querySelector('[data-loading]')?.setAttribute('hidden', '');
    panels[id].querySelector('[data-list]')!.innerHTML = html;
  }

  /* ------------------------------ Pintores ------------------------------ */

  type Film = { tmdbId: number; title: string; originalTitle?: string; year: number | null; poster: string | null; posterSrcset?: string | null };
  const htmlFilms = (rows: Film[]) =>
    !rows.length
      ? vacio()
      : `<div class="grid ruled grid-cols-2 border border-ink sm:grid-cols-3 lg:grid-cols-6">${rows
          .map((r) => {
            const meta = [r.originalTitle && r.originalTitle !== r.title ? esc(r.originalTitle) : '', r.year ?? ''].filter(Boolean).join(' · ');
            const img = r.poster
              ? `<img src="${esc(r.poster)}" ${r.posterSrcset ? `srcset="${esc(r.posterSrcset)}"` : ''} sizes="(min-width:1024px) 16vw, (min-width:640px) 33vw, 50vw" alt="${esc(r.title)}" loading="lazy" decoding="async" class="h-full w-full object-cover" />`
              : `<div class="film-grain h-full w-full"></div>`;
            return `<a href="${d.filmBase}/${filmSlug(r.tmdbId, r.title)}" class="group flex flex-col bg-surface no-underline hover:bg-film-white">
              <div class="aspect-[2/3] w-full border-b border-ink bg-charcoal">${img}</div>
              <div class="flex flex-1 flex-col p-2">
                <p class="font-display text-body-lg leading-tight text-ink">${esc(r.title)}</p>
                <p class="font-mono text-meta-data text-muted">${meta}</p>
              </div>
            </a>`;
          })
          .join('')}</div>`;

  type Person = { id: number; name: string; department: string | null; knownFor: string[]; photo: string | null; photoSrcset?: string | null };
  const iniciales = (n: string) => esc((n || '?').trim().split(/\s+/).slice(0, 2).map((w) => w[0]?.toUpperCase() ?? '').join(''));
  const htmlPeople = (rows: Person[]) =>
    !rows.length
      ? vacio()
      : `<div class="grid ruled grid-cols-2 border border-ink sm:grid-cols-3 lg:grid-cols-6">${rows
          .map((p) => {
            const foto = p.photo
              ? `<img src="${esc(p.photo)}" ${p.photoSrcset ? `srcset="${esc(p.photoSrcset)}"` : ''} sizes="(min-width:1024px) 16vw, (min-width:640px) 33vw, 50vw" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />`
              : `<span class="flex h-full w-full items-center justify-center font-display text-headline-lg text-white">${iniciales(p.name)}</span>`;
            const oficio = depts[p.department ?? ''] ?? depts.other;
            return `<a href="${d.personBase}/${p.id}" class="group flex flex-col bg-surface no-underline hover:bg-film-white">
              <div class="aspect-[2/3] w-full border-b border-ink bg-charcoal">${foto}</div>
              <div class="flex flex-1 flex-col gap-0.5 p-2">
                <p class="font-display text-body-lg leading-tight text-ink">${esc(p.name)}</p>
                <p class="label">${esc(oficio)}</p>
                ${p.knownFor.length ? `<p class="mt-1 text-meta-data italic text-muted">${p.knownFor.map(esc).join(' · ')}</p>` : ''}
              </div>
            </a>`;
          })
          .join('')}</div>`;

  // El archivo, agrupado por tipo en el orden de KINDS (lo que más se visita
  // primero): Cine abierto, artículos, dosieres…
  type SiteHit = { kind: string; title: string; meta: string; href: string };
  const htmlArchive = (rows: SiteHit[]) => {
    if (!rows.length) return vacio();
    const grupos = Object.keys(kinds)
      .map((k) => ({ k, items: rows.filter((r) => r.kind === k) }))
      .filter((g) => g.items.length);
    return grupos
      .map(
        (g) => `<section class="mb-8 last:mb-0">
          <h2 class="label mb-2">${esc(kinds[g.k])} · ${g.items.length}</h2>
          <ul class="border border-ink">${g.items
            .map(
              (r) => `<li class="border-b border-outline-variant last:border-b-0"><a href="${esc(r.href)}" class="block bg-surface px-4 py-3 no-underline hover:bg-film-white">
                <span class="block font-display text-headline-md leading-tight text-ink">${esc(r.title)}</span>
                ${r.meta ? `<span class="mt-0.5 block truncate font-mono text-meta-data text-muted">${esc(r.meta)}</span>` : ''}
              </a></li>`,
            )
            .join('')}</ul>
        </section>`,
      )
      .join('');
  };

  type User = { id: string; username: string; name: string; isPrivate: boolean; hasAvatar: boolean };
  const htmlUsers = (rows: User[]) => {
    if (!loggedIn) {
      // El ?next= se arma aquí, con la búsqueda que haya en ese momento.
      const next = encodeURIComponent(location.pathname + location.search);
      return `<p class="font-mono text-meta-data text-muted"><a href="${d.loginUrl}?next=${next}" class="text-ink underline decoration-ochre">${esc(d.loginUsers)}</a></p>`;
    }
    if (!rows.length) return vacio();
    return `<ul class="grid ruled grid-cols-1 border border-ink sm:grid-cols-2">${rows
      .map((r) => {
        const avatar = r.hasAvatar
          ? `<img src="/api/avatar/${encodeURIComponent(r.id)}" alt="" class="h-full w-full object-cover" loading="lazy">`
          : `<span class="font-display text-body-md leading-none">${iniciales(r.name)}</span>`;
        return `<li class="bg-surface"><a href="${d.userBase}/${encodeURIComponent(r.username)}" class="flex items-center gap-3 p-4 no-underline hover:bg-film-white">
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden border border-ink bg-ink text-white">${avatar}</span>
          <span class="min-w-0"><span class="block truncate font-display text-headline-md text-ink">${esc(r.name)}</span>
          <span class="block font-mono text-meta-data text-muted">@${esc(r.username)}${r.isPrivate ? ` · ${LOCK_SVG}` : ''}</span></span>
        </a></li>`;
      })
      .join('')}</ul>`;
  };

  /* ------------------------------ Búsqueda ------------------------------ */

  let timer: ReturnType<typeof setTimeout>;
  let controller: AbortController | null = null;

  const pedir = <T,>(url: string, signal: AbortSignal): Promise<T[]> =>
    fetch(url, { signal, headers: { accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : { results: [] }))
      .then((j) => (j.results ?? []) as T[])
      .catch(() => [] as T[]);

  async function run(raw: string) {
    const q = raw.trim();
    controller?.abort();
    if (q.length < 2) {
      results.classList.add('hidden');
      hint.hidden = false;
      return;
    }
    hint.hidden = true;
    results.classList.remove('hidden');
    controller = new AbortController();
    const { signal } = controller;
    const enc = encodeURIComponent(q);

    for (const id of ORDEN) {
      contar(id, null);
      panels[id].querySelector('[data-loading]')?.removeAttribute('hidden');
      panels[id].querySelector('[data-list]')!.innerHTML = '';
    }
    // Mientras llega todo, se ve la pestaña elegida o la primera.
    mostrar(elegida ?? 'films');

    const fuentes: Record<Tab, Promise<unknown[]>> = {
      films: pedir<Film>(`/api/films/search?q=${enc}&lang=${lang}`, signal),
      people: pedir<Person>(`/api/search/people?q=${enc}&lang=${lang}`, signal),
      archive: pedir<SiteHit>(`/api/search/site?q=${enc}&lang=${lang}`, signal),
      users: loggedIn ? pedir<User>(`/api/users/search?q=${enc}`, signal) : Promise.resolve([]),
    };
    const pintores: Record<Tab, (rows: never[]) => string> = {
      films: htmlFilms,
      people: htmlPeople,
      archive: htmlArchive,
      users: htmlUsers,
    };

    // Cada pestaña se rellena en cuanto llega lo suyo (el archivo responde al
    // momento; TMDB tarda algo más).
    const cuentas = await Promise.all(
      ORDEN.map((id) =>
        fuentes[id].then((rows) => {
          if (signal.aborted) return 0;
          contar(id, rows.length);
          pintar(id, pintores[id](rows as never[]));
          return rows.length;
        }),
      ),
    );
    if (signal.aborted) return;

    // Sin elección: la primera pestaña con algo (usuarios solo con sesión).
    if (!elegida) {
      const i = cuentas.findIndex((n, j) => n > 0 && (ORDEN[j] !== 'users' || loggedIn));
      mostrar(i >= 0 ? ORDEN[i] : 'films');
    }
  }

  /* ------------------------------ Eventos ------------------------------- */

  // La búsqueda y la pestaña van a la URL: al abrir una ficha y volver, todo
  // sigue igual. replaceState y no pushState: cada letra no es un paso del historial.
  const syncUrl = () => {
    const url = new URL(location.href);
    const q = input.value.trim();
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    if (elegida) url.searchParams.set('tipo', elegida);
    else url.searchParams.delete('tipo');
    history.replaceState(history.state, '', url);
  };

  for (const id of ORDEN) {
    tabs[id].addEventListener('click', () => {
      elegida = id;
      mostrar(id);
      syncUrl();
    });
  }
  // Flechas para moverse entre pestañas, como pide el patrón de pestañas accesibles.
  document.querySelector('[role="tablist"]')?.addEventListener('keydown', (e) => {
    const ev = e as KeyboardEvent;
    if (ev.key !== 'ArrowRight' && ev.key !== 'ArrowLeft') return;
    const actual = ORDEN.findIndex((id) => tabs[id].getAttribute('aria-selected') === 'true');
    const sig = ORDEN[(actual + (ev.key === 'ArrowRight' ? 1 : ORDEN.length - 1)) % ORDEN.length];
    elegida = sig;
    mostrar(sig, true);
    syncUrl();
    ev.preventDefault();
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    clearTimeout(timer);
    run(input.value);
    syncUrl();
  });
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      run(input.value);
      syncUrl();
    }, 300);
  });

  if (input.value.trim().length >= 2) run(input.value);
</script>
