---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { dossiers, dossierCopy } from '../../../lib/dossiers';
import { useTranslations, localizePath, langStaticPaths, normalizeLang } from '../../../i18n/ui';

export const getStaticPaths = langStaticPaths;

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);
const fichas = dossiers.map((d) => ({ slug: d.slug, c: dossierCopy(d, lang) }));
---

<BaseLayout title={t('dossiers.title')} description={t('dossiers.intro')}>
  <section class="frame py-12">
    <a href={localizePath(lang, 'collections')} class="label no-underline hover:text-ink">← {t('nav.collections')}</a>
    <header class="mt-6 border-b border-ink pb-6">
      <span class="label">{t('dossiers.title')} · {dossiers.length} {t('dossiers.count')}</span>
      <h1 class="mt-3 text-display-mobile md:text-display-lg">{t('dossiers.title')}</h1>
      <p class="mt-4 max-w-2xl text-body-lg text-charcoal">{t('dossiers.intro')}</p>
    </header>

    <div class="mt-10 grid grid-cols-1 gap-px border border-ink bg-ink sm:grid-cols-2">
      {
        fichas.map(({ slug, c }) => (
          <a
            href={localizePath(lang, `dossiers/${slug}`)}
            class="group flex flex-col bg-surface p-6 no-underline transition-colors hover:bg-film-white"
          >
            <span class="label">{c.kicker}</span>
            <h2 class="mt-3 font-display text-headline-lg leading-tight text-ink transition-colors group-hover:text-muted">{c.title}</h2>
            <p class="mt-3 text-body-md text-charcoal">{c.blurb}</p>
            <p class="mt-auto pt-6 font-mono text-meta-data text-muted">
              {c.chronology.length} {t('dossiers.milestones')} · {c.films.length} {t('collections.films')}
            </p>
            <span class="label mt-2 text-ink">{t('dossiers.view')} →</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
