---
export const prerender = false; // la película del día se obtiene en cada visita (cacheada por día)
import BaseLayout from '../../layouts/BaseLayout.astro';
import TmdbSearch from '../../components/TmdbSearch.astro';
import IssueCard from '../../components/IssueCard.astro';
import { showcaseIssues, coverUrl } from '../../lib/periodicals';
import { pdFilms, pdThumbUrl } from '../../lib/pdfilms';
import { books, bookCoverUrl } from '../../lib/library';
import { collections, collectionTitle, collectionBlurb } from '../../lib/collections';
import { dossiers, dossierCopy } from '../../lib/dossiers';
import { articles, articleCopy } from '../../lib/articles';
import { figures } from '../../lib/figures';
import { getEphemerides, ephemerisDate, ephemerisText } from '../../lib/ephemerides';
import { profileUrl, profileSrcset } from '../../lib/tmdb';
import { getFilmOfDay } from '../../lib/featured';
import { manifesto } from '../../data/manifesto';
import { normalizeLang, useTranslations, localizePath, formatDate, type Lang } from '../../i18n/ui';
import { filmSlug } from '../../lib/slug';
import { websiteLd, organizationLd } from '../../lib/seo';

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);

// Efeméride del día. Son 33 fichas escritas y traducidas a los cinco idiomas
// que no salían en ninguna página: con 33 no se llenan 365 días, así que
// cuando hoy no toca ninguna se enseña la próxima, que siempre tiene algo que
// decir. Los textos «un día como hoy» y «próxima efeméride» ya existían.
const efem = getEphemerides();
const efemeride = { hoy: efem.onThisDay.length > 0, dato: efem.onThisDay[0] ?? efem.next };

// Últimos números: los últimos en entrar en la hemeroteca, sin repetir
// cabecera. Ocho, dos filas: con una sola fila las cabeceras en castellano
// se comían a las americanas (o al revés) y nunca se veían las dos cosas.
const latestIssues = showcaseIssues(8);

// Selección repartida (variedad) de un conjunto, para los adelantos de portada.
const sample = <T,>(arr: T[], n: number): T[] => {
  if (arr.length <= n) return arr.slice();
  const step = arr.length / n;
  return Array.from({ length: n }, (_, i) => arr[Math.floor(i * step)]);
};
const cinemaPicks = sample(pdFilms, 4);
const collectionPicks = collections.slice(0, 3);
// Dosieres especiales: son dos y van los dos, no se recorta ninguno.
const dossierPicks = dossiers.map((d) => ({ slug: d.slug, c: dossierCopy(d, lang) }));
// Artículos: los cuatro más recientes, al pie de la portada.
const articlePicks = articles.slice(0, 4).map((a) => ({ slug: a.slug, date: a.date, c: articleCopy(a, lang) }));
const figurePicks = sample(figures, 6);
const bookPicks = sample(books, 4);
// En la portada solo las 3 revistas más recientes (por año de fundación). La
// hemeroteca (/archive) sigue mostrándolas todas.

const manifestoCopy = manifesto[lang];

const film = await getFilmOfDay(lang);

// Datos estructurados de la home: WebSite (con cuadro de búsqueda) + Organization.
const homeUrl = new URL('/', Astro.site).href;
const homeJsonLd = [
  websiteLd({
    url: homeUrl,
    name: t('site.title'),
    searchUrl: new URL(localizePath(lang, 'search'), Astro.site).href,
  }),
  organizationLd({ url: homeUrl, name: t('site.title'), logo: new URL('/favicon.svg', Astro.site).href }),
];
---

<BaseLayout jsonLd={homeJsonLd}>
  {/* HERO — a la izquierda, un carrusel de novedades (artículos, hemeroteca,
      dosieres especiales) que avanza solo con una línea ocre que se va
      llenando; a la derecha, la película del día, comprimida. Sin JavaScript
      se ve la primera diapositiva y la película, y todo sigue siendo enlace.

      La altura es FIJA en escritorio: las diapositivas se apilan en la misma
      celda y las inactivas se ocultan con visibility, no con display, así la
      cabecera no cambia de tamaño al pasar de una a otra. */}
  <section class="border-b border-ink">
    <div class="frame">
      <div class="grid grid-cols-1 md:grid-cols-12 md:grid-rows-[32rem]">
        <home-carousel class="flex min-h-0 flex-col border-ink md:col-span-7 md:border-r" data-interval="7000">
          <div class="grid min-h-0 flex-1 overflow-hidden">
            {/* Un artículo por diapositiva: título y entradilla, nada más. */}
            {articlePicks.slice(0, 2).map(({ slug, date, c }, i) => (
              <a
                data-slide
                style={i === 0 ? undefined : 'visibility:hidden'}
                href={localizePath(lang, `articles/${slug}`)}
                class="group flex flex-col justify-center [grid-area:1/1] p-6 no-underline md:p-8"
              >
                <span class="label">{t('articles.title')}</span>
                <span class="mt-4 block font-mono text-meta-data text-muted">{c.kicker} · {formatDate(new Date(date), lang)}</span>
                <span class="mt-2 block font-display text-headline-lg leading-tight text-ink transition-colors group-hover:text-muted">{c.title}</span>
                <span class="mt-4 line-clamp-3 max-w-2xl text-body-md text-charcoal">{c.lead}</span>
                <span class="label mt-6 text-ink">{t('articles.read')} →</span>
              </a>
            ))}

            {/* Novedades en la hemeroteca: solo las portadas. */}
            <a data-slide style="visibility:hidden" href={localizePath(lang, 'archive')} class="group flex flex-col justify-center [grid-area:1/1] p-6 no-underline md:p-8">
              <span class="label">{t('home.latestIssues')}</span>
              <span class="mt-4 grid grid-cols-4 gap-px border border-ink bg-ink">
                {latestIssues.slice(0, 4).map((item) => (
                  <span class="block aspect-[3/4] overflow-hidden bg-charcoal">
                    <img src={coverUrl(item.id)} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover object-top" />
                  </span>
                ))}
              </span>
              <span class="mt-4 block font-mono text-meta-data text-muted">{latestIssues.slice(0, 4).map((i) => i.title).join(' · ')}</span>
              <span class="label mt-4 text-ink transition-colors group-hover:text-muted">{t('home.viewArchive')} →</span>
            </a>

            {/* Dosieres especiales: los dos títulos. */}
            <a data-slide style="visibility:hidden" href={localizePath(lang, 'dossiers')} class="group flex flex-col justify-center [grid-area:1/1] p-6 no-underline md:p-8">
              <span class="label">{t('dossiers.title')}</span>
              <span class="mt-4 block max-w-2xl text-body-md text-charcoal">{t('dossiers.intro')}</span>
              <span class="mt-6 flex flex-col gap-3">
                {dossierPicks.map(({ c }) => (
                  <span class="block border-l-2 border-ochre pl-4">
                    <span class="block font-mono text-meta-data text-muted">{c.kicker}</span>
                    <span class="block font-display text-headline-lg leading-tight text-ink transition-colors group-hover:text-muted">{c.title}</span>
                  </span>
                ))}
              </span>
              <span class="label mt-6 text-ink">{t('home.seeAll')} →</span>
            </a>
          </div>

          {/* La línea: un tramo por diapositiva. Los pasados, llenos; el actual
              se va llenando; los siguientes, vacíos. Cada tramo es un botón. */}
          <div class="flex gap-1 border-t border-ink px-6 py-0 md:px-10" role="tablist" aria-label={t('home.carousel')}>
            {Array.from({ length: Math.min(articlePicks.length, 2) + 2 }, (_, k) => k).map((i) => (
              <button type="button" role="tab" data-tab aria-selected={i === 0 ? 'true' : 'false'} aria-label={`${i + 1}`} class="group/tab flex h-11 flex-1 cursor-pointer items-center bg-transparent p-0">
                <span class="block h-[3px] w-full bg-outline-variant transition-colors group-hover/tab:bg-muted">
                  <span data-fill class="block h-full w-0 bg-ochre"></span>
                </span>
              </button>
            ))}
          </div>
        </home-carousel>

        {/* Película del día, comprimida */}
        {
          film ? (
            <div class="flex min-h-0 flex-col border-t border-ink md:col-span-5 md:overflow-hidden md:border-t-0">
              <a href={localizePath(lang, `film/${filmSlug(film.tmdbId, film.title)}`)} class="block border-b border-ink md:min-h-0 md:flex-1 md:overflow-hidden">
                {film.backdrop ? (
                  <img src={film.backdrop} alt={film.title} width="1280" height="720" decoding="async" class="h-44 w-full object-cover md:h-full" />
                ) : (
                  <div class="film-grain h-44 w-full md:h-full" />
                )}
              </a>
              <div class="flex flex-col gap-2 p-6">
                <span class="label">{t('home.filmOfDay')}</span>
                <h1 class="font-display text-headline-lg leading-tight">
                  <a href={localizePath(lang, `film/${filmSlug(film.tmdbId, film.title)}`)} class="text-ink no-underline hover:text-muted">{film.title}</a>
                </h1>
                <p class="line-clamp-2 text-body-md text-charcoal">{film.overview}</p>
                <div class="mt-2 flex flex-wrap items-center gap-4">
                  <a href={localizePath(lang, `film/${filmSlug(film.tmdbId, film.title)}`)} class="btn btn-primary no-underline">{t('home.viewFilm')}</a>
                  <span class="font-mono text-meta-data text-muted">
                    {[film.year, film.voteAverage ? `★ ${film.voteAverage.toFixed(1)}` : null].filter(Boolean).join(' · ')}
                  </span>
                </div>
              </div>
              <div class="border-t border-ink px-6 py-3">
                <span class="label">{efemeride.hoy ? t('home.onThisDay') : t('home.nextAnniversary')}</span>
                <p class="mt-1 line-clamp-2 text-body-md text-charcoal">
                  <span class="font-mono text-meta-data text-ochre-dim">{ephemerisDate(efemeride.dato, lang)}</span>
                  {' · '}
                  {ephemerisText(efemeride.dato, lang)}
                </p>
              </div>
            </div>
          ) : (
            <div class="flex flex-col justify-center border-t border-ink p-6 md:col-span-5 md:border-t-0">
              <span class="label">{t('site.tagline')}</span>
              <h1 class="mt-3 text-display-mobile">{t('site.title')}</h1>
            </div>
          )
        }
      </div>
    </div>
  </section>

  {/* ARTÍCULOS DE CINE ARCHIVE — lo vivo de la casa, justo debajo del héroe */}
  <section class="frame border-t border-ink py-12">
    <div class="mb-6 flex items-end justify-between border-b border-ink pb-3">
      <h2 class="text-headline-lg text-ink">{t('articles.title')}</h2>
      <a href={localizePath(lang, 'articles')} class="label tap no-underline hover:text-ink">{t('home.seeAll')} →</a>
    </div>
    <div class="grid grid-cols-1 gap-px border border-ink bg-ink md:grid-cols-2">
      {
        articlePicks.map(({ slug, date, c }) => (
          <a href={localizePath(lang, `articles/${slug}`)} class="group flex flex-col bg-surface p-6 no-underline transition-colors hover:bg-film-white">
            <span class="label">{c.kicker} · {formatDate(new Date(date), lang)}</span>
            <h3 class="mt-3 font-display text-headline-lg leading-tight text-ink transition-colors group-hover:text-muted">{c.title}</h3>
            <p class="mt-3 text-body-md text-charcoal">{c.lead}</p>
            <span class="label mt-auto pt-6 text-ink">{t('articles.read')} →</span>
          </a>
        ))
      }
      {/* Con un número impar de artículos, la celda que sobra se rellena para no dejar un hueco de tinta. */}
      {articlePicks.length % 2 === 1 && <div class="hidden bg-surface md:block" aria-hidden="true" />}
    </div>
  </section>

  {/* BUSCADOR TMDB */}
  <section class="frame py-12">
    <TmdbSearch lang={lang} />
  </section>

  {/* ÚLTIMOS NÚMEROS (hemeroteca) */}
  <section class="frame py-12">
    <div class="mb-6 flex items-end justify-between border-b border-ink pb-3">
      <h2 class="text-headline-lg text-ink">{t('home.latestIssues')}</h2>
      <a href={localizePath(lang, 'archive')} class="label no-underline hover:text-ink">{t('home.viewArchive')} →</a>
    </div>

    <div class="grid grid-cols-2 gap-px border border-ink bg-ink sm:grid-cols-3 lg:grid-cols-4">
      {latestIssues.map((item) => <IssueCard item={item} lang={lang} />)}
    </div>
  </section>

  {/* BIBLIOTECA (textos de dominio público) */}
  <section class="frame py-12">
    <div class="mb-6 flex items-end justify-between border-b border-ink pb-3">
      <h2 class="text-headline-lg text-ink">{t('nav.library')}</h2>
      <a href={localizePath(lang, 'library')} class="label tap no-underline hover:text-ink">{t('home.seeAll')} →</a>
    </div>
    <div class="grid grid-cols-2 gap-px border border-ink bg-ink sm:grid-cols-4">
      {
        bookPicks.map((b) => (
          <a href={localizePath(lang, `library/${b.id}`)} class="group flex flex-col bg-surface no-underline hover:bg-film-white">
            <div class="aspect-[3/4] overflow-hidden border-b border-ink bg-charcoal">
              <img src={bookCoverUrl(b.id)} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover object-top" />
            </div>
            <div class="p-3">
              <h3 class="font-display text-headline-md leading-tight text-ink transition-colors group-hover:text-muted">{b.title}</h3>
              <p class="mt-1 font-mono text-meta-data text-muted">{b.author} · {b.year}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  {/* CINE ABIERTO (dominio público) */}
  <section class="frame py-12">
    <div class="mb-6 flex items-end justify-between border-b border-ink pb-3">
      <h2 class="text-headline-lg text-ink">{t('nav.cinema')}</h2>
      <a href={localizePath(lang, 'cinema')} class="label tap no-underline hover:text-ink">{t('home.seeAll')} →</a>
    </div>
    <div class="grid grid-cols-1 gap-px border border-ink bg-ink sm:grid-cols-2 lg:grid-cols-4">
      {
        cinemaPicks.map((f) => (
          <a href={localizePath(lang, `cinema/${f.id}`)} class="group flex flex-col bg-surface no-underline hover:bg-film-white">
            <div class="aspect-video overflow-hidden border-b border-ink bg-charcoal">
              {/* alt vacío: el título ya va en el texto de al lado; con alt, el lector de pantalla lo repetiría. */}
              <img src={pdThumbUrl(f.id)} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
            </div>
            <div class="p-3">
              <h3 class="font-display text-headline-md leading-tight text-ink transition-colors group-hover:text-muted">{f.title}</h3>
              <p class="mt-1 font-mono text-meta-data text-muted">{f.director} · {f.year}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  {/* DOSIERES ESPECIALES (cine palestino · cine saharaui) */}
  <section class="frame py-12">
    <div class="mb-6 flex items-end justify-between border-b border-ink pb-3">
      <h2 class="text-headline-lg text-ink">{t('dossiers.title')}</h2>
      <a href={localizePath(lang, 'dossiers')} class="label tap no-underline hover:text-ink">{t('home.seeAll')} →</a>
    </div>
    <p class="mb-8 max-w-2xl text-body-md text-charcoal">{t('dossiers.intro')}</p>

    <div class="grid grid-cols-1 gap-px border border-ink bg-ink md:grid-cols-2">
      {
        dossierPicks.map(({ slug, c }) => (
          <a
            href={localizePath(lang, `dossiers/${slug}`)}
            class="group flex flex-col bg-surface p-6 no-underline transition-colors hover:bg-film-white"
          >
            <span class="label">{c.kicker}</span>
            <h3 class="mt-3 font-display text-headline-lg leading-tight text-ink transition-colors group-hover:text-muted">
              {c.title}
            </h3>
            <p class="mt-3 text-body-md text-charcoal">{c.blurb}</p>
            <p class="mt-auto pt-6 font-mono text-meta-data text-muted">
              {c.chronology[0].year} — {c.chronology[c.chronology.length - 1].year} · {c.films.length} {t('collections.films')}
            </p>
            <span class="label mt-2 text-ink">{t('dossiers.view')} →</span>
          </a>
        ))
      }
    </div>
  </section>

  {/* COLECCIONES (formas de recorrer el catálogo) */}
  <section class="frame py-12">
    <div class="mb-6 flex items-end justify-between border-b border-ink pb-3">
      <h2 class="text-headline-lg text-ink">{t('nav.collections')}</h2>
      <a href={localizePath(lang, 'collections')} class="label tap no-underline hover:text-ink">{t('home.seeAll')} →</a>
    </div>
    <div class="grid grid-cols-1 gap-px border border-ink bg-ink sm:grid-cols-3">
      {
        collectionPicks.map((c) => (
          <a href={localizePath(lang, `collections/${c.slug}`)} class="group flex flex-col bg-surface p-5 no-underline transition-colors hover:bg-film-white">
            <span class="label">{c.tmdbIds.length} {t('collections.films')}</span>
            <h3 class="mt-2 font-display text-headline-md leading-tight text-ink transition-colors group-hover:text-muted">{collectionTitle(c, lang)}</h3>
            <p class="mt-2 text-body-md text-charcoal">{collectionBlurb(c, lang)}</p>
          </a>
        ))
      }
    </div>
  </section>

  {/* FIGURAS */}
  <section class="frame py-12">
    <div class="mb-6 flex items-end justify-between border-b border-ink pb-3">
      <h2 class="text-headline-lg text-ink">{t('nav.figures')}</h2>
      <a href={localizePath(lang, 'figures')} class="label tap no-underline hover:text-ink">{t('home.seeAll')} →</a>
    </div>
    <div class="grid grid-cols-3 gap-px border border-ink bg-ink sm:grid-cols-6">
      {
        figurePicks.map((f) => (
          <a href={localizePath(lang, `person/${f.id}`)} class="group flex flex-col bg-surface no-underline hover:bg-film-white">
            <div class="aspect-[2/3] w-full border-b border-ink bg-charcoal">
              {profileUrl(f.profile_path, 'w185') ? (
                <img
                  src={profileUrl(f.profile_path, 'w185')}
                  srcset={profileSrcset(f.profile_path) ?? undefined}
                  sizes="(min-width: 640px) 15vw, 33vw"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              ) : (
                <div class="film-grain h-full w-full" />
              )}
            </div>
            <div class="p-2">
              <h3 class="font-display text-body-md leading-tight text-ink transition-colors group-hover:text-muted">{f.name}</h3>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  {/* ENCUENTRA TU CINE (salas reales · OpenStreetMap) */}
  <section class="frame py-12">
    <a
      href={localizePath(lang, 'cines')}
      class="group flex flex-col justify-between gap-6 border border-ink bg-surface p-6 no-underline transition-colors hover:bg-film-white md:flex-row md:items-center md:p-8"
    >
      <div class="max-w-2xl">
        <span class="label">{t('nav.cines')}</span>
        <h2 class="mt-2 font-display text-headline-lg leading-tight text-ink transition-colors group-hover:text-muted">
          {t('cines.homeTagline')}
        </h2>
        <p class="mt-2 text-body-md text-charcoal">{t('cines.intro')}</p>
      </div>
      <span class="label shrink-0 text-ink group-hover:text-muted">{t('cines.searchBtn')} →</span>
    </a>
  </section>

  {/* ¿NECESITAS AYUDA? — acceso a la guía de secciones (Info) */}
  <section class="frame py-12">
    <a
      href={localizePath(lang, 'info')}
      class="group flex flex-col justify-between gap-6 border border-ink bg-surface p-6 no-underline transition-colors hover:bg-film-white md:flex-row md:items-center md:p-8"
    >
      <div class="max-w-2xl">
        <span class="label">{t('nav.info')}</span>
        <h2 class="mt-2 font-display text-headline-lg leading-tight text-ink transition-colors group-hover:text-muted">
          {t('home.helpTitle')}
        </h2>
        <p class="mt-2 text-body-md text-charcoal">{t('home.helpBody')}</p>
      </div>
      <span class="label shrink-0 text-ink group-hover:text-muted">{t('nav.info')} →</span>
    </a>
  </section>

  {/* MANIFIESTO (antes en el navbar) */}
  <section class="frame border-t border-ink py-12">
    <header class="border-b border-ink pb-6">
      <span class="label">{t('about.title')}</span>
      <p class="mt-4 max-w-3xl font-display text-headline-md text-ink">{manifestoCopy.lead}</p>
    </header>

    <div class="grid grid-cols-1 gap-10 pt-8 md:grid-cols-12">
      <div class="prose-archive md:col-span-7 md:border-r md:border-ink md:pr-10">
        {manifestoCopy.body.map((p) => <p>{p}</p>)}
        <a href={localizePath(lang, 'about')} class="label tap mt-2 no-underline hover:text-ink">
          {t('home.readManifesto')} →
        </a>
      </div>

      <dl class="md:col-span-5">
        {
          manifestoCopy.principles.map(([term, desc], i) => (
            <div class:list={['py-4', i < manifestoCopy.principles.length - 1 && 'border-b border-outline-variant']}>
              <dt class="font-display text-headline-md text-ink">{term}</dt>
              <dd class="mt-1 text-body-md text-charcoal">{desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>
