---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, localizePath, langStaticPaths, normalizeLang, locales, type Lang, type UIKey } from '../../i18n/ui';

export const getStaticPaths = langStaticPaths;

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);

// Esta página es estática: cualquier número que se compilara sería el del día
// del despliegue. Se pinta un guion y el navegador pone la cifra de verdad
// (/api/visits); si no llega, lo dice en vez de enseñar un número viejo.

interface Item {
  path: string;
  label: UIKey;
  desc: UIKey;
}
interface Group {
  heading: UIKey;
  needsAccount?: boolean;
  items: Item[];
}

const groups: Group[] = [
  {
    heading: 'nav.films',
    items: [
      { path: '', label: 'nav.home', desc: 'info.home' },
      { path: 'films', label: 'nav.films', desc: 'info.films' },
      { path: 'discover', label: 'nav.discover', desc: 'discover.intro' },
      { path: 'cinema', label: 'nav.cinema', desc: 'cinema.intro' },
      { path: 'cines', label: 'nav.cines', desc: 'cines.intro' },
      { path: 'collections', label: 'nav.collections', desc: 'collections.intro' },
      { path: 'dossiers', label: 'nav.dossiers', desc: 'dossiers.intro' },
      { path: 'articles', label: 'articles.title', desc: 'articles.intro' },
      { path: 'figures', label: 'nav.figures', desc: 'figures.intro' },
      { path: 'atlas', label: 'nav.atlas', desc: 'atlas.intro' },
    ],
  },
  {
    heading: 'nav.archive',
    items: [
      { path: 'archive', label: 'nav.archive', desc: 'archive.intro' },
      { path: 'glossary', label: 'nav.glossary', desc: 'glossary.intro' },
      { path: 'archive#biblioteca', label: 'nav.library', desc: 'library.intro' },
      { path: 'archive#cronologia', label: 'nav.timeline', desc: 'timeline.intro' },
      { path: 'archive#palmares', label: 'nav.awards', desc: 'awards.intro' },
    ],
  },
  {
    heading: 'nav.account',
    needsAccount: true,
    items: [
      { path: 'account', label: 'nav.account', desc: 'info.account' },
      { path: 'watchlist', label: 'nav.watchlist', desc: 'info.watchlist' },
      { path: 'recommendations', label: 'nav.recommendations', desc: 'recs.intro' },
      { path: 'stats', label: 'nav.stats', desc: 'stats.intro' },
    ],
  },
  {
    heading: 'info.gSocial',
    needsAccount: true,
    items: [
      { path: 'account', label: 'profile.yours', desc: 'info.profile' },
      { path: 'search', label: 'search.title', desc: 'info.search' },
    ],
  },
  {
    heading: 'info.gProject',
    items: [
      { path: 'faq', label: 'nav.faq', desc: 'faq.intro' },
      { path: 'about', label: 'nav.about', desc: 'info.manifesto' },
      { path: 'accessibility', label: 'nav.accessibility', desc: 'info.accessibility' },
      { path: 'style', label: 'nav.style', desc: 'style.intro' },
      { path: 'privacy', label: 'nav.privacy', desc: 'info.privacy' },
      { path: 'terms', label: 'nav.terms', desc: 'info.terms' },
    ],
  },
];
---

<BaseLayout
  title={t('info.title')}
  description={t('info.intro')}
>
  <section class="frame py-12">
    <header class="border-b border-ink pb-6">
      <span class="label">{t('nav.info')}</span>
      <h1 class="mt-3 text-display-mobile md:text-display-lg">{t('info.title')}</h1>
      <p class="mt-4 max-w-2xl text-body-lg text-charcoal">{t('info.intro')}</p>
    </header>

    <div class="mt-8 flex flex-col gap-3 border border-ink bg-surface p-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="label">{t('info.visits')}</p>
        <p
          id="visitas"
          data-locale={locales[lang]}
          data-unavailable={t('info.visitsUnavailable')}
          class="mt-2 font-display text-display-mobile leading-none text-ink"
          aria-live="polite"
        >
          —
        </p>
      </div>
      <p class="max-w-md text-body-md text-charcoal">{t('info.visitsNote')}</p>
    </div>

    {/* Instalar como aplicación. Oculto por defecto: solo aparece si el
        navegador ofrece instalarla (Android) o si es un iPhone o iPad, donde
        hay que explicar el camino porque Safari no da botón. */}
    <div id="instalar" hidden class="mt-px flex flex-col gap-3 border border-ink bg-surface p-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="label">{t('install.title')}</p>
        <p class="mt-2 max-w-xl text-body-md text-charcoal">{t('install.text')}</p>
        <p id="instalar-ios" hidden class="mt-2 max-w-xl font-mono text-meta-data text-muted">{t('install.ios')}</p>
      </div>
      <button type="button" id="instalar-boton" hidden class="btn btn-primary shrink-0">{t('install.button')}</button>
    </div>

    <div class="mt-10 flex flex-col gap-12">
      {
        groups.map((g) => (
          <div>
            <h2 class="flex flex-wrap items-baseline gap-3 border-b border-ink pb-2 text-headline-lg text-ink">
              {t(g.heading)}
              {g.needsAccount && <span class="label text-muted">{t('info.needsAccount')}</span>}
            </h2>
            <ul class="mt-4 grid grid-cols-1 gap-px border border-ink bg-ink sm:grid-cols-2">
              {g.items.map((it) => (
                <a href={localizePath(lang, it.path)} class="group flex flex-col bg-surface p-4 no-underline transition-colors hover:bg-film-white">
                  <span class="font-display text-headline-md leading-tight text-ink transition-colors group-hover:text-muted">{t(it.label)} →</span>
                  <span class="mt-1 text-body-md text-charcoal">{t(it.desc)}</span>
                </a>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { isStandalone } from '../../lib/ui/standalone';

  // La cifra compilada es la de partida; aquí se pide la de verdad. Si la
  // petición falla, se queda la que hay: más vale un número viejo que un hueco.
  // --- Instalar como aplicación ---------------------------------------
  // Android/Chrome avisa con beforeinstallprompt y deja abrir el diálogo
  // cuando le demos la gana; iOS no tiene nada de eso, así que allí solo se
  // puede explicar dónde está la opción. Si ya está instalada, no se enseña.
  const caja = document.getElementById('instalar');
  const boton = document.getElementById('instalar-boton') as HTMLButtonElement | null;
  const yaInstalada = isStandalone();

  if (caja && !yaInstalada) {
    const esIos = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      // iPadOS se hace pasar por Mac; se distingue por el táctil.
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

    if (esIos) {
      caja.hidden = false;
      const pista = document.getElementById('instalar-ios');
      if (pista) pista.hidden = false;
    }

    let prompt: (Event & { prompt: () => void }) | null = null;
    addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault(); // nos guardamos el diálogo para el botón
      prompt = e as Event & { prompt: () => void };
      caja.hidden = false;
      if (boton) boton.hidden = false;
    });

    boton?.addEventListener('click', () => {
      prompt?.prompt();
      prompt = null;
      if (boton) boton.disabled = true;
    });

    addEventListener('appinstalled', () => {
      caja.hidden = true;
    });
  }

  const el = document.getElementById('visitas');
  if (el) {
    fetch('/api/visits', { headers: { accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : null))
      .then((d: { visits?: number } | null) => {
        if (!d || typeof d.visits !== 'number') throw new Error('sin cifra');
        el.textContent = new Intl.NumberFormat(el.dataset.locale || 'es-ES').format(d.visits);
      })
      .catch(() => {
        el.textContent = el.dataset.unavailable || '—';
      });
  }
</script>
