<script>
  import { confirmModal } from '../../lib/ui/modals';
  import { formatBytes, formatDuration, formatMs, formatNum, formatPct, SIN_DATO } from '../../lib/format';

  const root = document.querySelector('[data-confirm]') as HTMLElement;
  const confirmMsg = root?.dataset.confirm || 'Delete?';
  const addErr = root?.dataset.adderr || 'Error';
  const deleteLabel = root?.dataset.delete || 'Delete';
  const cancelLabel = root?.dataset.cancel || 'Cancel';
  const confirmClear = root?.dataset.confirmClear || 'Clear?';
  const clearLabel = root?.dataset.clear || 'Clear';

  // Los textos de estado vienen del servidor ya traducidos: dentro de este
  // script no hay ni una cadena que traducir.
  const ESTADO: Record<string, string> = {
    ok: root?.dataset.lOk || 'ok',
    slow: root?.dataset.lSlow || 'slow',
    down: root?.dataset.lDown || 'down',
    skipped: root?.dataset.lSkipped || '—',
  };
  const COLOR_ESTADO: Record<string, string> = {
    ok: 'text-ink',
    slow: 'text-ochre-dim',
    down: 'text-error',
    skipped: 'text-muted',
  };

  /* ================= Refresco en vivo ================= */

  const REFRESCO_MS = 10_000;
  let temporizador: number | undefined;
  let enVuelo = false; // impide que se apilen peticiones si el servidor va lento
  let fallos = 0;
  const marca = document.getElementById('ultima-act');
  const nf = document.documentElement.lang || 'es';

  /** Lee "vitals.cpu.usoPct" dentro del objeto de respuesta. */
  const leer = (obj: unknown, ruta: string): unknown =>
    ruta
      .split('.')
      .reduce<unknown>((o, k) => (o == null ? null : (o as Record<string, unknown>)[k]), obj);

  function formatear(v: unknown, fmt: string | undefined): string {
    const n = typeof v === 'number' ? v : null;
    switch (fmt) {
      case 'bytes':
        return formatBytes(n);
      case 'dur':
        return formatDuration(n);
      case 'ms':
        return formatMs(n);
      case 'pct':
        return formatPct(n);
      case 'pct1':
        return formatPct(n, 1);
      case 'carga':
        return n == null ? SIN_DATO : n.toFixed(2).replace('.', ',');
      default:
        return formatNum(n, nf);
    }
  }

  /** Mismos umbrales que en el servidor: ámbar al 75 %, rojo al 90 %. */
  function colorUso(el: HTMLElement, p: unknown) {
    if (typeof p !== 'number') return;
    el.classList.remove('text-error', 'text-ochre-dim', 'text-ink');
    el.classList.add(p >= 90 ? 'text-error' : p >= 75 ? 'text-ochre-dim' : 'text-ink');
  }

  function pintar(datos: unknown) {
    for (const el of document.querySelectorAll<HTMLElement>('[data-vital]')) {
      const v = leer(datos, el.dataset.vital!);
      el.textContent = formatear(v, el.dataset.fmt);
      if (el.hasAttribute('data-umbral')) colorUso(el, v);
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-bar]')) {
      const v = leer(datos, el.dataset.bar!);
      el.style.width = `${typeof v === 'number' ? Math.min(100, Math.max(0, v)) : 0}%`;
    }

    const d = datos as {
      caches?: { id: string; size: number }[];
      sondas?: { id: string; estado: string; ms: number | null; nota: string | null }[];
    };

    for (const c of d.caches ?? []) {
      const celda = document.querySelector<HTMLElement>(`[data-cache-size="${c.id}"]`);
      if (celda) celda.textContent = formatNum(c.size, nf);
    }

    for (const s of d.sondas ?? []) {
      const caja = document.querySelector<HTMLElement>(`[data-probe="${s.id}"]`);
      if (!caja) continue;
      const est = caja.querySelector<HTMLElement>('[data-probe-estado]');
      if (est) {
        est.textContent = ESTADO[s.estado] ?? s.estado;
        est.classList.remove('text-ink', 'text-ochre-dim', 'text-error', 'text-muted');
        est.classList.add(COLOR_ESTADO[s.estado] ?? 'text-muted');
      }
      const ms = caja.querySelector<HTMLElement>('[data-probe-ms]');
      if (ms) ms.textContent = formatMs(s.ms);
      const nota = caja.querySelector<HTMLElement>('[data-probe-nota]');
      if (nota) nota.textContent = s.nota ?? '';
    }
  }

  /**
   * Ante 429 o 5xx se para el intervalo y se reintenta con espera creciente. El
   * límite de la API es de 80 peticiones por minuto y se comparte con el resto
   * de la navegación: reintentar de inmediato convertiría un tropiezo puntual en
   * un bloqueo largo.
   */
  function retroceder() {
    parar();
    fallos++;
    const espera = Math.min(120_000, 30_000 * fallos);
    if (marca) marca.textContent = root?.dataset.lError || '';
    window.setTimeout(arrancar, espera);
  }

  async function tick() {
    if (document.hidden || enVuelo) return;
    enVuelo = true;
    try {
      const res = await fetch('/api/admin/vitals', { headers: { accept: 'application/json' } });
      if (!res.ok) {
        retroceder();
        return;
      }
      fallos = 0;
      pintar(await res.json());
      if (marca) marca.textContent = new Date().toLocaleTimeString(nf);
    } catch {
      retroceder();
    } finally {
      enVuelo = false;
    }
  }

  function parar() {
    if (temporizador) {
      window.clearInterval(temporizador);
      temporizador = undefined;
    }
  }

  function arrancar() {
    parar();
    temporizador = window.setInterval(tick, REFRESCO_MS);
    void tick(); // sin esperar al primer intervalo
  }

  // Un panel abierto en una pestaña de fondo toda la tarde no puede seguir
  // consultando Postgres cada diez segundos.
  document.addEventListener('visibilitychange', () => (document.hidden ? parar() : arrancar()));
  window.addEventListener('pagehide', parar);
  arrancar();

  /* ================= Mantenimiento de films_cache ================= */

  const L = {
    rows: root?.dataset.lRows || 'rows',
    working: root?.dataset.lWorking || '…',
    failed: root?.dataset.lFailed || 'failed',
    wouldDelete: root?.dataset.lWouldDelete || 'would delete',
    confirmPurge: root?.dataset.confirmPurge || 'Purge?',
    purge: root?.dataset.purge || 'Purge',
    mailOk: root?.dataset.lMailOk || 'Sent',
    mailFail: root?.dataset.lMailFail || 'Failed',
  };

  // Correo de prueba: va siempre a la dirección del administrador que lo pulsa.
  const mailOut = document.getElementById('email-test-out');
  document.getElementById('email-test')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.disabled = true;
    if (mailOut) mailOut.textContent = L.working;
    try {
      const r = await fetch('/api/admin/email', { method: 'POST' });
      const j = (await r.json().catch(() => ({}))) as { ok?: boolean; to?: string };
      if (mailOut) mailOut.textContent = r.ok && j.ok ? `${L.mailOk} → ${j.to ?? ''}` : L.mailFail;
    } catch {
      if (mailOut) mailOut.textContent = L.mailFail;
    } finally {
      btn.disabled = false;
    }
  });

  // Correos: elegir uno (los escritos aquí o los fijos), verlo, probarlo,
  // enviarlo (doble clic) y escribir los propios con la plantilla del boletín.
  // Mientras envía, el estado se refresca cada 3 s.
  const news = document.getElementById('news');
  if (news) {
    const N = news.dataset;
    const q = <E extends HTMLElement = HTMLElement>(s: string) => news.querySelector<E>(s)!;
    const out = q('[data-news-out]');
    const sel = q<HTMLSelectElement>('[data-news-issue]');
    const editor = q<HTMLFormElement>('[data-news-editor]');
    const LANGS = ['es', 'en', 'gl', 'eu', 'ca'] as const;
    type Item = { title: string; text: string; path: string };
    type Copia = { subject: string; preheader: string; title: string; intro: string; items: Item[]; outro: string };
    type Lista = { id: string; subject: string; custom: boolean }[];
    let lista: Lista = [];
    let actual: { id: string; copy: Partial<Record<string, Copia>> } | null = null;
    let editando: string | undefined;
    const post = (body: object) =>
      fetch('/api/admin/newsletter', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }).catch(() => null);
    const esPropio = () => !!lista.find((i) => i.id === sel.value)?.custom;

    async function cargaLista(elegir?: string) {
      const r = await fetch('/api/admin/newsletter', { cache: 'no-store' }).catch(() => null);
      if (!r?.ok) return;
      const d = (await r.json()) as { issues: Lista; current: string };
      lista = d.issues;
      sel.replaceChildren(
        ...lista.map((i) => {
          const o = document.createElement('option');
          o.value = i.id;
          o.textContent = `${i.subject} · ${i.id}`;
          return o;
        }),
      );
      sel.value = elegir ?? d.current;
      await pinta();
    }

    async function pinta() {
      const id = sel.value;
      const r = await fetch(`/api/admin/newsletter?issue=${encodeURIComponent(id)}`, { cache: 'no-store' }).catch(() => null);
      if (!r?.ok) return;
      const d = (await r.json()) as { issue: { id: string; copy: Partial<Record<string, Copia>> }; pending: number; sent: number; job: { issue: string; running: boolean; sent: number; failed: number; total: number } | null };
      actual = d.issue;
      q('[data-news-subject]').textContent = d.issue.copy.es?.subject ?? id;
      const j = d.job && d.job.issue === id ? d.job : null;
      q('[data-news-state]').textContent = j?.running
        ? `${N.lRunning} ${j.sent + j.failed} / ${j.total}`
        : `${N.lSent} ${formatNum(d.sent, nf)} · ${N.lPending} ${formatNum(d.pending, nf)}${j ? ` · ${N.lDone} (${j.sent} / ${j.failed})` : ''}`;
      q<HTMLAnchorElement>('[data-news-preview]').href = `/api/admin/newsletter?issue=${encodeURIComponent(id)}&preview=${document.documentElement.lang || 'es'}`;
      const propio = esPropio();
      // Uno que ya ha salido no se cambia ni se borra: lo recibido y lo que no, diría cosas distintas.
      q<HTMLButtonElement>('[data-news-edit]').hidden = !propio || d.sent > 0;
      q<HTMLButtonElement>('[data-news-delete]').hidden = !propio || d.sent > 0;
      q<HTMLButtonElement>('[data-news-send]').disabled = !!d.job?.running || d.pending === 0;
      if (d.job?.running) setTimeout(pinta, 3000);
    }

    // --- Editor ---
    const fila = (lang: string, item: Item = { title: '', text: '', path: '' }) => {
      const li = document.createElement('li');
      li.className = 'grid grid-cols-1 gap-2 border border-ink bg-white p-3 sm:grid-cols-[1fr_1fr]';
      const campo = (name: keyof Item, label: string, area = false) => {
        const l = document.createElement('label');
        l.className = `flex flex-col gap-1 ${area ? 'sm:col-span-2' : ''}`;
        const s = document.createElement('span');
        s.className = 'label';
        s.textContent = label;
        const i = area ? document.createElement('textarea') : document.createElement('input');
        i.name = `item-${name}`;
        i.value = item[name];
        i.className = 'border border-ink bg-white px-2 py-1 font-body text-body-md';
        if (area) (i as HTMLTextAreaElement).rows = 2;
        l.append(s, i);
        return l;
      };
      const quitar = document.createElement('button');
      quitar.type = 'button';
      quitar.className = 'label justify-self-start text-error hover:underline';
      quitar.textContent = N.lItemRemove!;
      quitar.addEventListener('click', () => li.remove());
      li.append(campo('title', N.lItemTitle!), campo('path', N.lItemPath!), campo('text', N.lItemText!, true), quitar);
      editor.querySelector(`[data-news-lang="${lang}"] [data-news-items]`)!.append(li);
    };
    const pestaña = (lang: string) => {
      editor.querySelectorAll<HTMLElement>('[data-news-lang]').forEach((f) => (f.hidden = f.dataset.newsLang !== lang));
      editor.querySelectorAll<HTMLElement>('[data-news-tab]').forEach((b) => {
        const on = b.dataset.newsTab === lang;
        b.classList.toggle('bg-ink', on);
        b.classList.toggle('text-white', on);
      });
    };
    editor.querySelectorAll<HTMLElement>('[data-news-tab]').forEach((b) => b.addEventListener('click', () => pestaña(b.dataset.newsTab!)));
    editor.querySelectorAll<HTMLElement>('[data-news-add]').forEach((b) =>
      b.addEventListener('click', () => fila(b.closest<HTMLElement>('[data-news-lang]')!.dataset.newsLang!)),
    );
    const abre = (copy: Partial<Record<string, Copia>>, id?: string) => {
      editando = id;
      for (const l of LANGS) {
        const fs = editor.querySelector<HTMLElement>(`[data-news-lang="${l}"]`)!;
        const c = copy[l];
        for (const k of ['subject', 'preheader', 'title', 'intro', 'outro'] as const) {
          (fs.querySelector(`[name="${k}"]`) as HTMLInputElement).value = c?.[k] ?? '';
        }
        fs.querySelector('[data-news-items]')!.replaceChildren();
        (c?.items ?? []).forEach((it) => fila(l, it));
      }
      if (!copy.es?.items?.length) fila('es');
      pestaña('es');
      editor.hidden = false;
      q('[data-news-editor-out]').textContent = '';
      editor.scrollIntoView({ block: 'start', behavior: 'smooth' });
    };
    const lee = (): Partial<Record<string, Copia>> => {
      const copy: Partial<Record<string, Copia>> = {};
      for (const l of LANGS) {
        const fs = editor.querySelector<HTMLElement>(`[data-news-lang="${l}"]`)!;
        const v = (k: string) => (fs.querySelector(`[name="${k}"]`) as HTMLInputElement).value.trim();
        const items = [...fs.querySelectorAll<HTMLElement>('[data-news-items] li')]
          .map((li) => ({
            title: (li.querySelector('[name="item-title"]') as HTMLInputElement).value.trim(),
            text: (li.querySelector('[name="item-text"]') as HTMLTextAreaElement).value.trim(),
            path: (li.querySelector('[name="item-path"]') as HTMLInputElement).value.trim(),
          }))
          .filter((i) => i.title && i.path);
        // Un idioma sin asunto ni título se queda fuera: lo recibirá en castellano.
        if (l !== 'es' && !v('subject') && !v('title')) continue;
        copy[l] = { subject: v('subject'), preheader: v('preheader'), title: v('title'), intro: v('intro'), items, outro: v('outro') };
      }
      return copy;
    };
    editor.addEventListener('submit', async (e) => {
      e.preventDefault();
      const salida = q('[data-news-editor-out]');
      const r = await post({ action: 'save', ...(editando ? { id: editando } : {}), copy: lee() });
      const j = (await r?.json().catch(() => ({}))) as { id?: string; error?: string };
      if (r?.ok && j.id) {
        salida.textContent = N.lSaved!;
        editor.hidden = true;
        await cargaLista(j.id);
      } else salida.textContent = j.error === 'sent' ? N.lLocked! : j.error === 'fixed' ? N.lFixed! : N.lInvalid!;
    });
    q('[data-news-cancel]').addEventListener('click', () => (editor.hidden = true));
    q('[data-news-new]').addEventListener('click', () => abre({}));
    q('[data-news-edit]').addEventListener('click', () => actual && abre(actual.copy, actual.id));
    // Duplicar: el texto de este (también de un fijo) como punto de partida de uno nuevo.
    q('[data-news-dup]').addEventListener('click', () => actual && abre(actual.copy));

    // --- Acciones sobre el correo elegido ---
    sel.addEventListener('change', () => {
      editor.hidden = true;
      void pinta();
    });
    q('[data-news-test]').addEventListener('click', async () => {
      out.textContent = L.working;
      const r = await post({ action: 'test', issue: sel.value, lang: document.documentElement.lang });
      const j = (await r?.json().catch(() => ({}))) as { ok?: boolean; to?: string };
      out.textContent = r?.ok && j.ok ? `${N.lOk} → ${j.to ?? ''}` : N.lFail!;
    });
    const enviar = q<HTMLButtonElement>('[data-news-send]');
    enviar.addEventListener('click', async () => {
      // Primer clic: pide confirmación; el segundo envía. Nada de confirm().
      if (enviar.dataset.armed !== sel.value) {
        enviar.dataset.armed = sel.value;
        out.textContent = N.lConfirm!;
        return;
      }
      delete enviar.dataset.armed;
      out.textContent = L.working;
      const r = await post({ action: 'send', issue: sel.value, confirm: sel.value });
      out.textContent = r?.ok ? '' : N.lFail!;
      void pinta();
    });
    const borrar = q<HTMLButtonElement>('[data-news-delete]');
    borrar.addEventListener('click', async () => {
      if (borrar.dataset.armed !== sel.value) {
        borrar.dataset.armed = sel.value;
        out.textContent = N.lDelConfirm!;
        return;
      }
      delete borrar.dataset.armed;
      const r = await post({ action: 'delete', id: sel.value });
      out.textContent = r?.ok ? '' : N.lFail!;
      await cargaLista();
    });
    void cargaLista();
  }

  async function mantenimiento(body: object) {
    const res = await fetch('/api/admin/db', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (!res.ok) throw new Error(String(res.status));
    return (await res.json()) as { filas: number; afectadas?: number; total?: number; bytesAntes?: number; bytesDespues?: number };
  }

  const resumen = (r: { filas: number; afectadas?: number; bytesAntes?: number; bytesDespues?: number }) =>
    `${formatNum(r.afectadas ?? 0, nf)} / ${formatNum(r.filas, nf)} ${L.rows} · ${formatBytes(r.bytesAntes ?? null)} → ${formatBytes(r.bytesDespues ?? null)}`;

  const compactOut = document.getElementById('db-compact-out');
  document.getElementById('db-compact')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.disabled = true;
    if (compactOut) compactOut.textContent = L.working;
    try {
      const r = await mantenimiento({ action: 'compact' });
      if (compactOut) compactOut.textContent = resumen(r);
      void tick(); // repinta el tamaño de la BD
    } catch {
      if (compactOut) compactOut.textContent = L.failed;
    } finally {
      btn.disabled = false;
    }
  });

  const purgeOut = document.getElementById('db-purge-out');
  const diasPurga = () => {
    const v = Number((document.getElementById('db-purge-days') as HTMLInputElement | null)?.value);
    return Number.isFinite(v) ? Math.min(3650, Math.max(30, Math.round(v))) : 180;
  };

  document.getElementById('db-purge-count')?.addEventListener('click', async () => {
    if (purgeOut) purgeOut.textContent = L.working;
    try {
      const r = await mantenimiento({ action: 'purge', days: diasPurga(), dryRun: true });
      if (purgeOut) purgeOut.textContent = `${L.wouldDelete} ${formatNum(r.filas, nf)} / ${formatNum(r.total ?? 0, nf)} ${L.rows}`;
    } catch {
      if (purgeOut) purgeOut.textContent = L.failed;
    }
  });

  document.getElementById('db-purge')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const dias = diasPurga();
    // Primero se cuenta, para que la confirmación diga cuántas se van.
    let cuantas = 0;
    try {
      cuantas = (await mantenimiento({ action: 'purge', days: dias, dryRun: true })).filas;
    } catch {
      if (purgeOut) purgeOut.textContent = L.failed;
      return;
    }
    const ok = await confirmModal({
      title: L.purge,
      message: `${L.confirmPurge} ${L.wouldDelete} ${formatNum(cuantas, nf)} ${L.rows} (${dias} d).`,
      confirmLabel: L.purge,
      cancelLabel,
    });
    if (!ok) return;
    btn.disabled = true;
    if (purgeOut) purgeOut.textContent = L.working;
    try {
      const r = await mantenimiento({ action: 'purge', days: dias });
      if (purgeOut) purgeOut.textContent = resumen(r);
      void tick();
    } catch {
      if (purgeOut) purgeOut.textContent = L.failed;
    } finally {
      btn.disabled = false;
    }
  });

  /* ================= Vaciar cachés ================= */

  async function vaciar(id: string) {
    const res = await fetch('/api/admin/caches', {
      method: 'DELETE',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ id }),
    });
    if (res.ok) void tick(); // repinta los tamaños sin recargar la página
  }

  document.querySelectorAll<HTMLButtonElement>('[data-clear-cache]').forEach((b) =>
    b.addEventListener('click', async () => {
      const ok = await confirmModal({
        title: clearLabel,
        message: confirmClear,
        confirmLabel: clearLabel,
        cancelLabel,
      });
      if (ok) await vaciar(b.dataset.clearCache!);
    }),
  );

  document.getElementById('vaciar-todas')?.addEventListener('click', async () => {
    const ok = await confirmModal({
      title: clearLabel,
      message: confirmClear,
      confirmLabel: clearLabel,
      cancelLabel,
    });
    if (ok) await vaciar('all');
  });

  /* ================= Gestión de contenido ================= */

  const form = document.getElementById('add-film-form') as HTMLFormElement | null;
  const msg = document.getElementById('add-msg');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById('tmdb-id') as HTMLInputElement;
    const tmdbId = Number(input.value);
    if (!tmdbId) return;
    if (msg) msg.textContent = '…';
    try {
      const res = await fetch('/api/admin/films', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ tmdbId }),
      });
      if (res.ok) location.reload();
      else if (msg) msg.textContent = addErr;
    } catch {
      if (msg) msg.textContent = addErr;
    }
  });

  // Quitar una película añadida: ahora pide confirmación, como el borrado de
  // usuario. Antes se borraba al primer clic, sin red de seguridad.
  document.querySelectorAll<HTMLButtonElement>('[data-remove-film]').forEach((b) =>
    b.addEventListener('click', async () => {
      const ok = await confirmModal({
        title: deleteLabel,
        message: confirmClear,
        confirmLabel: deleteLabel,
        cancelLabel,
        danger: true,
      });
      if (!ok) return;
      const tmdbId = Number(b.dataset.removeFilm);
      const res = await fetch('/api/admin/films', {
        method: 'DELETE',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ tmdbId }),
      });
      if (res.ok) location.reload();
    }),
  );

  /* ================= Etiquetas de usuario ================= */

  const badgeErrors = JSON.parse(root?.dataset.badgeErrors || '{}') as Record<string, string>;
  const confirmBadge = root?.dataset.confirmBadge || 'Delete?';

  const badgeForm = document.getElementById('badge-form') as HTMLFormElement | null;
  const badgeMsg = document.getElementById('badge-msg');
  badgeForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(badgeForm);
    const res = await fetch('/api/admin/badges', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ name: fd.get('name'), description: fd.get('description'), color: fd.get('color') }),
    });
    if (res.ok) {
      location.reload();
      return;
    }
    const data = await res.json().catch(() => ({}));
    if (badgeMsg) {
      badgeMsg.classList.add('text-error');
      badgeMsg.textContent = badgeErrors[data.error] || 'Error';
    }
  });

  document.querySelectorAll<HTMLButtonElement>('[data-del-badge]').forEach((b) =>
    b.addEventListener('click', async () => {
      const ok = await confirmModal({ title: deleteLabel, message: confirmBadge, confirmLabel: deleteLabel, cancelLabel, danger: true });
      if (!ok) return;
      const res = await fetch('/api/admin/badges', {
        method: 'DELETE',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id: Number(b.dataset.delBadge) }),
      });
      if (res.ok) location.reload();
    }),
  );

  document.querySelectorAll<HTMLButtonElement>('[data-badge-edit]').forEach((b) =>
    b.addEventListener('click', () => {
      const editor = document.querySelector<HTMLElement>(`[data-badge-editor="${b.dataset.badgeEdit}"]`);
      if (editor) editor.hidden = !editor.hidden;
    }),
  );

  const chipHtml = (badges: { name: string; color: string; description: string | null }[]) => {
    if (badges.length === 0) return '';
    const cls = (c: string) => (c === 'ink' ? 'border-ink bg-ink text-white' : c === 'outline' ? 'border-ink bg-transparent text-ink' : 'border-ink bg-ochre text-on-accent');
    const esc = (s: string) => s.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]!);
    return `<ul class="flex flex-wrap gap-1.5">${badges
      .map((x) => `<li class="label inline-block border px-1.5 py-0.5 text-[10px] ${cls(x.color)}"${x.description ? ` title="${esc(x.description)}"` : ''}>${esc(x.name)}</li>`)
      .join('')}</ul>`;
  };

  document.querySelectorAll<HTMLButtonElement>('[data-badge-save]').forEach((b) =>
    b.addEventListener('click', async () => {
      const userId = b.dataset.badgeSave!;
      const editor = document.querySelector<HTMLElement>(`[data-badge-editor="${userId}"]`)!;
      const badgeIds = Array.from(editor.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')).map((i) => Number(i.value));
      const out = editor.querySelector('[data-badge-msg]');
      b.disabled = true;
      const res = await fetch('/api/admin/badges', {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ userId, badgeIds }),
      });
      b.disabled = false;
      if (!res.ok) {
        if (out) out.textContent = 'Error';
        return;
      }
      const data = (await res.json()) as { badges: { name: string; color: string; description: string | null }[] };
      const chips = document.querySelector<HTMLElement>(`[data-badge-cell="${userId}"] [data-badge-chips]`);
      if (chips) chips.innerHTML = chipHtml(data.badges);
      editor.hidden = true;
    }),
  );

  document.querySelectorAll<HTMLButtonElement>('[data-del-user]').forEach((b) =>
    b.addEventListener('click', async () => {
      const ok = await confirmModal({
        title: deleteLabel,
        message: confirmMsg,
        confirmLabel: deleteLabel,
        cancelLabel,
        danger: true,
      });
      if (!ok) return;
      const userId = b.dataset.delUser;
      const res = await fetch('/api/admin/users', {
        method: 'DELETE',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ userId }),
      });
      if (res.ok) location.reload();
    }),
  );
</script>
