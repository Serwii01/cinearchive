---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { normalizeLang, useTranslations, localizePath, type Lang } from '../../i18n/ui';
import SocialButtons from '../../components/SocialButtons.astro';
import { requireEmailVerification } from '../../lib/auth';

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);

if (Astro.locals.user) return Astro.redirect(localizePath(lang, 'account'));
---

<BaseLayout title={t('auth.registerTitle')} noindex>
  <section class="frame py-12">
    <div class="mx-auto max-w-md border border-ink bg-surface">
      <h1 class="border-b border-ink px-6 py-4 font-display text-headline-lg text-ink">{t('auth.registerTitle')}</h1>

      {/* Tras registrarse, si hay que confirmar el correo, el formulario deja
          paso a este aviso: no hay sesión hasta pulsar el enlace. */}
      <div id="register-sent" hidden class="flex flex-col gap-4 border-b border-ink p-6">
        <span class="label">{t('auth.verifyTitle')}</span>
        <p class="font-display text-headline-md leading-tight text-ink">{t('auth.verifySentTitle')}</p>
        <p class="text-body-md text-charcoal">{t('auth.verifySentNote')}</p>
        <a href={localizePath(lang, 'verify') + '?resend=1'} class="label text-ink no-underline hover:text-muted">{t('auth.verifyResend')} →</a>
      </div>

      <form
        id="register-form"
        class="flex flex-col gap-4 p-6"
        novalidate
        data-errmsg={t('auth.error')}
        data-acceptmsg={t('auth.mustAccept')}
        data-next={localizePath(lang, 'account')}
        data-verify={requireEmailVerification ? '1' : ''}
      >
        <label class="block">
          <span class="label mb-1 block">{t('auth.name')}</span>
          <input name="name" type="text" required autocomplete="name" class="w-full border border-ink bg-white px-3 py-2 font-body text-body-md focus:bg-film-white focus:outline-none" />
        </label>
        <label class="block">
          <span class="label mb-1 block">{t('auth.email')}</span>
          <input name="email" type="email" required autocomplete="email" class="w-full border border-ink bg-white px-3 py-2 font-body text-body-md focus:bg-film-white focus:outline-none" />
        </label>
        <label class="block">
          <span class="label mb-1 block">{t('auth.password')}</span>
          <input name="password" type="password" required autocomplete="new-password" minlength="8" class="w-full border border-ink bg-white px-3 py-2 font-body text-body-md focus:bg-film-white focus:outline-none" />
        </label>
        <label class="flex items-start gap-2 text-body-md text-charcoal">
          <input name="accept" type="checkbox" required class="mt-1 h-4 w-4 shrink-0 accent-ink" />
          <span>
            {t('auth.acceptPre')}{' '}
            <a href={localizePath(lang, 'privacy')} target="_blank" rel="noopener" class="text-ink underline decoration-ochre">{t('nav.privacy')}</a>{' '}
            {t('auth.acceptMid')}{' '}
            <a href={localizePath(lang, 'terms')} target="_blank" rel="noopener" class="text-ink underline decoration-ochre">{t('nav.terms')}</a>.
          </span>
        </label>
        <p data-error class="hidden font-mono text-meta-data text-error"></p>
        <button type="submit" class="btn btn-primary justify-center">{t('auth.signUp')}</button>
      </form>

      <SocialButtons lang={lang} />

      <a href={localizePath(lang, 'login')} class="block border-t border-ink px-6 py-4 text-center font-mono text-meta-data text-muted no-underline hover:text-ink">
        {t('auth.haveAccount')}
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import { signUp, signIn } from '../../lib/auth-client';

  const form = document.getElementById('register-form') as HTMLFormElement;
  const errEl = form.querySelector('[data-error]') as HTMLElement;
  const errMsg = form.dataset.errmsg || 'Error';
  const acceptMsg = form.dataset.acceptmsg || 'You must accept the terms.';
  const accept = form.querySelector('[name="accept"]') as HTMLInputElement;
  // La URL viene ya construida desde el servidor: en castellano la cuenta vive
  // en /account (sin prefijo) y en los demás idiomas en /xx/account, así que
  // deducirla del pathname en el cliente daría la ruta equivocada.
  const home = form.dataset.next || '/account';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errEl.classList.add('hidden');
    if (!accept?.checked) {
      errEl.textContent = acceptMsg;
      errEl.classList.remove('hidden');
      return;
    }
    const fd = new FormData(form);
    const { error } = await signUp.email({
      name: String(fd.get('name')),
      email: String(fd.get('email')),
      password: String(fd.get('password')),
    });
    if (error) {
      errEl.textContent = error.message || errMsg;
      errEl.classList.remove('hidden');
    } else if (form.dataset.verify) {
      // Hay que confirmar el correo: no hay sesión todavía, así que en vez de
      // llevarlo a su cuenta (que lo devolvería al login) se le dice que mire
      // el correo. El formulario desaparece para que no vuelva a enviarlo.
      const aviso = document.getElementById('register-sent');
      if (aviso) aviso.hidden = false;
      form.hidden = true;
      aviso?.scrollIntoView({ block: 'center' });
    } else {
      window.location.href = home;
    }
  });

  document.querySelectorAll<HTMLButtonElement>('[data-social]').forEach((b) =>
    b.addEventListener('click', () =>
      signIn.social({ provider: b.dataset.social as 'google' | 'github', callbackURL: home }),
    ),
  );
</script>
