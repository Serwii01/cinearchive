---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { normalizeLang, useTranslations, localizePath, contentLang, type Lang } from '../../i18n/ui';
import { filmSlug } from '../../lib/slug';
import { discoverMovies, posterUrl, posterSrcset, type DiscoverParams } from '../../lib/tmdb';
import { GENRES, genreName } from '../../data/genres';
import { COUNTRIES } from '../../data/countries';
import { LANGUAGES } from '../../data/languages';

const lang = normalizeLang(Astro.params.lang);
const t = useTranslations(lang);
// Los catálogos de datos (géneros, países, idiomas) solo tienen etiqueta ES/EN;
// para gl/eu/ca se cae al idioma de contenido correspondiente.
const cl = contentLang(lang);
const sp = Astro.url.searchParams;

const genreIds = new Set(GENRES.map((g) => g.id));
const langCodes = new Set(LANGUAGES.map((l) => l.code));
const countryCodes = new Set(COUNTRIES.map((c) => c.code));

// Géneros seleccionados (repetibles) y excluidos, validados y sin solaparse.
const genres = [...new Set(sp.getAll('genre').map(Number))].filter((id) => genreIds.has(id));
const exclude = [...new Set(sp.getAll('exclude').map(Number))].filter(
  (id) => genreIds.has(id) && !genres.includes(id),
);
const genreMode = sp.get('mode') === 'or' ? 'or' : 'and';

const decade = Number(sp.get('decade')) || null;
const country = countryCodes.has(sp.get('country') ?? '') ? sp.get('country') : null;
const olang = langCodes.has(sp.get('olang') ?? '') ? sp.get('olang') : null;

const clampNum = (v: string | null, min: number, max: number): number | null => {
  const n = Number(v);
  return v && Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : null;
};
const minRating = clampNum(sp.get('rating'), 0, 10);
const minVotes = clampNum(sp.get('votes'), 0, 100000);
const runtimeGte = clampNum(sp.get('rtmin'), 0, 1000);
const runtimeLte = clampNum(sp.get('rtmax'), 0, 1000);

const sortParam = sp.get('sort') || 'popularity.desc';
const allowedSorts = ['popularity.desc', 'vote_average.desc', 'primary_release_date.desc'] as const;
const sort = (allowedSorts as readonly string[]).includes(sortParam)
  ? (sortParam as DiscoverParams['sort'])
  : 'popularity.desc';
const page = Math.max(1, Math.min(500, Number(sp.get('page')) || 1));

const decades: number[] = [];
for (let d = 2020; d >= 1900; d -= 10) decades.push(d);
const ratingOptions = [5, 6, 7, 8];
const votesOptions = [100, 500, 1000, 5000];

let results: Awaited<ReturnType<typeof discoverMovies>> = { results: [], totalPages: 1 };
try {
  results = await discoverMovies(
    {
      genres: genres.length ? genres : undefined,
      genreMode,
      excludeGenres: exclude.length ? exclude : undefined,
      decade: decade ?? undefined,
      country: country ?? undefined,
      originalLanguage: olang ?? undefined,
      minRating: minRating ?? undefined,
      minVotes: minVotes ?? undefined,
      runtimeGte: runtimeGte ?? undefined,
      runtimeLte: runtimeLte ?? undefined,
      sort,
      page,
    },
    lang,
  );
} catch {
  /* deja resultados vacíos */
}

// Nº de filtros activos (para el resumen de la cabecera).
const activeFilters =
  genres.length +
  exclude.length +
  (decade ? 1 : 0) +
  (country ? 1 : 0) +
  (olang ? 1 : 0) +
  (minRating != null ? 1 : 0) +
  (minVotes != null ? 1 : 0) +
  (runtimeGte != null ? 1 : 0) +
  (runtimeLte != null ? 1 : 0);
// Abrir "Filtros avanzados" si alguno de los que viven ahí está activo.
const advancedActive =
  exclude.length > 0 || !!olang || minRating != null || minVotes != null || runtimeGte != null || runtimeLte != null;

// Construye una URL conservando TODOS los filtros y cambiando la página.
const pageUrl = (p: number) => {
  const q = new URLSearchParams();
  for (const g of genres) q.append('genre', String(g));
  for (const g of exclude) q.append('exclude', String(g));
  if (genreMode === 'or') q.set('mode', 'or');
  if (decade) q.set('decade', String(decade));
  if (country) q.set('country', country);
  if (olang) q.set('olang', olang);
  if (minRating != null) q.set('rating', String(minRating));
  if (minVotes != null) q.set('votes', String(minVotes));
  if (runtimeGte != null) q.set('rtmin', String(runtimeGte));
  if (runtimeLte != null) q.set('rtmax', String(runtimeLte));
  if (sort && sort !== 'popularity.desc') q.set('sort', sort);
  if (p > 1) q.set('page', String(p));
  const qs = q.toString();
  return localizePath(lang, 'discover') + (qs ? `?${qs}` : '');
};

const selectCls =
  'border border-ink bg-white px-2 py-1 font-mono text-meta-data text-ink focus:bg-film-white focus:outline-none';
// Chip de género: casilla oculta + etiqueta que reacciona con peer-checked (sin JS).
const chipCls =
  'cursor-pointer select-none border border-ink px-3 py-1 font-mono text-meta-data text-ink transition-colors hover:bg-film-white peer-checked:bg-ochre peer-checked:text-on-accent peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-ochre';
---

<BaseLayout title={t('discover.title')} description={t('discover.intro')}>
  <section class="frame py-12">
    <header class="border-b border-ink pb-6">
      <span class="label">{t('discover.title')}</span>
      <h1 class="mt-3 text-display-mobile md:text-display-lg">{t('discover.title')}</h1>
      <p class="mt-4 max-w-2xl text-body-lg text-charcoal">{t('discover.intro')}</p>

      <form method="get" class="mt-6 flex flex-col gap-5">
        {/* Géneros (varios a la vez) + combinar TODOS/CUALQUIERA */}
        <div>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="label">{t('discover.genre')}</span>
            <fieldset class="flex items-center gap-3">
              <legend class="sr-only">{t('discover.combine')}</legend>
              <span class="label text-muted">{t('discover.combine')}:</span>
              <label class="flex cursor-pointer items-center gap-1 font-mono text-meta-data text-ink">
                <input type="radio" name="mode" value="and" checked={genreMode === 'and'} class="accent-ochre" />
                {t('discover.combineAll')}
              </label>
              <label class="flex cursor-pointer items-center gap-1 font-mono text-meta-data text-ink">
                <input type="radio" name="mode" value="or" checked={genreMode === 'or'} class="accent-ochre" />
                {t('discover.combineAny')}
              </label>
            </fieldset>
          </div>
          <div class="mt-2 flex flex-wrap gap-2">
            {GENRES.map((g) => (
              <label>
                <input type="checkbox" name="genre" value={g.id} checked={genres.includes(g.id)} class="peer sr-only" />
                <span class={chipCls}>{genreName(g.id, cl)}</span>
              </label>
            ))}
          </div>
        </div>

        {/* Década · País · Orden */}
        <div class="flex flex-wrap items-end gap-3">
          <label class="flex flex-col gap-1">
            <span class="label">{t('discover.decade')}</span>
            <select name="decade" class={selectCls}>
              <option value="">{t('discover.all')}</option>
              {decades.map((d) => <option value={d} selected={decade === d}>{d}s</option>)}
            </select>
          </label>
          <label class="flex flex-col gap-1">
            <span class="label">{t('discover.country')}</span>
            <select name="country" class={selectCls}>
              <option value="">{t('discover.all')}</option>
              {COUNTRIES.map((c) => <option value={c.code} selected={country === c.code}>{c[cl]}</option>)}
            </select>
          </label>
          <label class="flex flex-col gap-1">
            <span class="label">{t('discover.sort')}</span>
            <select name="sort" class={selectCls}>
              <option value="popularity.desc" selected={sort === 'popularity.desc'}>{t('discover.sortPopular')}</option>
              <option value="vote_average.desc" selected={sort === 'vote_average.desc'}>{t('discover.sortRated')}</option>
              <option value="primary_release_date.desc" selected={sort === 'primary_release_date.desc'}>{t('discover.sortRecent')}</option>
            </select>
          </label>
        </div>

        {/* Filtros avanzados (plegable, nativo, sin JS) */}
        <details open={advancedActive} class="border border-ink bg-surface">
          <summary class="cursor-pointer select-none px-4 py-2 font-mono text-meta-data uppercase tracking-widest text-ink">
            {t('discover.advanced')}
          </summary>
          <div class="border-t border-ink p-4">
            <span class="label">{t('discover.exclude')}</span>
            <div class="mt-2 flex flex-wrap gap-2">
              {GENRES.map((g) => (
                <label>
                  <input type="checkbox" name="exclude" value={g.id} checked={exclude.includes(g.id)} class="peer sr-only" />
                  <span class={chipCls}>{genreName(g.id, cl)}</span>
                </label>
              ))}
            </div>
            <div class="mt-4 flex flex-wrap items-end gap-3">
              <label class="flex flex-col gap-1">
                <span class="label">{t('discover.origLang')}</span>
                <select name="olang" class={selectCls}>
                  <option value="">{t('discover.any')}</option>
                  {LANGUAGES.map((l) => <option value={l.code} selected={olang === l.code}>{l[cl]}</option>)}
                </select>
              </label>
              <label class="flex flex-col gap-1">
                <span class="label">{t('discover.minRating')}</span>
                <select name="rating" class={selectCls}>
                  <option value="">{t('discover.any')}</option>
                  {ratingOptions.map((r) => <option value={r} selected={minRating === r}>{r}+</option>)}
                </select>
              </label>
              <label class="flex flex-col gap-1">
                <span class="label">{t('discover.minVotes')}</span>
                <select name="votes" class={selectCls}>
                  <option value="">{t('discover.any')}</option>
                  {votesOptions.map((v) => <option value={v} selected={minVotes === v}>{v}+</option>)}
                </select>
              </label>
              <label class="flex flex-col gap-1">
                <span class="label">{t('discover.runtime')}</span>
                <div class="flex items-center gap-2">
                  <input type="number" name="rtmin" min="0" max="1000" step="5" value={runtimeGte ?? ''} placeholder={t('discover.runtimeMin')} class={`${selectCls} w-20`} />
                  <span class="font-mono text-meta-data text-muted">–</span>
                  <input type="number" name="rtmax" min="0" max="1000" step="5" value={runtimeLte ?? ''} placeholder={t('discover.runtimeMax')} class={`${selectCls} w-20`} />
                </div>
              </label>
            </div>
          </div>
        </details>

        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" class="btn btn-primary">{t('discover.apply')}</button>
          {activeFilters > 0 && (
            <a href={localizePath(lang, 'discover')} class="label no-underline hover:text-ink">{t('discover.clear')} ({activeFilters})</a>
          )}
        </div>
      </form>
    </header>

    {results.results.length === 0 ? (
      <p class="mt-10 font-mono text-body-md text-muted">{t('discover.empty')}</p>
    ) : (
      <div class="mt-8 grid grid-cols-2 gap-px border border-ink bg-ink sm:grid-cols-3 lg:grid-cols-6">
        {results.results.map((r) => (
          <a href={localizePath(lang, `film/${filmSlug(r.id, r.title)}`)} class="group flex flex-col bg-surface no-underline hover:bg-film-white">
            <div class="aspect-[2/3] w-full border-b border-ink bg-charcoal">
              {r.poster_path ? (
                <img
                  src={posterUrl(r.poster_path, 'w342')}
                  srcset={posterSrcset(r.poster_path, 'w342', 'w500') ?? undefined}
                  sizes="(min-width:1024px) 16vw, (min-width:640px) 33vw, 50vw"
                  alt={r.title}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              ) : (
                <div class="film-grain h-full w-full"></div>
              )}
            </div>
            <div class="flex flex-1 flex-col p-2">
              <p class="font-display text-body-lg leading-tight text-ink">{r.title}</p>
              <p class="font-mono text-meta-data text-muted">
                {[r.release_date ? r.release_date.slice(0, 4) : null, r.vote_average ? `★ ${r.vote_average.toFixed(1)}` : null].filter(Boolean).join(' · ')}
              </p>
            </div>
          </a>
        ))}
      </div>
    )}

    {/* Paginación */}
    <nav class="mt-10 flex items-center justify-between border-t border-ink pt-4" aria-label="Paginación">
      {page > 1 ? (
        <a href={pageUrl(page - 1)} class="label no-underline hover:text-ink">{t('discover.prev')}</a>
      ) : (
        <span class="label text-muted">{t('discover.prev')}</span>
      )}
      <span class="font-mono text-meta-data text-muted">{page} / {results.totalPages}</span>
      {page < results.totalPages ? (
        <a href={pageUrl(page + 1)} class="label no-underline hover:text-ink">{t('discover.next')}</a>
      ) : (
        <span class="label text-muted">{t('discover.next')}</span>
      )}
    </nav>
  </section>
</BaseLayout>
