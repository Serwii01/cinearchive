---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const t = useTranslations(getLangFromUrl(Astro.url));
---

<button
  type="button"
  data-theme-toggle
  aria-label={t('theme.toggle')}
  title={t('theme.toggle')}
  class="flex items-center border-l border-ink px-4 font-mono text-meta-data transition-colors hover:bg-ink hover:text-white"
>
  {/* Luna y sol dibujados: ☾ y ☀ salían como emoji de color en algunos móviles. */}
  <svg data-icon="moon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path></svg>
  <svg data-icon="sun" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="hidden"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
</button>

<script>
  // Apto para varias instancias (una en la barra de escritorio, otra en el menú móvil).
  const root = document.documentElement;
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]'));

  const sync = () => {
    const oscuro = root.getAttribute('data-theme') === 'dark';
    for (const b of buttons) {
      b.querySelector('[data-icon="moon"]')?.classList.toggle('hidden', oscuro);
      b.querySelector('[data-icon="sun"]')?.classList.toggle('hidden', !oscuro);
    }
  };
  sync();
  document.addEventListener('themechange', sync);

  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const dark = root.getAttribute('data-theme') !== 'dark';
      if (dark) root.setAttribute('data-theme', 'dark');
      else root.removeAttribute('data-theme');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch (e) {}
      sync();
      // Persiste la preferencia si hay sesión (silencioso si no la hay → 401).
      fetch('/api/me/preferences', {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ theme: dark ? 'dark' : 'light' }),
      }).catch(() => {});
    });
  }
</script>
