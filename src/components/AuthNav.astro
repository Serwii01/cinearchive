---
/**
 * Enlaces de la cuenta en la cabecera: «Entrar / Crear cuenta» o «Para ti /
 * Mi cuenta / Salir».
 *
 * Vienen YA PINTADOS en la página, las dos variantes, y el CSS enseña la buena
 * (global.css, «auth-nav»). Antes los añadía JavaScript cuando la página ya se
 * veía: la cabecera crecía unos 220 px de golpe y todo el menú se corría. Y con
 * sesión era peor: en las páginas generadas de antemano salía primero «Entrar»
 * y luego se cambiaba.
 *
 * Quién decide la variante:
 *   - En las páginas que se generan en cada visita, el servidor, que sabe si
 *     hay sesión (data-state="user" o "guest").
 *   - En las generadas de antemano no lo sabe (data-state="auto"): decide
 *     theme-init.js antes de pintar, con lo que se recordó la última vez
 *     (localStorage «cine:auth», solo un «sí»; ningún dato de la cuenta).
 * Después se comprueba con el servidor, por si la sesión se cerró en otro sitio,
 * y se corrige el recuerdo.
 */
import { getLangFromUrl, useTranslations, localizePath, type Lang } from '../i18n/ui';

interface Props {
  /** Variante vertical para el menú móvil. */
  mobile?: boolean;
}

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { mobile = false } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '');
const state = Astro.isPrerendered ? 'auto' : Astro.locals.user ? 'user' : 'guest';

const base = mobile
  ? 'label block border-b border-ink px-4 py-4 no-underline transition-colors'
  : 'label flex items-center border-l border-ink px-4 no-underline transition-colors';
const clase = (href: string, accent = false) => {
  const active = !accent && href.replace(/\/$/, '') === current;
  const estado = accent
    ? 'bg-ochre text-on-accent hover:bg-ink hover:text-white'
    : active
      ? 'bg-ink text-white'
      : 'hover:bg-ink hover:text-white';
  return `${base} ${estado}`;
};
const btnClass = mobile
  ? 'label block w-full border-b border-ink px-4 py-4 text-left transition-colors hover:bg-ink hover:text-white'
  : 'label flex items-center border-l border-ink px-4 transition-colors hover:bg-ink hover:text-white';

const l = {
  login: localizePath(lang, 'login'),
  register: localizePath(lang, 'register'),
  account: localizePath(lang, 'account'),
  recs: localizePath(lang, 'recommendations'),
  notifications: localizePath(lang, 'notifications'),
  home: localizePath(lang),
};
---

<auth-nav data-state={state} data-home={l.home} class:list={[mobile ? 'block' : 'flex items-stretch']}>
  <span data-variant="guest" class="contents">
    <a href={l.login} class={clase(l.login)}>{t('nav.login')}</a>
    <a href={l.register} class={clase(l.register, true)}>{t('nav.register')}</a>
  </span>
  <span data-variant="user" class="contents">
    {/* La campana vive en la barra en escritorio; en el menú móvil, como enlace. */}
    {mobile && <a href={l.notifications} class={clase(l.notifications)}>{t('nav.notifications')}</a>}
    <a href={l.recs} class={clase(l.recs)}>{t('nav.recommendations')}</a>
    <a href={l.account} class={clase(l.account, true)}>{t('nav.account')}</a>
    <button type="button" data-logout aria-label={t('nav.logout')} title={t('nav.logout')} class={btnClass}>
      {
        mobile ? (
          t('nav.logout')
        ) : (
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
        )
      }
    </button>
  </span>
</auth-nav>

<script>
  import { signOut } from '../lib/auth-client';

  const RECUERDO = 'cine:auth';

  /** Fija la variante en todas las cabeceras de la página y recuerda el resultado. */
  function fijar(conSesion: boolean) {
    document.querySelectorAll<HTMLElement>('auth-nav').forEach((n) => (n.dataset.state = conSesion ? 'user' : 'guest'));
    try {
      if (conSesion) localStorage.setItem(RECUERDO, '1');
      else localStorage.removeItem(RECUERDO);
    } catch {
      /* sin almacenamiento: se queda la variante del servidor */
    }
    if (conSesion) document.documentElement.dataset.auth = 'user';
    else delete document.documentElement.dataset.auth;
  }

  // Una sola comprobación por página, aunque haya dos cabeceras (escritorio y móvil).
  let comprobado = false;

  class AuthNav extends HTMLElement {
    connectedCallback() {
      this.querySelector('[data-logout]')?.addEventListener('click', async () => {
        await signOut();
        fijar(false);
        try {
          sessionStorage.removeItem('cine:social-summary');
          localStorage.removeItem('cine:perfil');
        } catch {
          /* nada que limpiar */
        }
        window.location.href = this.dataset.home || '/';
      });

      if (comprobado) return;
      comprobado = true;
      fetch('/api/auth/get-session', { headers: { accept: 'application/json' } })
        // Sin sesión, la respuesta es «null»; un error del servidor no dice nada
        // y no debe borrar la variante buena.
        .then((r) => (r.ok ? r.json() : undefined))
        .then((data) => {
          if (data !== undefined) fijar(!!data?.user);
        })
        .catch(() => {
          /* sin red: se queda lo que se pintó */
        });
    }
  }
  if (!customElements.get('auth-nav')) customElements.define('auth-nav', AuthNav);
</script>
