---
/**
 * «Tus visionados» en la ficha de una película: cuántas veces la has visto y
 * cuándo, con la opción de borrar uno. Debajo de los controles de siempre.
 *
 * El primer visionado sale de puntuar la película (con la fecha de «Cuándo la
 * vi», o la de hoy) o de importar el historial. Lo que sí se apunta aquí es
 * volver a verla: «Vista otra vez» añade un revisionado (hoy o el día que se
 * elija) y la siguiente nota que se dé va a ese revisionado. Sin esto, una
 * película ya vista no podía volver al diario.
 */
import { useTranslations, localizePath, formatDate, type Lang } from '../i18n/ui';
import type { Viewing } from '../lib/viewings';

interface Props {
  tmdbId: number;
  lang: Lang;
  viewings: Viewing[];
}

const { tmdbId, lang, viewings } = Astro.props;
const t = useTranslations(lang);
const fecha = (iso: string) => formatDate(new Date(`${iso}T12:00:00Z`), lang);
---

<viewings-panel
  class="block border border-ink bg-film-white"
  data-tmdb-id={tmdbId}
  data-l-rewatch={t('diary.rewatch')}
  data-l-delete={t('diary.delete')}
  data-l-error={t('diary.error')}
  data-l-duplicate={t('diary.duplicate')}
  data-l-logged={t('diary.rewatchLogged')}
>
  <div class="flex items-center justify-between border-b border-ink px-3 py-2">
    <span class="label">{t('diary.yourViewings')} · <span data-count>{viewings.length}</span></span>
    <a href={localizePath(lang, 'diary')} class="tap label hover:text-ink">{t('diary.title')} →</a>
  </div>
  <ul data-list class="divide-y divide-outline-variant">
    {viewings.map((v) => (
      <li class="flex items-center justify-between gap-2 px-3" data-id={v.id} data-day={v.watchedOn}>
        <span class="font-mono text-meta-data text-ink">
          {fecha(v.watchedOn)}
          {v.rewatch && <span class="ml-2 text-muted">↻ {t('diary.rewatch')}</span>}
        </span>
        <button type="button" data-del class="tap px-2 font-mono text-meta-data text-muted hover:text-error" aria-label={t('diary.delete')}>×</button>
      </li>
    ))}
  </ul>
  {/* Sin visionados, en vez de un formulario: cómo se apunta. */}
  <p data-empty class="px-3 py-2 font-mono text-meta-data text-muted" hidden={viewings.length > 0}>{t('diary.rateToLog')}</p>
  {/* Volver a verla: solo si ya hay un visionado (el primero sale de puntuar). */}
  <form data-again class="flex flex-wrap items-center gap-2 border-t border-ink px-3 py-2" hidden={viewings.length === 0}>
    <label class="sr-only" for={`vp-dia-${tmdbId}`}>{t('diary.rewatchDay')}</label>
    <input id={`vp-dia-${tmdbId}`} type="date" data-day-input class="border border-ink bg-white px-2 py-1 font-mono text-meta-data text-ink" />
    <button type="submit" class="tap label ml-auto hover:text-ink">↻&#xFE0E; {t('diary.watchedAgain')}</button>
  </form>
  <p data-msg role="status" class="px-3 pb-2 font-mono text-meta-data text-error empty:hidden"></p>
</viewings-panel>

<script>
  class ViewingsPanel extends HTMLElement {
    connectedCallback() {
      const d = this.dataset;
      const tmdbId = Number(d.tmdbId);
      const list = this.querySelector<HTMLUListElement>('[data-list]')!;
      const count = this.querySelector('[data-count]')!;
      const empty = this.querySelector<HTMLElement>('[data-empty]')!;
      const msg = this.querySelector('[data-msg]')!;
      const lang = document.documentElement.lang || 'es';

      const fmt = (iso: string) =>
        new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(
          new Date(`${iso}T12:00:00Z`),
        );
      const again = this.querySelector<HTMLFormElement>('[data-again]')!;
      const dayInput = this.querySelector<HTMLInputElement>('[data-day-input]')!;
      // Hoy en la hora LOCAL (con toISOString de madrugada saldría el día anterior en UTC).
      const hoyLocal = () => {
        const n = new Date();
        return new Date(n.getTime() - n.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
      };
      dayInput.value = hoyLocal();
      dayInput.max = hoyLocal();
      const recount = () => {
        count.textContent = String(list.children.length);
        empty.hidden = list.children.length > 0;
        again.hidden = list.children.length === 0;
      };
      const say = (s: string, ok = false) => {
        msg.textContent = s;
        msg.classList.toggle('text-error', !ok);
        msg.classList.toggle('text-ink', ok);
        setTimeout(() => (msg.textContent = ''), ok ? 4000 : 2500);
      };

      again.addEventListener('submit', async (e) => {
        e.preventDefault();
        const res = await fetch('/api/me/viewings', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ tmdbId, watchedOn: dayInput.value || hoyLocal() }),
        });
        if (res.status === 409) return say(d.lDuplicate!);
        if (!res.ok) return say(d.lError!);
        say(d.lLogged!, true);
        // El mismo aviso que al puntuar: la lista se vuelve a pedir y se repinta.
        document.dispatchEvent(new CustomEvent('film:saved', { detail: { tmdbId } }));
      });

      const wireDelete = (li: HTMLElement) =>
        li.querySelector('[data-del]')?.addEventListener('click', async () => {
          const res = await fetch('/api/me/viewings', {
            method: 'DELETE',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id: Number(li.dataset.id) }),
          });
          if (res.ok) { li.remove(); recount(); } else say(d.lError!);
        });
      list.querySelectorAll<HTMLElement>('li').forEach(wireDelete);

      // Al puntuar en FilmControls el servidor apunta el primer visionado: se
      // vuelve a pedir la lista (es corta) y se repinta con lo que diga él.
      document.addEventListener('film:saved', async (e) => {
        if ((e as CustomEvent<{ tmdbId: number }>).detail?.tmdbId !== tmdbId) return;
        const all = await fetch(`/api/me/viewings?tmdbId=${tmdbId}`).then((r) => r.json()).catch(() => null);
        if (!all) return;
        const mine: { id: number; watchedOn: string; rewatch: boolean }[] = all.viewings ?? [];
        list.replaceChildren(
          ...mine.map((v) => {
            const li = document.createElement('li');
            li.className = 'flex items-center justify-between gap-2 px-3';
            li.dataset.id = String(v.id);
            li.dataset.day = v.watchedOn;
            const span = document.createElement('span');
            span.className = 'font-mono text-meta-data text-ink';
            span.textContent = fmt(v.watchedOn);
            if (v.rewatch) {
              const r = document.createElement('span');
              r.className = 'ml-2 text-muted';
              r.textContent = `↻ ${d.lRewatch}`;
              span.append(r);
            }
            const del = document.createElement('button');
            del.type = 'button';
            del.dataset.del = '';
            del.className = 'tap px-2 font-mono text-meta-data text-muted hover:text-error';
            del.setAttribute('aria-label', d.lDelete!);
            del.textContent = '×';
            li.append(span, del);
            wireDelete(li);
            return li;
          }),
        );
        recount();
      });
    }
  }
  if (!customElements.get('viewings-panel')) customElements.define('viewings-panel', ViewingsPanel);
</script>
