---
/**
 * Página de Cine abierto para un tipo o una década (/cinema/tipo/horror,
 * /cinema/decada/1920). Es una página de entrada para buscadores: título y
 * descripción propios, la lista entera de películas y enlaces a las demás
 * páginas del mismo estilo, para que Google las encuentre todas desde cualquiera.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CinemaCard from './CinemaCard.astro';
import CinemaGroupNav from './CinemaGroupNav.astro';
import { pdKindLabelKey, pdThumbUrl, pdTitle, type PdFilm, type PdKind } from '../lib/pdfilms';
import { breadcrumbLd, itemListLd } from '../lib/seo';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Lo que se está viendo: un tipo o una década. */
  actual: { kind: PdKind } | { decade: number };
  films: PdFilm[];
}

const { lang, actual, films } = Astro.props;
const t = useTranslations(lang);

const label =
  'kind' in actual
    ? t(pdKindLabelKey(actual.kind) as Parameters<typeof t>[0])
    : t('cinema.decadeLabel').replace('{d}', String(actual.decade));
const titulo = t('cinema.groupTitle').replace('{label}', label);
const intro = t('cinema.groupIntro').replace('{n}', String(films.length));

// Las más antiguas primero, como el listado general.
const lista = films.slice().sort((a, b) => a.year - b.year || pdTitle(a, lang).localeCompare(pdTitle(b, lang), lang));

// Unos títulos en la descripción: así cada página tiene la suya, y no veinte iguales.
const descripcion = `${intro} ${lista
  .filter((f) => f.essential)
  .concat(lista.filter((f) => !f.essential))
  .slice(0, 4)
  .map((f) => pdTitle(f, lang))
  .join(', ')}…`;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const abs = (p: string) => new URL(localizePath(lang, p), Astro.site).href;
const jsonLd = [
  breadcrumbLd([
    { name: t('cinema.title'), url: abs('cinema') },
    { name: label, url: pageUrl },
  ]),
  itemListLd({ name: titulo, items: lista.map((f) => ({ name: pdTitle(f, lang), url: abs(`cinema/${f.id}`) })) }),
];
---

<BaseLayout title={titulo} description={descripcion} image={lista[0] ? pdThumbUrl(lista[0].id) : undefined} jsonLd={jsonLd}>
  <section class="frame py-12">
    <a href={localizePath(lang, 'cinema')} class="label no-underline hover:text-ink">← {t('cinema.backToCinema')}</a>
    <header class="mt-6 border-b border-ink pb-6">
      <span class="label">{t('cinema.title')} · {films.length} {t('cinema.count')}</span>
      <h1 class="mt-3 text-display-mobile md:text-display-lg">{label}</h1>
      <p class="mt-4 max-w-2xl text-body-lg text-charcoal">{intro}</p>
    </header>

    <div class="mt-8 grid ruled grid-cols-1 border border-ink sm:grid-cols-2 lg:grid-cols-3">
      {lista.map((f) => <CinemaCard film={f} lang={lang} />)}
    </div>

    <CinemaGroupNav lang={lang} actual={actual} clase="mt-14" />
  </section>
</BaseLayout>
