---
/**
 * Reparto: adivinar la película por sus actores. Se empieza con el sexto del
 * reparto y cada fallo descubre uno más, hasta el protagonista. La página es
 * estática; el reto llega de /api/games/reparto y la solución solo al acertar
 * o al gastar los seis intentos.
 *
 * Mismos ritmos que Fotograma: reto del día (se recuerda hasta mañana) e
 * ilimitado (uno tras otro, sin repetir película). Estadísticas, solo en el navegador.
 */
import { useTranslations, localizePath, type Lang } from '../../i18n/ui';
import { MAX_ATTEMPTS } from '../../lib/games';

interface Props {
  lang: Lang;
  endless?: boolean;
}

const { lang, endless = false } = Astro.props;
const t = useTranslations(lang);
const keys = [
  'games.attempt', 'games.locked', 'games.won', 'games.lost', 'games.viewFilm', 'games.share', 'games.copied', 'games.noMatches',
  'games.error', 'games.wrongGuess', 'games.sameSaga', 'games.sagaMark', 'games.skipped', 'games.alreadyTried',
  'games.shareReparto', 'games.shareRepartoEndless', 'games.number', 'games.loading',
] as const;
const i18n = Object.fromEntries(keys.map((k) => [k, t(k)]));
const ritmos = [
  { id: false, label: t('games.dailyTab'), href: localizePath(lang, 'games/reparto') },
  { id: true, label: t('games.endlessTab'), href: localizePath(lang, 'games/reparto/ilimitado') },
];
// Del sexto del reparto al protagonista, que es el último en salir.
const puestos = Array.from({ length: MAX_ATTEMPTS }, (_, i) => MAX_ATTEMPTS - i);
---

<section class="frame py-10" data-reparto data-endless={endless ? '1' : undefined} data-lang={lang} data-i18n={JSON.stringify(i18n)}>
  <a href={localizePath(lang, 'games')} class="label no-underline hover:text-ink">← {t('games.allGames')}</a>

  <header class="mt-6 flex flex-wrap items-end justify-between gap-4 border-b border-ink pb-5">
    <div>
      <span class="label">{endless ? t('games.endlessTab') : t('games.daily')}{!endless && <> · <span data-num>—</span></>}</span>
      <h1 class="mt-2 text-display-mobile md:text-display-lg">{t('games.reparto')}</h1>
    </div>
    <nav class="flex border border-ink" aria-label={t('games.paceLabel')}>
      {ritmos.map((r, i) => (
        <a
          href={r.href}
          aria-current={r.id === endless ? 'page' : undefined}
          class:list={['label px-4 py-2 no-underline', i > 0 && 'border-l border-ink', r.id === endless ? 'bg-ink text-white' : 'hover:bg-film-white hover:text-ink']}
        >
          {r.label}
        </a>
      ))}
    </nav>
  </header>
  <p class="mt-4 max-w-2xl text-body-md text-charcoal">{t('games.repartoDesc')}{endless && ` ${t('games.endlessDesc')}`}</p>

  <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-12">
    <div class="lg:col-span-8">
      <figure class="border border-ink bg-surface">
        <ol data-cast class="flex flex-col" aria-label={t('games.hint.cast')}>
          {puestos.map((n, i) => (
            <li class:list={['flex items-baseline justify-between gap-4 px-4 py-3', i > 0 && 'border-t border-ink/30']}>
              <span class="shrink-0 font-mono text-meta-data text-muted">{t('games.castPos').replace('{n}', String(n))}</span>
              <span data-name class="text-right font-mono text-meta-data text-muted">{i === 0 ? t('games.loading') : t('games.locked')}</span>
            </li>
          ))}
        </ol>
        <figcaption class="flex items-center justify-between gap-3 border-t border-ink px-3 py-2">
          <span data-boxes class="font-mono text-body-lg tracking-[0.3em] text-ink" aria-hidden="true"></span>
          <span data-attempt class="font-mono text-meta-data text-muted"></span>
        </figcaption>
      </figure>

      <form data-form class="mt-4 flex flex-wrap items-start gap-2" autocomplete="off" hidden>
        <div class="relative min-w-0 flex-1 basis-64">
          <label for="reparto-q" class="sr-only">{t('games.guessLabel')}</label>
          <input
            id="reparto-q"
            data-q
            type="text"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="reparto-list"
            placeholder={t('games.guessPlaceholder')}
            enterkeyhint="go"
            class="w-full border border-ink bg-white px-3 py-3 font-body text-body-md text-ink placeholder:text-muted focus:bg-film-white"
          />
          <ul id="reparto-list" data-list role="listbox" aria-label={t('games.guessLabel')} class="absolute left-0 right-0 top-full z-20 max-h-72 overflow-y-auto border border-t-0 border-ink bg-surface" hidden></ul>
        </div>
        <button type="submit" class="btn btn-primary">{t('games.guess')}</button>
        <button type="button" data-skip class="btn btn-secondary">{t('games.skip')}</button>
      </form>
      <p data-msg class="mt-2 min-h-[1.5rem] font-mono text-meta-data text-muted" role="status" aria-live="polite"></p>
      <ol data-guesses class="mt-2 flex flex-col gap-1"></ol>
    </div>

    <aside class="lg:col-span-4">
      <section data-result class="border border-ink bg-surface" hidden aria-live="polite">
        <div class="flex gap-4 p-5">
          <img data-r-poster alt="" width="120" height="180" class="w-24 shrink-0 self-start border border-ink bg-charcoal object-cover" />
          <div class="min-w-0">
            <p data-r-head class="label"></p>
            <p class="mt-1 font-mono text-meta-data text-muted">{t('games.answerIs')}</p>
            <p class="font-display text-headline-md leading-tight text-ink"><span data-r-title></span> <span data-r-year class="text-muted"></span></p>
          </div>
        </div>
        <div class="flex flex-wrap gap-2 border-t border-ink p-5">
          {endless && <button type="button" data-next class="btn btn-primary">{t('games.nextFilm')} →</button>}
          <a data-r-link class="btn btn-secondary no-underline"></a>
          <button type="button" data-share class:list={['btn', endless ? 'btn-secondary' : 'btn-primary']}>{t('games.share')}</button>
          {!endless && (
            <p class="w-full font-mono text-meta-data text-muted">
              {t('games.tomorrow')} <a href={localizePath(lang, 'games/reparto/ilimitado')} class="text-ink">{t('games.tryEndless')} →</a>
            </p>
          )}
        </div>
        <div class="border-t border-ink p-5">
          <h2 class="label">{t('games.stats')}{endless && ` · ${t('games.endlessTab')}`}</h2>
          <dl class="mt-3 grid grid-cols-2 gap-x-2 gap-y-4 text-center">
            <div><dt class="font-mono text-meta-data text-muted">{t('games.played')}</dt><dd data-s-played class="font-display text-headline-md text-ink">0</dd></div>
            <div><dt class="font-mono text-meta-data text-muted">{t('games.winPct')}</dt><dd data-s-pct class="font-display text-headline-md text-ink">0 %</dd></div>
            <div><dt class="font-mono text-meta-data text-muted">{t('games.streak')}</dt><dd data-s-streak class="font-display text-headline-md text-ink">0</dd></div>
            <div><dt class="font-mono text-meta-data text-muted">{t('games.maxStreak')}</dt><dd data-s-best class="font-display text-headline-md text-ink">0</dd></div>
          </dl>
        </div>
      </section>
      <p class="mt-6 font-mono text-meta-data text-muted">{t('games.creditReparto')}</p>
    </aside>
  </div>
</section>

<script>
  import { attemptsBoxes, MAX_ATTEMPTS, SEEN_MAX, type TitleEntry } from '../../lib/games';
  import { guessBox } from '../../lib/ui/guessbox';

  type Puzzle = { day?: number; seed?: number; cast: string[] };
  type Answer = { title: string; year: number; poster: string | null; href: string };
  type Guess = { id: string | number; title: string; saga?: boolean } | null;
  type State = { guesses: Guess[]; solved: boolean; done: boolean; answer?: Answer };
  type Stats = { played: number; wins: number; streak: number; best: number; last: number };

  const lee = <T,>(k: string, def: T): T => {
    try {
      return (JSON.parse(localStorage.getItem(k) ?? 'null') as T) ?? def;
    } catch {
      return def;
    }
  };
  const guarda = (k: string, v: unknown) => {
    try {
      localStorage.setItem(k, JSON.stringify(v));
    } catch {
      /* modo privado: se juega igual, sin recordar */
    }
  };
  const vacio = (): State => ({ guesses: [], solved: false, done: false });
  const STATS0: Stats = { played: 0, wins: 0, streak: 0, best: 0, last: 0 };

  for (const root of document.querySelectorAll<HTMLElement>('[data-reparto]')) {
    const endless = root.dataset.endless === '1';
    const lang = root.dataset.lang!;
    const T = JSON.parse(root.dataset.i18n!) as Record<string, string>;
    const $ = <E extends Element = HTMLElement>(s: string) => root.querySelector<E>(s)!;
    const form = $<HTMLFormElement>('[data-form]');
    const q = $<HTMLInputElement>('[data-q]');
    const list = $<HTMLUListElement>('[data-list]');
    const msg = $('[data-msg]');
    const statsKey = `cine:games:stats:reparto${endless ? ':ilimitado' : ''}`;
    const vistasKey = 'cine:games:reparto:vistas';
    let puzzle: Puzzle | null = null;
    let state: State = vacio();
    let stateKey = '';
    let ocupado = false;

    const fallos = () => state.guesses.length;
    const ref = () => (puzzle!.seed ? { seed: puzzle!.seed } : { day: puzzle!.day });

    function pinta() {
      if (!puzzle) return;
      $('[data-boxes]').textContent = attemptsBoxes(fallos(), state.solved);
      $('[data-attempt]').textContent = state.done ? '' : T['games.attempt'].replace('{n}', String(fallos() + 1)).replace('{total}', String(MAX_ATTEMPTS));
      // Un nombre a la vista y otro más por cada fallo; todos al terminar.
      const visibles = state.done ? MAX_ATTEMPTS : fallos() + 1;
      root.querySelectorAll<HTMLElement>('[data-cast] [data-name]').forEach((el, i) => {
        const abierto = i < visibles;
        el.textContent = abierto ? puzzle!.cast[i] : T['games.locked'];
        // Los nombres, grandes; lo que falta por salir, en pequeño, como en las pistas de Fotograma.
        el.className = abierto ? 'text-right font-display text-headline-md leading-tight text-ink' : 'text-right font-mono text-meta-data text-muted';
      });
      $('[data-guesses]').replaceChildren(
        ...state.guesses.map((g) => {
          const li = document.createElement('li');
          li.className = 'font-mono text-meta-data text-muted';
          const s = document.createElement('s');
          s.textContent = g ? g.title : T['games.skipped'];
          if (g?.saga) {
            li.className = 'font-mono text-meta-data text-ink';
            li.append('◆︎ ', s, ` · ${T['games.sagaMark']}`);
          } else li.append('■ ', s);
          return li;
        }),
      );
      form.hidden = state.done;
      $('[data-result]').hidden = !(state.done && state.answer);
      if (state.done && state.answer) resultado();
    }

    function resultado() {
      const a = state.answer!;
      $('[data-r-head]').textContent = state.solved ? T['games.won'] : T['games.lost'];
      const p = $<HTMLImageElement>('[data-r-poster]');
      if (a.poster) p.src = a.poster;
      p.hidden = !a.poster;
      $('[data-r-title]').textContent = a.title;
      $('[data-r-year]').textContent = `(${a.year})`;
      const link = $<HTMLAnchorElement>('[data-r-link]');
      link.href = a.href;
      link.textContent = `${T['games.viewFilm']} →`;
      const s = lee<Stats>(statsKey, STATS0);
      $('[data-s-played]').textContent = String(s.played);
      $('[data-s-pct]').textContent = `${s.played ? Math.round((s.wins / s.played) * 100) : 0} %`;
      $('[data-s-streak]').textContent = String(s.streak);
      $('[data-s-best]').textContent = String(s.best);
    }

    function cuentaPartida() {
      const s = { ...STATS0, ...lee<Stats>(statsKey, STATS0) };
      if (!endless && s.last === puzzle!.day) return;
      s.played++;
      if (state.solved) {
        s.wins++;
        s.streak = endless || s.last === (puzzle!.day ?? 0) - 1 ? s.streak + 1 : 1;
        s.best = Math.max(s.best, s.streak);
      } else s.streak = 0;
      if (!endless) s.last = puzzle!.day!;
      guarda(statsKey, s);
    }

    async function post(body: object) {
      const r = await fetch('/api/games/reparto', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ lang, ...ref(), ...body }) });
      if (!r.ok) throw new Error(String(r.status));
      return r.json();
    }

    async function intenta(g: TitleEntry | null) {
      if (ocupado || state.done || !puzzle) return;
      if (g && state.guesses.some((x) => x && x.id === g.id)) {
        msg.textContent = T['games.alreadyTried'];
        return;
      }
      ocupado = true;
      try {
        if (g) {
          const r = await post({ guess: Number(g.id) });
          if (r.correct) state = { ...state, solved: true, done: true, answer: r.answer };
          else {
            state.guesses.push({ id: g.id, title: g.title, ...(r.saga ? { saga: true } : {}) });
            msg.textContent = T[r.saga ? 'games.sameSaga' : 'games.wrongGuess'].replace('{title}', g.title);
          }
        } else {
          state.guesses.push(null);
          msg.textContent = T['games.skipped'];
        }
        if (!state.solved && state.guesses.length >= MAX_ATTEMPTS) {
          const r = await post({ reveal: true });
          state = { ...state, done: true, answer: r.answer };
        }
        if (state.done) {
          msg.textContent = '';
          cuentaPartida();
        }
        if (!endless) guarda(stateKey, state);
        caja.clear();
        pinta();
        if (state.done) {
          $('[data-result]').scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          (root.querySelector<HTMLElement>('[data-next]') ?? $('[data-share]')).focus({ preventScroll: true });
        }
      } catch {
        msg.textContent = T['games.error'];
      } finally {
        ocupado = false;
      }
    }

    const caja = guessBox({ form, q, list, msg, mode: 'actual', lang, T, onPick: (o) => void intenta(o) });
    $('[data-skip]').addEventListener('click', () => void intenta(null));

    $('[data-share]').addEventListener('click', async () => {
      const score = state.solved ? `${fallos() + 1}/${MAX_ATTEMPTS}` : `X/${MAX_ATTEMPTS}`;
      const cab = T[endless ? 'games.shareRepartoEndless' : 'games.shareReparto'].replace('{n}', String(puzzle?.day ?? '')).replace('{score}', score);
      const texto = `${cab}\n${attemptsBoxes(fallos(), state.solved)}\n${location.origin}${location.pathname}`;
      try {
        if (navigator.share) await navigator.share({ text: texto });
        else {
          await navigator.clipboard.writeText(texto);
          msg.textContent = T['games.copied'];
        }
      } catch {
        /* cancelado */
      }
    });

    async function carga() {
      msg.textContent = '';
      $('[data-result]').hidden = true;
      try {
        const vistas = endless ? lee<number[]>(vistasKey, []) : [];
        const extra = endless ? `?endless=1${vistas.length ? `&seen=${vistas.join(',')}` : ''}` : '';
        const r = await fetch(`/api/games/reparto${extra}`, endless ? { cache: 'no-store' } : {});
        if (!r.ok) throw new Error();
        puzzle = (await r.json()) as Puzzle;
        if (endless) {
          state = vacio();
          if (puzzle.seed) guarda(vistasKey, [...vistas, puzzle.seed].slice(-SEEN_MAX));
        } else {
          stateKey = `cine:games:reparto:${puzzle.day}`;
          state = { ...vacio(), ...lee<State>(stateKey, vacio()) };
          root.querySelector('[data-num]')!.textContent = T['games.number'].replace('{n}', String(puzzle.day));
        }
        pinta();
        // Con ratón y teclado, se puede escribir nada más entrar; en el móvil no (abriría el teclado).
        if (!state.done && matchMedia('(pointer: fine)').matches) q.focus({ preventScroll: true });
      } catch {
        msg.textContent = T['games.error'];
      }
    }
    root.querySelector('[data-next]')?.addEventListener('click', async () => {
      await carga();
      q.focus({ preventScroll: true });
    });
    void carga();
  }
</script>
