---
/**
 * Una reseña de la comunidad en la ficha: autor, estrellas, fecha, el principio
 * del texto y el «me gusta». El texto entero está en la página de la reseña.
 */
import Avatar from './Avatar.astro';
import Stars from './Stars.astro';
import LikeButton from './LikeButton.astro';
import type { FilmReview } from '../lib/filmsocial';
import { extracto } from '../lib/reviews';
import { useTranslations, localizePath, formatDate, type Lang } from '../i18n/ui';

interface Props {
  r: FilmReview;
  lang: Lang;
  tmdbId: number;
  viewerId: string | null;
}

const { r, lang, tmdbId, viewerId } = Astro.props;
const t = useTranslations(lang);
const texto = extracto(r.note, 280);
---

<div class="flex items-center gap-3">
  <a href={localizePath(lang, `u/${r.username}`)} class="shrink-0 no-underline">
    <Avatar userId={r.userId} name={r.name} hasAvatar={r.hasAvatar} size={32} />
  </a>
  <div class="min-w-0">
    <a href={localizePath(lang, `u/${r.username}`)} class="block truncate font-display text-body-lg leading-tight text-ink no-underline hover:underline">{r.name}</a>
    <span class="block font-mono text-meta-data text-muted">
      @{r.username}{r.reviewedAt && ` · ${formatDate(r.reviewedAt, lang)}`}
    </span>
  </div>
</div>
{r.rating != null && <Stars rating={r.rating} lang={lang} class="mt-3 block text-ochre" />}
<p class="mt-2 whitespace-pre-line text-body-md text-charcoal">{texto.texto}</p>
<div class="mt-auto flex items-center justify-between gap-3 pt-3">
  <a href={localizePath(lang, `u/${r.username}/review/${tmdbId}`)} class="label no-underline hover:text-ink">
    {t('film.readReview')} →
  </a>
  <LikeButton
    kind="review"
    username={r.username}
    tmdbId={tmdbId}
    likes={r.likes}
    liked={r.likedByMe}
    own={viewerId === r.userId}
    loggedIn={!!viewerId}
    lang={lang}
  />
</div>
