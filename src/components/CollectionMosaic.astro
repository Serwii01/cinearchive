---
/**
 * Mosaico de cuatro carteles para la tarjeta de una colección. Las colecciones
 * eran tarjetas de solo texto: doce ciclos con Ozu, Tarkovski o la Nouvelle
 * Vague sin una sola imagen. Los carteles vienen de collections.json
 * (scripts/fetch-collection-posters.mjs), así que la página sigue siendo
 * estática y no pide nada a TMDB.
 */
import { posterSet } from '../lib/posters';
import { posterUrl } from '../lib/tmdb';

interface Props {
  posters?: string[];
}

const posters = (Astro.props.posters ?? []).slice(0, 4);
---

{
  posters.length > 0 && (
    <div class="grid grid-cols-4 divide-x divide-ink border-b border-ink" aria-hidden="true">
      {posters.map((p) => (
        <img
          src={posterUrl(p, 'w185')}
          srcset={posterSet(posterUrl(p, 'w185'))}
          sizes="(min-width: 1024px) 12vw, (min-width: 640px) 16vw, 25vw"
          alt=""
          width="185"
          height="278"
          loading="lazy"
          decoding="async"
          class="aspect-[2/3] w-full bg-charcoal object-cover"
        />
      ))}
    </div>
  )
}
