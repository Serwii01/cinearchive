---
/**
 * El reto anual: la barra de progreso y, si es el tuyo y el año lo admite,
 * el formulario para ponerlo, cambiarlo o quitarlo. Lo usan el diario (editable),
 * «Tu año en cine» y el perfil público (solo lectura).
 */
import { useTranslations, type Lang } from '../i18n/ui';
import type { GoalProgress } from '../lib/goal';

interface Props {
  goal: GoalProgress | null;
  year: number;
  lang: Lang;
  editable?: boolean;
  class?: string;
}

const { goal, year, lang, editable = false, class: cls } = Astro.props;
const t = useTranslations(lang);
const nf = new Intl.NumberFormat(lang);
const fill = (s: string, v: Record<string, number | string>) =>
  s.replace(/\{(\w+)\}/g, (_, k) => (typeof v[k] === 'number' ? nf.format(v[k] as number) : String(v[k] ?? '')));

const thisYear = new Date().getUTCFullYear();
const past = year < thisYear;
// Solo se edita el año en curso y los vecinos (lo mismo que acepta la API).
const canEdit = editable && Math.abs(year - thisYear) <= 1;

let status = '';
if (goal) {
  if (goal.complete) status = t('goal.done');
  else if (past) status = fill(t('goal.missed'), { done: goal.done, target: goal.target });
  else if (goal.diff > 0) status = fill(t('goal.ahead'), { n: goal.diff });
  else if (goal.diff < 0) status = fill(t('goal.behind'), { n: -goal.diff });
  else status = t('goal.onTrack');
}
---

{(goal || canEdit) && (
  <goal-card class:list={['block border border-ink bg-surface', cls]} data-year={year} data-error={t('goal.error')}>
    {goal ? (
      <div class="p-4">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <span class="label">{fill(t('goal.title'), { year })}</span>
          <span class="font-mono text-meta-data text-ink">{fill(t('goal.progress'), { done: goal.done, target: goal.target })}</span>
        </div>
        <div
          class="mt-2 h-3 w-full border border-ink"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax={goal.target}
          aria-valuenow={Math.min(goal.done, goal.target)}
          aria-label={fill(t('goal.title'), { year })}
        >
          <div class:list={['h-full', goal.complete ? 'bg-ink' : 'bg-ochre']} style={`width:${goal.pct}%`}></div>
        </div>
        <p class="mt-2 font-mono text-meta-data text-charcoal">
          {status}
          {!goal.complete && !past && goal.perWeek > 0 && <span class="text-muted"> · {fill(t('goal.perWeek'), { left: goal.left, n: goal.perWeek })}</span>}
        </p>
        {canEdit && (
          <details class="mt-3">
            <summary class="tap cursor-pointer label hover:text-ink">{t('goal.change')}</summary>
            <form data-goal class="mt-2 flex flex-wrap items-end gap-2">
              <label class="flex flex-col gap-1">
                <span class="label">{t('goal.label')}</span>
                <input type="number" name="target" min="1" max="3650" required value={goal.target} class="w-28 border border-ink bg-white px-3 py-2 font-mono text-body-md text-ink" />
              </label>
              <button type="submit" class="btn btn-primary">{t('goal.save')}</button>
              <button type="button" data-remove class="tap label hover:text-error">{t('goal.remove')}</button>
              <span data-msg role="status" class="font-mono text-meta-data text-error"></span>
            </form>
          </details>
        )}
      </div>
    ) : (
      <form data-goal class="flex flex-wrap items-end gap-3 p-4">
        <div class="min-w-0 flex-1 basis-56">
          <span class="label">{t('goal.set')}</span>
          <p class="mt-1 font-mono text-meta-data text-muted">{fill(t('goal.setHelp'), { year })}</p>
        </div>
        <label class="flex flex-col gap-1">
          <span class="label">{t('goal.label')}</span>
          <input type="number" name="target" min="1" max="3650" required placeholder="52" class="w-28 border border-ink bg-white px-3 py-2 font-mono text-body-md text-ink" />
        </label>
        <button type="submit" class="btn btn-primary">{t('goal.save')}</button>
        <span data-msg role="status" class="w-full font-mono text-meta-data text-error"></span>
      </form>
    )}
  </goal-card>
)}

<script>
  class GoalCard extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector<HTMLFormElement>('[data-goal]');
      if (!form) return;
      const year = Number(this.dataset.year);
      const msg = form.querySelector<HTMLElement>('[data-msg]');
      const save = async (target: number | null) => {
        const res = await fetch('/api/me/goal', {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ year, target }),
        }).catch(() => null);
        // La barra, el ritmo y el «vas por delante» se calculan en el servidor:
        // lo más sencillo y fiable es volver a pintar la página.
        if (res?.ok) location.reload();
        else if (msg) msg.textContent = this.dataset.error || '';
      };
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const n = Number(new FormData(form).get('target'));
        if (Number.isInteger(n) && n >= 1 && n <= 3650) save(n);
      });
      form.querySelector('[data-remove]')?.addEventListener('click', () => save(null));
    }
  }
  if (!customElements.get('goal-card')) customElements.define('goal-card', GoalCard);
</script>
