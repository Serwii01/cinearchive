---
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import { aInputDate } from '../lib/filmstate';

interface Props {
  tmdbId: number;
  lang: Lang;
  status?: 'want' | 'seen' | null;
  favorite?: boolean;
  rating?: number | null;
  note?: string | null;
  /** Cuándo la vio. Se edita aquí mismo, junto a la valoración. */
  reviewedAt?: Date | string | null;
}

const {
  tmdbId, lang, status = null, favorite = false,
  rating = null, note = null, reviewedAt = null,
} = Astro.props;
const t = useTranslations(lang);

// El tope del calendario se calcula en el cliente con la fecha LOCAL: aquí sería
// la del servidor, y en el último tramo del día no coinciden.
---

<film-controls
  data-tmdb-id={tmdbId}
  data-lang={lang}
  data-status={status ?? ''}
  data-favorite={favorite ? '1' : ''}
  data-rating={rating ?? ''}
  data-note={note ?? ''}
  data-reviewed={aInputDate(reviewedAt)}
  data-l-want={t('controls.want')}
  data-l-seen={t('controls.seen')}
  data-l-fav={t('controls.favorite')}
  data-l-rate={t('controls.rating')}
  data-l-note={t('controls.note')}
  data-l-watched={t('controls.watchedOn')}
  data-l-save={t('controls.save')}
  data-l-saved={t('controls.saved')}
  data-l-remove={t('controls.remove')}
  data-login-url={localizePath(lang, 'login')}
  class="block border border-ink bg-film-white"
>
  <noscript><p class="p-3 font-mono text-meta-data text-muted">JS necesario.</p></noscript>
</film-controls>

<script>
  class FilmControls extends HTMLElement {
    connectedCallback() {
      const d = this.dataset;
      const tmdbId = Number(d.tmdbId);
      const lang = d.lang || 'es';
      let status = d.status || '';
      let favorite = d.favorite === '1';
      let rating = d.rating ? Number(d.rating) : 0;
      let note = d.note || '';
      let reviewed = d.reviewed || '';

      const L = {
        want: d.lWant!, seen: d.lSeen!, fav: d.lFav!, rate: d.lRate!,
        note: d.lNote!, watched: d.lWatched!, save: d.lSave!,
        saved: d.lSaved!, remove: d.lRemove!,
      };

      // Tope del calendario: hoy en la hora LOCAL del usuario. Con toISOString
      // se usaría la de UTC, y de madrugada eso deja fuera el día de verdad.
      const hoyLocal = () => {
        const n = new Date();
        return new Date(n.getTime() - n.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
      };

      // Escapa texto del usuario antes de inyectarlo en innerHTML (anti-XSS).
      const esc = (s: string) =>
        s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

      const render = () => {
        const statusBtn = (val: string, label: string) =>
          `<button type="button" data-status="${val}" class="label flex-1 border-r border-ink px-2 py-2 transition-colors ${
            status === val ? 'bg-ink text-white' : 'hover:bg-ink hover:text-white'
          }">${label}</button>`;

        const star = (n: number) =>
          `<button type="button" data-rate="${n}" aria-label="${n}" class="h-7 w-7 border-r border-ink font-mono text-meta-data transition-colors ${
            rating >= n ? 'bg-ochre text-on-accent' : 'hover:bg-ochre hover:text-on-accent'
          }">${n}</button>`;

        this.innerHTML = `
          <div class="flex border-b border-ink">
            ${statusBtn('want', L.want)}${statusBtn('seen', L.seen)}
            <button type="button" data-fav class="label flex-1 px-2 py-2 transition-colors ${
              favorite ? 'bg-ochre text-on-accent' : 'hover:bg-ochre hover:text-on-accent'
            }">${L.fav}</button>
          </div>
          <div class="flex items-center gap-2 border-b border-ink px-3 py-2">
            <span class="label">${L.rate}</span>
            <span class="flex border border-ink">${[1, 2, 3, 4, 5].map(star).join('')}</span>
          </div>
          <div class="flex items-center gap-2 border-b border-ink px-3 py-2">
            <label class="label" for="fc-fecha-${tmdbId}">${L.watched}</label>
            <input id="fc-fecha-${tmdbId}" type="date" data-reviewed value="${reviewed}" max="${hoyLocal()}"
              class="ml-auto border border-ink bg-white px-2 py-1 font-mono text-meta-data text-ink focus:bg-film-white focus:outline-none" />
          </div>
          <div class="p-3">
            <label class="label mb-1 block">${L.note}</label>
            <textarea data-note rows="2" class="w-full border border-ink bg-white px-2 py-1 font-body text-body-md focus:bg-film-white focus:outline-none">${esc(note)}</textarea>
            <div class="mt-2 flex items-center justify-between">
              <button type="button" data-save class="btn btn-primary">${L.save}</button>
              ${status || favorite ? `<button type="button" data-remove class="label text-error hover:underline">${L.remove}</button>` : ''}
              <span data-msg class="font-mono text-meta-data text-muted"></span>
            </div>
          </div>`;
        wire();
      };

      const post = async (body: object) => {
        const res = await fetch('/api/me/films', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ tmdbId, ...body }),
        });
        if (res.status === 401) {
          window.location.href = `${d.loginUrl}?next=${encodeURIComponent(window.location.pathname)}`;
          return false;
        }
        return res.ok;
      };

      const borrar = async () => {
        const res = await fetch('/api/me/films', {
          method: 'DELETE',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ tmdbId }),
        });
        return res.ok;
      };

      /** La fecha del campo, o cadena vacía. El propio input ya impide el futuro. */
      const leerFecha = () =>
        this.querySelector<HTMLInputElement>('[data-reviewed]')?.value || '';

      const flash = () => {
        const msg = this.querySelector('[data-msg]');
        if (msg) {
          msg.textContent = L.saved;
          setTimeout(() => (msg.textContent = ''), 1500);
        }
      };

      const wire = () => {
        // Estado: pendiente y vista son excluyentes, y pulsar el que ya está
        // puesto lo quita. «Pendiente» además deja de ser favorita, porque no
        // se puede tener de favorita algo que no has visto (la regla completa
        // está en src/lib/filmstate.ts y la aplica también el servidor).
        this.querySelectorAll<HTMLButtonElement>('[data-status]').forEach((b) =>
          b.addEventListener('click', async () => {
            const next = b.dataset.status!;
            // Volver a pulsar el que ya está puesto no hace nada. Quitar la
            // película de la colección es cosa de «quitar»: que un segundo clic
            // se llevara por delante la nota y la puntuación sería una trampa.
            if (status === next) return;
            if (await post({ status: next })) {
              status = next;
              if (next === 'want') favorite = false;
              render();
              flash();
            }
          }),
        );
        // Favorita: marcarla implica haberla visto. Desmarcarla NO la devuelve
        // a pendiente: solo deja de ser favorita.
        this.querySelector<HTMLButtonElement>('[data-fav]')?.addEventListener('click', async () => {
          const next = !favorite;
          if (await post({ favorite: next })) {
            favorite = next;
            if (next) status = 'seen';
            render();
            flash();
          }
        });
        // Puntuar es haberla visto. La fecha se manda siempre: si no, el
        // servidor la volvería a sellar con la de hoy y se perdería la que el
        // usuario había puesto.
        this.querySelectorAll<HTMLButtonElement>('[data-rate]').forEach((b) =>
          b.addEventListener('click', async () => {
            const next = Number(b.dataset.rate);
            const fecha = leerFecha();
            if (await post({ rating: next, ...(fecha ? { reviewedAt: fecha } : {}) })) {
              rating = next;
              status = 'seen';
              if (fecha) reviewed = fecha;
              render();
              flash();
            }
          }),
        );
        this.querySelector<HTMLButtonElement>('[data-save]')?.addEventListener('click', async () => {
          note = this.querySelector<HTMLTextAreaElement>('[data-note]')?.value ?? '';
          const fecha = leerFecha();
          if (await post({ note, status: status || 'want', ...(fecha ? { reviewedAt: fecha } : {}) })) {
            status = status || 'want';
            if (fecha) reviewed = fecha;
            render();
            flash();
          }
        });
        // Cambiar la fecha guarda sola: es un dato suelto y pedir «guardar»
        // para un calendario que ya se ha cerrado sobra.
        this.querySelector<HTMLInputElement>('[data-reviewed]')?.addEventListener('change', async () => {
          const fecha = leerFecha();
          if (!fecha) return;
          if (await post({ reviewedAt: fecha })) { reviewed = fecha; flash(); }
        });
        this.querySelector<HTMLButtonElement>('[data-remove]')?.addEventListener('click', async () => {
          if (await borrar()) { status = ''; favorite = false; rating = 0; note = ''; reviewed = ''; render(); }
        });
      };

      render();
    }
  }
  if (!customElements.get('film-controls')) customElements.define('film-controls', FilmControls);
</script>
