---
/**
 * Rejilla de carteles del perfil y sus páginas de «ver todo». Siempre de 4, 6
 * o 12 columnas (móvil, tableta, escritorio), y la última fila se completa con
 * casillas vacías en cada pantalla (ver fillers en lib/grid.ts).
 */
import Stars from './Stars.astro';
import { localizePath } from '../i18n/ui';
import { filmSlug } from '../lib/slug';
import { fillers } from '../lib/grid';
import type { FilmBrief } from '../lib/films';

interface Item {
  tmdbId: number;
  rating?: number | null;
  /** Línea pequeña bajo el cartel: la fecha del visionado, por ejemplo. */
  sub?: string;
}

interface Props {
  items: Item[];
  briefs: Map<number, FilmBrief>;
  lang: string;
  /** Pinta la fila de estrellas y la línea `sub` (solo en visionados). */
  details?: boolean;
}

const { items, briefs, lang, details = false } = Astro.props;
const huecos = fillers(items.length, { base: 4, sm: 6, lg: 12 });
---

<ol class="grid ruled grid-cols-4 border border-ink sm:grid-cols-6 lg:grid-cols-12">
  {items.map((it) => {
    const b = briefs.get(it.tmdbId);
    return (
      <li class="bg-surface">
        <a href={localizePath(lang as never, `film/${filmSlug(it.tmdbId, b?.title)}`)} class="block h-full no-underline hover:bg-film-white" title={b?.title}>
          <div class="aspect-[2/3] w-full bg-charcoal">
            {b?.poster ? (
              <img src={b.poster} srcset={b.posterSrcset ?? undefined} sizes="(min-width: 1024px) 8vw, (min-width: 640px) 16vw, 25vw" alt={b.title} loading="lazy" decoding="async" class="h-full w-full object-cover" />
            ) : (
              <div class="film-grain h-full w-full"></div>
            )}
          </div>
          {details && (
            <>
              <p class="h-5 px-1 pt-1 font-mono text-meta-data leading-tight text-ink">{it.rating ? <Stars rating={it.rating} lang={lang} /> : '·'}</p>
              <p class="h-5 px-1 font-mono text-meta-data leading-tight text-muted">{it.sub ?? ''}</p>
            </>
          )}
        </a>
      </li>
    );
  })}
  {huecos.map((cls) => <li class={`bg-surface ${cls}`} aria-hidden="true"></li>)}
</ol>
