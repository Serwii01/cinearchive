---
import '../styles/global.css';
// Mismo fichero que importa global.css: Vite lo deduplica y la URL con hash coincide.
import garamondUrl from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';
import geistUrl from '@fontsource/geist-sans/files/geist-sans-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Ticker from '../components/Ticker.astro';
import ProfileNudge from '../components/ProfileNudge.astro';
import TabBar from '../components/TabBar.astro';
import {
  getLangFromUrl,
  languages,
  useTranslations,
  defaultLang,
  localizePath,
  stripLangPrefix,
  type Lang,
} from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** Imagen social (og/twitter). Absoluta o ruta relativa a `site`. Default: /og.png. */
  image?: string;
  /** Si es true, la página no se indexa (páginas privadas/finas). */
  noindex?: boolean;
  /** Tipo Open Graph: 'website' (default) o 'article' para fichas/dosieres. */
  ogType?: 'website' | 'article';
  /** Datos estructurados schema.org; se serializan como JSON-LD (uno o varios). */
  jsonLd?: object | object[];
}

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title, description, image, noindex, ogType = 'website', jsonLd } = Astro.props;
const pageTitle = title ? `${title} — ${t('site.title')}` : `${t('site.title')} — ${t('site.tagline')}`;
const pageDesc = description ?? t('site.description');

// Escapa `<` para que un `</script>` en el contenido no rompa el bloque JSON-LD.
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const serializeLd = (data: object): string => JSON.stringify(data).replace(/</g, '\\u003c');

const canonical = new URL(Astro.url.pathname, Astro.site);
// Toda página existe en los cinco idiomas con la misma ruta: las alternativas
// hreflang salen de quitar el prefijo y volver a ponerlo en cada idioma. Ojo:
// no basta con sustituir el prefijo, porque el castellano no lleva ninguno.
// En las páginas noindex (el 404) no se emiten: no hay nada que alternar.
const langs = Object.keys(languages) as Lang[];
const alternates = noindex
  ? []
  : langs.map((code) => ({
      code,
      href: new URL(localizePath(code, stripLangPrefix(Astro.url.pathname)), Astro.site).href,
    }));
const ogLocales: Record<Lang, string> = { es: 'es_ES', en: 'en_US', gl: 'gl_ES', eu: 'eu_ES', ca: 'ca_ES' };
const ogImage = image
  ? (/^https?:\/\//.test(image) ? image : new URL(image, Astro.site).href)
  : new URL('/og.png', Astro.site).href;

// Analítica propia (Umami, alojada en el VPS). Solo se emite si hay un id de
// sitio configurado: en local y en cualquier despliegue sin la variable, la web
// no carga nada y no mide nada. Las páginas prerenderizadas leen el valor del
// build y las SSR el de process.env; por eso se mira en los dos sitios.
const umamiId = process.env.UMAMI_WEBSITE_ID || import.meta.env.UMAMI_WEBSITE_ID || '';
const umamiHost = process.env.UMAMI_HOST || import.meta.env.UMAMI_HOST || '';
const umamiSrc = umamiId && umamiHost ? `https://${umamiHost}/script.js` : '';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover: la página llega hasta los bordes del iPhone y
        env(safe-area-inset-*) da los márgenes reales (global.css), que es lo
        que necesita la barra inferior para no quedar bajo el indicador. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* Adelanta la conexión a los hosts de imágenes para acelerar la carga */}
    <link rel="preconnect" href="https://image.tmdb.org" />
    <link rel="dns-prefetch" href="https://archive.org" />
    {/* Las dos fuentes que se ven nada más abrir (títulos y texto). Sin esto el
        navegador no las descubre hasta leer el CSS, y el texto salta de la
        fuente del sistema a la buena cuando ya se estaba leyendo. */}
    <link rel="preload" href={garamondUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    {/* Color de la barra del navegador (y de la barra de estado de la app
        instalada). Sigue al tema de la WEB, no al del sistema: el tema se elige
        a mano y por defecto es claro, así que con `media="(prefers-color-scheme)"`
        un móvil en modo claro enseñaba una barra blanca sobre la web en oscuro.
        theme-init.js lo cambia; por eso tiene que ir ANTES del script. */}
    <meta name="theme-color" content="#FAFAFA" />
    {/* Aplica el tema guardado antes de pintar (evita parpadeo). */}
    <script is:inline src="/theme-init.js"></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    {/* Instalable como aplicación en Android e iOS. El service worker
        (public/sw.js) NO guarda HTML: la app es SSR y una página cacheada
        enseñaría la sesión de otro momento. Solo guarda lo inmutable y sirve
        /offline cuando no hay red. */}
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* iOS no lee todo el manifiesto en versiones antiguas: estas tres metas son
        las que hacen que se abra a pantalla completa y con su nombre. */}
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Cine Archive" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical.href} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t('site.title')} — ${t('changelog.title')}`}
      href={new URL(localizePath(lang, 'rss.xml'), Astro.site).href}
    />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.code === defaultLang)!.href} />
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t('site.title')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta property="og:image" content={ogImage} />
    {/* Solo declaramos dimensiones para la imagen por defecto (1200×630 conocido);
        para imágenes por página deja que la plataforma lea el tamaño real. */}
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={t('site.title')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    {/* Medición de visitas: sin cookies, sin huella y sin datos personales. El
        atributo do-not-track hace que respete la señal del navegador, y defer
        la deja fuera del camino crítico de la carga. */}
    {umamiSrc && (
      <script
        is:inline
        defer
        src={umamiSrc}
        data-website-id={umamiId}
        data-do-not-track="true"
      />
    )}
    {jsonLdList.map((data) => (
      <script type="application/ld+json" set:html={serializeLd(data)} />
    ))}
  </head>
  <body class="flex min-h-screen flex-col" data-contar-visita={Astro.isPrerendered ? '' : undefined}>
    <Ticker />
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <TabBar />
    <ProfileNudge />
    <script>
      // Visita en página prerenderizada (ver src/lib/visits.ts): esas no pasan
      // por el middleware, que es donde se cuentan las demás, así que avisan
      // desde aquí. Va en JSON y no con sendBeacon: Astro rechaza con 403 los
      // POST en texto plano (su protección contra formularios de otros sitios).
      if (document.body.hasAttribute('data-contar-visita')) {
        fetch('/api/visits', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ path: location.pathname }),
          keepalive: true,
        }).catch(() => {});
      }
    </script>
    <script>
      // Registro del service worker. Solo en el sitio compilado: en `npm run
      // dev` estorba, porque serviría versiones viejas de los recursos mientras
      // se edita. Así se puede probar de verdad con `npm run preview`.
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        const registrar = () =>
          navigator.serviceWorker.register('/sw.js').catch(() => {
            /* sin service worker la web funciona igual; solo no se instala */
          });
        // Los scripts de Astro son módulos, así que van diferidos y la carga
        // puede haber terminado ya: escuchar 'load' a secas no registraba nada.
        if (document.readyState === 'complete') registrar();
        else addEventListener('load', registrar, { once: true });
      }
    </script>
  </body>
</html>
